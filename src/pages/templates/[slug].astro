---
// One example site per demo in templates.ts, built from the kit. noindex: the businesses are made up, and a made-up
// name could match a real firm's in search. The home's #sites grid is where they are listed.
import '@fontsource/anton'
import '@fontsource-variable/archivo/wdth.css'
import '@fontsource-variable/oswald'
import '@fontsource-variable/big-shoulders-display'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Hero from '@/components/kit/Hero.astro'
import Marquee from '@/components/kit/Marquee.astro'
import Intro from '@/components/kit/Intro.astro'
import Services from '@/components/kit/Services.astro'
import Band from '@/components/kit/Band.astro'
import Gallery from '@/components/kit/Gallery.astro'
import Collage from '@/components/kit/Collage.astro'
import Projects from '@/components/kit/Projects.astro'
import Curtain from '@/components/kit/Curtain.astro'
import Steps from '@/components/kit/Steps.astro'
import Faq from '@/components/kit/Faq.astro'
import Areas from '@/components/kit/Areas.astro'
import Contact from '@/components/kit/Contact.astro'
import Tiles from '@/components/kit/Tiles.astro'
import Pinned from '@/components/kit/Pinned.astro'
import Split from '@/components/kit/Split.astro'
import Rail from '@/components/kit/Rail.astro'
import Venues from '@/components/kit/Venues.astro'
import Live from '@/components/kit/Live.astro'
import Tournaments from '@/components/kit/Tournaments.astro'
import Menu from '@/components/kit/Menu.astro'
import Clubhouse from '@/components/kit/Clubhouse.astro'
import Counter from '@/components/kit/Counter.astro'
import Prices from '@/components/kit/Prices.astro'
import Cookies from '@/components/kit/Cookies.astro'
import DemoPill from '@/components/kit/DemoPill.astro'
import { site } from '@/site'
import { demos, type Demo } from '@/templates'
import Games from '@/components/demos/Games.astro'
import Hotel from '@/components/demos/Hotel.astro'

export const getStaticPaths = () => demos.map((d) => ({ params: { slug: d.slug }, props: { d } }))
const { d } = Astro.props as { d: Demo }
const fonts = { archivo: "'Archivo Variable'", anton: "'Anton'", geist: "'Geist Variable'", oswald: "'Oswald Variable'", shoulders: "'Big Shoulders Display Variable'" }
const c = d.colors
const theme = `--bg:${c.bg};--fg:${c.fg};--muted:${c.muted};--accent:${c.accent};--on-accent:${c.onAccent};--panel:${c.panel};--alt:${c.alt};--display:${fonts[d.font]},system-ui,sans-serif`
const vars = `${theme};background:${c.bg}`
---

<BaseLayout title={`${d.trade} website example | ${site.name}`} description={`A full example website for a ${d.trade.toLowerCase()}, built by ${site.name}. Made-up business, real build.`} noindex>
  <!-- With motion, hold the hero name back until SplitText has cut it (motion.ts unhides it), so it never flashes whole
       first. The style unhides it after 2.5s no matter what, so a failed script can't leave it blank. -->
  <script is:inline>
    if (matchMedia('(prefers-reduced-motion: no-preference)').matches) document.documentElement.setAttribute('data-hold', '')
  </script>
  <style is:inline>
    html[data-hold] [data-letters] { visibility: hidden; animation: unhide 0s 2.5s forwards }
    @keyframes unhide { to { visibility: visible } }
  </style>
  <div id="main" tabindex="-1" class:list={['overflow-x-clip bg-(--bg) outline-none text-(--fg)', d.sentence && '[&_.uppercase]:normal-case']} style={vars}>
    {d.page === 'games' ? <Games d={d} /> : d.page === 'hotel' ? <Hotel d={d} /> : <Hero d={d} />}
    {d.sections.map((s) => (
      s === 'marquee' && d.marquee ? <Marquee items={d.marquee} /> :
      s === 'intro' ? <Intro d={d} /> :
      s === 'services' ? <Services d={d} /> :
      s === 'band' ? <Band d={d} /> :
      s === 'gallery' ? <Gallery d={d} /> :
      s === 'collage' ? <Collage d={d} /> :
      s === 'projects' ? <Projects d={d} /> :
      s === 'faq' ? <Faq d={d} /> :
      s === 'steps' ? <Steps d={d} /> :
      s === 'areas' ? <Areas d={d} /> :
      s === 'contact' ? <Contact d={d} /> :
      s === 'tiles' ? <Tiles d={d} /> :
      s === 'pinned' ? <Pinned d={d} /> :
      s === 'split' ? <Split d={d} /> :
      s === 'rail' ? <Rail d={d} /> :
      s === 'venues' ? <Venues d={d} /> :
      s === 'live' ? <Live d={d} /> :
      s === 'tournaments' ? <Tournaments d={d} /> :
      s === 'menu' ? <Menu d={d} /> :
      s === 'clubhouse' ? <Clubhouse d={d} /> :
      s === 'count' ? <Counter d={d} /> :
      s === 'prices' ? <Prices d={d} /> : null
    ))}
  </div>
  {(d.curtain ?? d.hero.variant === 'poster') && <Curtain />}
  {d.cookies && <Cookies style={theme} title={d.cookies === true ? undefined : d.cookies} />}
  <DemoPill />
  <!-- Overscroll shows the page's own colour, not tebeck's paper. -->
  <style is:inline set:html={`html,body{background:${c.bg}}`}></style>
</BaseLayout>

<script>
  import '@/scripts/motion'
</script>
