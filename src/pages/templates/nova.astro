---
// Example site for a music venue, outside the trade kit: its own layout, built to match a mock Thomas made (navy and
// violet, centred nav, next-event card over the hero). Made-up venue, so noindex like the kit demos; the events,
// times, prices and ticket count are demo data, and the number sits in the drama range.
import { Image } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { site } from '@/site'
import { nextFriday, fmt, tonight, londonNow } from '@/scripts/nova'
import hero from '@/assets/templates/nova/hero.jpg'
import next from '@/assets/templates/nova/next.jpg'
import about from '@/assets/templates/nova/about.jpg'
import e1 from '@/assets/templates/nova/e1.jpg'
import e2 from '@/assets/templates/nova/e2.jpg'
import e3 from '@/assets/templates/nova/e3.jpg'
import g1 from '@/assets/templates/nova/g1.jpg'
import g2 from '@/assets/templates/nova/g2.jpg'
import g3 from '@/assets/templates/nova/g3.jpg'
import g4 from '@/assets/templates/nova/g4.jpg'
import g5 from '@/assets/templates/nova/g5.jpg'

const links = [['#top', 'Home'], ['#events', 'Events'], ['#about', 'About'], ['#gallery', 'Gallery'], ['#contact', 'Contact']]
// Dates are "next Friday" and the two after, rendered at build and refreshed in the browser (scripts/nova.ts).
const now = londonNow()
const fri = nextFriday(now)
const plus = (n: number) => new Date(fri.getFullYear(), fri.getMonth(), fri.getDate() + n)
const events = [
  { img: e1, in: 0, title: 'The Midnight Society', genre: 'Alt rock', time: 'Fri · 9:00 PM', price: '£15' },
  { img: e2, in: 7, title: 'Velvet Static', genre: 'Indie', time: 'Fri · 9:30 PM', price: '£12' },
  { img: e3, in: 14, title: 'Neon Harbour', genre: 'Synth pop', time: 'Fri · 9:00 PM', price: '£14' },
]
const gallery = [
  { img: g1, alt: 'Blue light beams over a packed crowd' },
  { img: g2, alt: 'Stage lights rigged above the crowd' },
  { img: g3, alt: 'Faces in the crowd lit blue' },
  { img: g4, alt: 'Spotlights over a dark audience' },
  { img: g5, alt: 'Hands up under violet stage lights' },
]
const tel = '07700 900418'
const icon = {
  search: 'M21 21l-4.3-4.3M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14z',
  menu: 'M4 7h16M4 12h16M4 17h16',
  pin: 'M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12zM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z',
  ticket: 'M3 8a2 2 0 0 0 2-2h14a2 2 0 0 0 2 2v2a2 2 0 0 0 0 4v2a2 2 0 0 0-2 2H5a2 2 0 0 0-2-2v-2a2 2 0 0 0 0-4zM14 6v12',
  arrow: 'M5 12h14M13 6l6 6-6 6',
  close: 'M6 6l12 12M18 6L6 18',
  phone: 'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2',
}
---

<BaseLayout title={`Live music venue | ${site.name}`} description={`A live music venue website in London, built by ${site.name}.`} noindex>
  <div id="main" class="nova overflow-x-clip bg-[#07081a] text-white">
    <header data-head class="group/head fixed inset-x-0 top-0 z-30 border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-300 data-stuck:border-white/10 data-stuck:bg-[#07081a]/70 data-stuck:backdrop-blur-xl">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-6 transition-[padding] duration-300 group-data-stuck/head:py-3 sm:px-8">
        <a href="#top" class="text-2xl font-bold tracking-[0.12em]">NOVA</a>
        <ul class="hidden items-center gap-10 text-sm text-white/70 md:flex">
          {links.map(([href, label], i) => (
            <li><a href={href} aria-current={i === 0 ? 'location' : undefined} class:list={['relative py-2 transition hover:text-white', i === 0 && 'text-white after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:rounded-full after:bg-[#7c4dff]']}>{label}</a></li>
          ))}
        </ul>
        <div class="flex items-center gap-2">
          <a href="#events" aria-label="Find an event" class="grid size-10 place-items-center rounded-full text-white/80 transition hover:bg-white/10 hover:text-white">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.search} /></svg>
          </a>
          <details class="relative" onclick="event.target.closest('ul a') && this.removeAttribute('open')">
            <summary aria-label="Menu" class="grid size-10 cursor-pointer list-none place-items-center rounded-full text-white/80 transition hover:bg-white/10 hover:text-white [&::-webkit-details-marker]:hidden">
              <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d={icon.menu} /></svg>
            </summary>
            <ul class="absolute right-0 mt-3 w-48 rounded-2xl border border-white/10 bg-[#0e1028]/95 p-2 backdrop-blur-md">
              {links.map(([href, label]) => <li><a href={href} class="block rounded-xl px-4 py-2.5 text-sm text-white/80 hover:bg-white/10 hover:text-white">{label}</a></li>)}
            </ul>
          </details>
        </div>
      </nav>
    </header>

    <!-- Hero: crowd photo on the right, fades to navy on the left under the copy. -->
    <section id="top" class="relative flex min-h-[92dvh] items-center overflow-hidden pt-24 pb-40">
      <Image src={hero} alt="Crowd with hands up under blue stage lights" widths={[800, 1400, 2400]} sizes="100vw" loading="eager" fetchpriority="high" class="nova-kb absolute inset-0 size-full object-cover object-[65%_center]" />
      <div class="absolute top-1/3 right-[12%] size-[32rem] rounded-full bg-[#6d3df5]/25 blur-[120px]"></div>
      <div class="absolute inset-0 bg-[#07081a]/60 sm:bg-transparent sm:bg-gradient-to-r sm:from-[#07081a] sm:via-[#07081a]/80 sm:to-[#07081a]/10"></div>
      <div class="absolute inset-x-0 bottom-0 h-48 bg-gradient-to-t from-[#07081a]"></div>
      <div class="relative mx-auto w-full max-w-7xl px-4 sm:px-8">
        <p class="text-xs font-medium tracking-[0.3em] text-white/60 uppercase">Live music &amp; good vibes</p>
        <h1 data-split class="mt-5 max-w-2xl text-5xl leading-[1.02] font-semibold tracking-tight sm:text-7xl">Next Event <span data-when>{tonight(now, fri) ? 'Tonight' : 'This Friday'}</span></h1>
        <p class="mt-6 max-w-md text-lg text-white/65">Don't miss our upcoming show. Limited tickets available.</p>
        <button type="button" data-trailer class="group mt-10 inline-flex cursor-pointer items-center gap-4 text-sm font-medium">
          <span class="relative grid size-14 place-items-center rounded-full border border-white/25 bg-white/5 backdrop-blur transition group-hover:scale-105 group-hover:border-white/60 group-hover:bg-white/10">
            <span class="absolute inset-0 rounded-full border border-white/30 motion-safe:animate-ping [animation-duration:2.4s]"></span>
            <svg class="ml-0.5 size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
          </span>
          Watch trailer
        </button>
      </div>
    </section>

    <!-- Next event: centred card that overlaps the bottom of the hero. -->
    <div class="relative z-10 mx-auto -mt-28 max-w-5xl px-4 sm:px-8">
      <article data-rise class="grid grid-cols-[auto_1fr] items-center gap-x-5 gap-y-5 rounded-[2rem] border border-white/10 bg-[#0e1028]/90 p-4 shadow-[0_30px_80px_-20px_rgba(10,8,40,0.9)] backdrop-blur-xl sm:grid-cols-[auto_1fr_auto] sm:p-5 sm:pr-8 lg:grid-cols-[auto_1fr_auto_auto]">
        <Image src={next} alt="" widths={[240]} sizes="120px" class="size-20 rounded-2xl object-cover sm:size-28" />
        <div>
          <p class="text-xs font-semibold tracking-[0.2em] text-[#9b7bff] uppercase">Next event</p>
          <h2 class="mt-1.5 text-2xl font-semibold tracking-tight">The Midnight Society</h2>
          <p class="mt-1 text-white/65"><span data-date="0" data-fmt="long">{fmt.long(fri)}</span> · 9:00 PM</p>
          <p class="mt-2 flex items-center gap-1.5 text-sm text-white/55">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d={icon.pin} /></svg>
            Nova Club, London
          </p>
        </div>
        <div data-countdown aria-hidden="true" class="group/cd hidden items-center gap-2 lg:flex">
          {[['d', 'Days'], ['h', 'Hrs'], ['m', 'Mins']].map(([u, l]) => (
            <div class="w-[4.5rem] rounded-2xl border border-white/10 bg-white/[0.04] py-3 text-center group-data-live/cd:hidden">
              <span data-unit={u} class="block text-2xl font-semibold tabular-nums">00</span>
              <span class="text-[0.65rem] tracking-[0.2em] text-white/45 uppercase">{l}</span>
            </div>
          ))}
          <p class="hidden px-4 text-sm font-semibold tracking-[0.2em] text-[#9b7bff] uppercase group-data-live/cd:block">Doors open</p>
        </div>
        <div class="col-span-2 flex flex-wrap items-center gap-x-5 gap-y-3 sm:col-span-1 sm:flex-col sm:flex-nowrap sm:border-l sm:border-white/10 sm:pl-8">
          <a href="#contact" class="inline-flex items-center gap-2.5 rounded-full bg-[#6d3df5] px-6 py-3.5 font-semibold transition hover:-translate-y-0.5 hover:bg-[#7c4dff] active:scale-[0.98]">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d={icon.ticket} /></svg>
            Get Tickets
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.arrow} /></svg>
          </a>
          <p class="flex items-center gap-2 text-sm text-white/60"><span class="size-2 rounded-full bg-emerald-400 shadow-[0_0_10px_#34d399]"></span>24 tickets left</p>
        </div>
      </article>
    </div>

    <section id="events" class="scroll-mt-20 mx-auto max-w-7xl px-4 py-24 sm:px-8 sm:py-32">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="text-xs font-medium tracking-[0.3em] text-white/50 uppercase">Upcoming events</p>
          <h2 data-split class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">What's Next</h2>
        </div>
        <a href="#contact" class="group inline-flex items-center gap-2 text-sm font-medium text-white/75 transition hover:text-white">
          View all events
          <svg class="size-4 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.arrow} /></svg>
        </a>
      </div>
      <ul class="mt-12 grid gap-6 md:grid-cols-3">
        {events.map((e) => (
          <li data-rise class="group">
            <a href="#contact" class="block rounded-[1.75rem] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#9b7bff]">
              <div class="relative aspect-[4/5] overflow-hidden rounded-[1.75rem] border border-white/10">
                <Image src={e.img} alt="" widths={[480, 800]} sizes="(min-width:768px) 33vw, 100vw" class="size-full object-cover transition duration-700 group-hover:scale-105" />
                <div class="absolute inset-0 bg-gradient-to-t from-[#07081a] via-[#07081a]/20 to-transparent"></div>
                <p data-date={e.in} data-fmt="label" class="absolute top-4 left-4 rounded-full border border-white/15 bg-[#07081a]/60 px-3.5 py-1.5 text-xs font-semibold tracking-[0.15em] uppercase backdrop-blur">{fmt.label(plus(e.in))}</p>
                <p class="absolute top-4 right-4 rounded-full bg-[#6d3df5]/80 px-3 py-1.5 text-xs font-medium backdrop-blur">{e.genre}</p>
                <!-- With a mouse the ticket pill opens a row under the text on hover, lifting it; touch screens always show it. -->
                <div class="absolute inset-x-0 bottom-0 p-6">
                  <h3 class="text-2xl font-semibold tracking-tight">{e.title}</h3>
                  <p class="mt-1 text-sm text-white/65">{e.time} · {e.price}</p>
                  <div class="grid transition-[grid-template-rows] duration-500 ease-out md:pointer-fine:grid-rows-[0fr] md:pointer-fine:group-hover:grid-rows-[1fr] md:pointer-fine:group-focus-within:grid-rows-[1fr]">
                    <div class="overflow-hidden">
                      <span class="mt-4 inline-flex items-center gap-2.5 rounded-full bg-[#6d3df5] px-5 py-3 text-sm font-semibold transition group-hover:bg-[#7c4dff]">
                        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d={icon.ticket} /></svg>
                        Get Tickets
                        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.arrow} /></svg>
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section id="about" class="scroll-mt-20 mx-auto grid max-w-7xl items-center gap-12 px-4 pb-24 sm:px-8 sm:pb-32 md:grid-cols-2">
      <div class="relative aspect-[4/5] overflow-hidden rounded-[1.75rem] border border-white/10">
        <Image data-parallax src={about} alt="Crowd facing a smoky, lit stage" widths={[700, 1200]} sizes="(min-width:768px) 50vw, 100vw" class="absolute inset-x-0 top-0 h-[124%] w-full object-cover" />
      </div>
      <div>
        <p class="text-xs font-medium tracking-[0.3em] text-white/50 uppercase">About Nova</p>
        <p data-scrub class="mt-5 text-3xl leading-tight font-semibold tracking-tight sm:text-4xl">One room, one stage, and a sound system built for it. Close enough to see the band's hands, loud enough to feel the kick drum.</p>
        <ul class="mt-10 grid gap-4 border-t border-white/10 pt-8 text-white/65 sm:grid-cols-2">
          <li><span class="block font-semibold text-white">Standing room</span>Space for 300, bar at the back</li>
          <li><span class="block font-semibold text-white">Open late</span>Till 3am Friday and Saturday</li>
          <li><span class="block font-semibold text-white">Step-free</span>Level entry and an accessible toilet</li>
          <li><span class="block font-semibold text-white">Private hire</span>Launches, parties, filming</li>
        </ul>
      </div>
    </section>

    <section id="gallery" class="scroll-mt-20 mx-auto max-w-7xl px-4 pb-24 sm:px-8 sm:pb-32">
      <p class="text-xs font-medium tracking-[0.3em] text-white/50 uppercase">Gallery</p>
      <h2 data-split class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">Inside Nova</h2>
      <div class="mt-12 grid auto-rows-[220px] grid-cols-2 gap-4 md:grid-cols-4">
        {gallery.map((g, i) => (
          <div data-rise class:list={['group overflow-hidden rounded-[1.75rem] border border-white/10', i === 0 && 'col-span-2 row-span-2']}>
            <Image src={g.img} alt={g.alt} widths={[480, 900]} sizes={i === 0 ? '(min-width:768px) 50vw, 100vw' : '(min-width:768px) 25vw, 50vw'} class="size-full object-cover transition duration-700 group-hover:scale-105" />
          </div>
        ))}
      </div>
    </section>

    <footer id="contact" class="relative overflow-hidden border-t border-white/10 bg-[#0a0b22]">
      <div class="pointer-events-none absolute -top-40 left-1/2 size-[36rem] -translate-x-1/2 rounded-full bg-[#6d3df5]/20 blur-3xl"></div>
      <div class="relative mx-auto grid max-w-7xl gap-12 px-4 py-24 sm:px-8 md:grid-cols-3">
        <div class="md:col-span-2">
          <h2 data-split class="text-4xl font-semibold tracking-tight sm:text-5xl">See you at the front.</h2>
          <p class="mt-5 max-w-md text-white/60">Tickets, guest list and private hire. Call or WhatsApp and a real person picks up.</p>
          <a href={`tel:${tel.replaceAll(' ', '')}`} class="group mt-8 inline-flex items-center gap-4 text-3xl font-semibold tracking-tight transition hover:text-[#b9a2ff] sm:text-4xl">
            <span class="grid size-12 place-items-center rounded-full bg-[#6d3df5] transition group-hover:bg-[#7c4dff]"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d={icon.phone} /></svg></span>
            {tel}
          </a>
        </div>
        <dl class="grid gap-6 text-white/65">
          <div><dt class="text-xs font-semibold tracking-[0.2em] text-[#9b7bff] uppercase">Where</dt><dd class="mt-1">Nova Club, Curtain Road<br />Shoreditch, London</dd></div>
          <div><dt class="text-xs font-semibold tracking-[0.2em] text-[#9b7bff] uppercase">Open</dt><dd class="mt-1">Thu 7pm till midnight<br />Fri and Sat 7pm till 3am</dd></div>
          <div><dt class="text-xs font-semibold tracking-[0.2em] text-[#9b7bff] uppercase">Getting here</dt><dd class="mt-1">Five minutes from Shoreditch High Street and Old Street</dd></div>
        </dl>
      </div>
      <p aria-hidden="true" class="relative translate-y-[18%] text-center text-[28vw] leading-[0.8] font-bold tracking-tighter text-white/[0.05]">NOVA</p>
    </footer>
  </div>
  <dialog id="trailer" data-lenis-prevent aria-label="Trailer" class="m-auto w-[min(64rem,calc(100%-2rem),calc((100dvh-6rem)*16/9))] overflow-visible bg-transparent backdrop:bg-[#07081a]/85 backdrop:backdrop-blur-sm">
    <form method="dialog" class="flex justify-end pb-3">
      <button aria-label="Close trailer" class="grid size-10 cursor-pointer place-items-center rounded-full bg-white/10 text-white transition hover:bg-white/20">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d={icon.close} /></svg>
      </button>
    </form>
    <video controls playsinline preload="none" poster="/templates/nova/trailer.jpg" class="aspect-video w-full rounded-[1.75rem] border border-white/10 bg-black">
      <source src="/templates/nova/trailer.webm" type="video/webm" />
      <source src="/templates/nova/trailer.mp4" type="video/mp4" />
    </video>
  </dialog>
  <style is:inline>
    html,body{background:#07081a}
    html:has(dialog[open]){overflow:hidden}
    @media (prefers-reduced-motion:no-preference){.nova-kb{animation:nova-kb 24s ease-out both}}
    @keyframes nova-kb{from{transform:scale(1.12)}to{transform:scale(1)}}
  </style>
</BaseLayout>

<script>
  // Dates first, then motion: the heading split must see the final words.
  import { init } from '@/scripts/nova'
  init()
  import('@/scripts/motion')
</script>
