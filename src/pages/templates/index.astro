---
// The gallery: every example site in templates.ts, lenis.dev style. Giant condensed type, a sideways showcase of
// looping previews (pinned on wide screens, a plain list on phones), then the ask.
import '@fontsource/anton'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Logo from '@/components/Logo.astro'
import Vid from '@/components/kit/Vid.astro'
import { clip } from '@/components/kit/media'
import { site } from '@/site'
import { demos } from '@/templates'
const n = (i: number) => String(i + 1).padStart(2, '0')
---

<BaseLayout title={`Website templates for tradespeople | ${site.name}`} description={`Full example websites for UK tradespeople, each with its own look. Pick the one that feels like you and ${site.name} builds yours around your business, from £${site.priceFrom}.`}>
  <div id="main" class="overflow-x-clip bg-[#08090b] text-[#efefef] [--display:'Anton',system-ui,sans-serif]">
    <header class="fixed inset-x-0 top-0 z-30 flex items-center justify-between px-4 py-4 text-sm font-semibold tracking-wide uppercase mix-blend-difference sm:px-8">
      <a href="/" class="flex items-center gap-2.5 normal-case"><Logo class="size-8" />{site.name}</a>
      <nav aria-label="Templates" class="flex gap-6"><a href="#sites" class="max-sm:hidden">Templates</a><a href="/#contact">Get a quote</a></nav>
    </header>

    <section class="flex min-h-[100dvh] flex-col justify-between px-4 pt-24 pb-10 sm:px-8">
      <h1 data-letters class="font-(family-name:--display) text-[13.5vw] leading-[0.86] uppercase">
        <span class="block">Real sites.</span>{' '}
        <span class="block text-[#4f8bff]">Made-up names.</span>
      </h1>
      <div class="mt-10 grid gap-8 md:grid-cols-2 md:items-end">
        <p class="max-w-md text-lg text-[#a3a6ad]">Full example websites, each with its own look. Scroll through them on your phone, pick the one that feels like you, and I build yours around your business. From £{site.priceFrom}.</p>
        <p class="font-(family-name:--display) text-sm tracking-[0.25em] uppercase md:text-right">Scroll · {demos.length} sites</p>
      </div>
    </section>

    <section id="sites" data-hscroll aria-label="Example sites" class="overflow-x-auto py-10 md:flex md:h-dvh md:items-center md:py-0">
      <ol data-track class="flex flex-col gap-10 px-4 sm:px-8 md:w-max md:flex-row md:gap-8">
        {demos.map((d, i) => (
          <li class="md:w-[min(64vw,980px)]">
            <a href={`/templates/${d.slug}`} class="group block">
              <div class="relative aspect-[16/10] overflow-hidden rounded-2xl" style={`background:${d.colors.bg}`}>
                <Vid {...clip(d.slug, 'card')} class="size-full transition-transform duration-700 group-hover:scale-105" />
                <span class="absolute top-4 left-4 rounded-full px-3 py-1 text-xs font-semibold tracking-wider uppercase" style={`background:${d.colors.accent};color:${d.colors.onAccent}`}>{d.trade}</span>
              </div>
              <div class="mt-4 flex items-end justify-between gap-4">
                <div>
                  <p class="font-(family-name:--display) text-5xl leading-none uppercase sm:text-7xl">{n(i)} {d.name}</p>
                  <p class="mt-2 text-sm text-[#a3a6ad]">{d.look.join(' · ')}</p>
                </div>
                <span class="shrink-0 rounded-full border border-white/30 px-4 py-2 text-sm font-semibold transition group-hover:bg-white group-hover:text-black">View site →</span>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="px-4 py-32 sm:px-8">
      <h2 data-split class="font-(family-name:--display) text-[22vw] leading-[0.82] uppercase sm:text-[16vw]">Yours <span class="text-[#4f8bff]">next.</span></h2>
      <div class="mt-10 flex flex-wrap items-center justify-between gap-6">
        <p class="max-w-md text-lg text-[#a3a6ad]">Fixed price from £{site.priceFrom}, live in {site.turnaround}. You see it before you pay.</p>
        <a href="/#contact" class="rounded-full bg-[#4f8bff] px-8 py-4 text-lg font-semibold text-black">Get a quote</a>
      </div>
    </section>
  </div>
  <style is:inline>html,body{background:#08090b}</style>
</BaseLayout>

<script>
  import '@/scripts/motion'
</script>
