---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Boti from '@/components/Boti.astro'
---

<BaseLayout title="Page not found | Thomas Beckford" description="This page doesn't exist." noindex>
  <main id="main" class="mx-auto flex min-h-svh max-w-xl flex-col items-start justify-center px-4 sm:px-6">
    <a href="/" aria-label="Thomas Beckford, home"><Boti mood="oops" class="w-32" /></a>
    <p class="eyebrow mt-8">404</p>
    <h1 class="h2 mt-3">I can't find this page.</h1>
    <p class="mt-5 text-lg text-pretty text-muted">I've checked every circuit. The link might be old, or there might be a typo. Everything is on the home page.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn-primary">Back to the home page</a>
      <a href="/#contact" class="btn-ghost">Get in touch</a>
    </div>
  </main>
</BaseLayout>
