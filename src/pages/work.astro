---
// Every site in the work grid. The home shows the first few and links here.
// ponytail: plain links, no preview dialog (that lives on the home). Move it to a component if this page needs it.
import BaseLayout from '@/layouts/BaseLayout.astro'
import Logo from '@/components/Logo.astro'
import Icon from '@/components/Icon.astro'
import WorkCard from '@/components/WorkCard.astro'
import { site } from '@/site'
import { work } from '@/work'
---

<BaseLayout dark title={`All work | ${site.name}`} description={`Every website ${site.name} has built: example sites for UK trades and small businesses, and live ones.`}>
  <div class="overflow-x-clip">
    <header class="flex items-center justify-between gap-3 px-4 py-3 sm:px-8">
      <a href="/" aria-label="tebeck, home" class="py-2"><Logo class="text-[2.125rem]" /></a>
      <a href="/#contact" class="btn-primary min-h-11 px-5">Get a quote</a>
    </header>
    <main id="main" tabindex="-1" class="outline-none px-4 pt-16 pb-32 sm:px-8">
      <a href="/#sites" class="inline-flex items-center gap-2 text-sm font-semibold text-muted transition hover:text-accent-ink"><Icon name="arrow" class="size-4 rotate-180" />Back to home</a>
      <h1 class="display mt-8 text-[12vw] leading-[0.95] sm:text-[7vw]">All the work.</h1>
      <p class="mt-6 max-w-md text-lg text-muted">{work.length} websites. Open one and have a look around.</p>
      <ul class="mt-14 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {work.map((c) => <WorkCard c={c} />)}
      </ul>
    </main>
  </div>
</BaseLayout>

<script>
  import '@/scripts/motion'
</script>
