        <a href={site.linkedin} target="_blank" rel="noopener" class="py-1.5 transition hover:text-fg">LinkedIn</a>
        <a href={site.github} target="_blank" rel="noopener" class="py-1.5 transition hover:text-fg">GitHub</a>
        <a href="/privacy" class="py-1.5 transition hover:text-fg">Privacy</a>
      </div>
    </div>
