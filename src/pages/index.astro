---
// The home, in the example sites' look: giant condensed type on near-black. The robot says hello, the example sites do
// the selling (a grid of scroll-through previews), then price, questions and the ask. Motion comes from scripts/motion.ts.
import '@fontsource-variable/big-shoulders-display'
import { Image } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Logo from '@/components/Logo.astro'
import Icon from '@/components/Icon.astro'
import Boti from '@/components/Boti.astro'
import BotiChat from '@/components/BotiChat.astro'
import { site, services, cmsPrice, faqs, steps, whatsapp as wa } from '@/site'
import { work, home } from '@/work'
import WorkCard from '@/components/WorkCard.astro'
import PublishDemo from '@/components/PublishDemo.astro'
import Vid from '@/components/kit/Vid.astro'
import { trades } from '@/trades'
import thomasFull from '@/assets/thombeck.png'

// The quote message comes with blanks to fill, so a lead arrives with what I need to price the site.
const quote = "Hi Thomas, I'd like a quote for a website for my business.\n\nBusiness name: \nWhat we do: \nArea we cover: \nCurrent website (if any): "
const mailto = `mailto:${site.email}?subject=${encodeURIComponent('Website quote')}&body=${encodeURIComponent(quote)}`
const whatsapp = wa(quote)
const [, ...extras] = services
// The editing panels I set up, with what each is good at.
const cms = [['Payload', 'Open source, self-hosted'], ['Sanity', 'Live, shared editing'], ['Contentstack', 'Enterprise, many sites'], ['WordPress', 'Headless: the editor you know']]
// What the 'Bigger jobs' section lists: title, what it is, what it's built with.
const builds = [
  ['Web apps', 'Bookings, payments, customer logins and dashboards.', 'Next.js · TanStack Start · Stripe'],
  ['Mobile apps', 'iOS and Android from one codebase, in the stores.', 'React Native · Expo'],
  ['Backend and APIs', 'Databases, integrations, the part nobody sees.', 'Node · Fastify · Postgres'],
  ['AI features', 'Chatbots, automation and agents that do real work.', 'LLM APIs · agents'],
]
const waPath = 'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.4-.2Z'
const display = 'font-(family-name:--display) font-black tracking-[-0.01em] uppercase'
---

<BaseLayout
  dark
  schema={[{ '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }]}
  title={`Websites for UK tradespeople, from £${site.priceFrom} | ${site.name}`}
  description={`Websites for tradespeople and small businesses across the UK, built by ${site.name}, a London developer. From £${site.priceFrom}, free hosting, no deposit: you pay once you're happy. Edit it yourself or let me look after it.`}
>
  <!-- With motion, hold the headline back until SplitText has cut it, so it never flashes whole first.
       The style below unhides it after 2.5s no matter what, so a failed script can't leave it blank. -->
  <script is:inline>
    if (matchMedia('(prefers-reduced-motion: no-preference)').matches) document.documentElement.setAttribute('data-hold', '')
    // Wide screens at the top of the page get the intro: the editing panel full screen first, the rest after (motion.ts).
    if (matchMedia('(min-width: 1024px) and (prefers-reduced-motion: no-preference)').matches && !location.hash && scrollY < 10) document.documentElement.setAttribute('data-intro', '')
  </script>
  <style is:inline>
    html[data-hold] #hero h1 { visibility: hidden; animation: unhide 0s 2.5s forwards }
    html[data-intro] #hero h1, html[data-intro] [data-intro-copy] { visibility: hidden; animation: unhide 0s 4s forwards }
    html[data-intro] #hero [data-publish] { visibility: hidden; animation: unhide 0s 3s forwards }
    @keyframes unhide { to { visibility: visible } }
  </style>

  <div class="overflow-x-clip [--display:'Big_Shoulders_Display_Variable',system-ui,sans-serif]">
    <header class="fixed inset-x-0 top-0 z-40 flex items-center justify-between gap-3 bg-linear-to-b from-paper/90 to-transparent px-4 py-3 sm:px-8">
      <a href="/" class="flex items-center gap-2.5 font-semibold"><Logo class="size-9" /><span class="max-[420px]:sr-only">{site.name}</span></a>
      <nav aria-label="Main" class="flex items-center gap-2 text-sm font-semibold sm:gap-6">
        <a href="#sites" class="hidden transition hover:text-accent md:inline">Work</a>
        <a href="#services" class="hidden transition hover:text-accent md:inline">Services</a>
        <a href="#faq" class="hidden transition hover:text-accent md:inline">Questions</a>
        <button type="button" data-boti-open aria-label="Ask Boti, the quote helper" class="flex h-11 items-center gap-2 rounded-full bg-white/[0.06] p-1 ring-1 ring-line transition hover:ring-fg/30 sm:pr-4">
          <Boti mood="mini" class="w-9" /><span class="hidden sm:inline">Ask Boti</span>
        </button>
        <a href="#contact" class="btn-primary min-h-11 px-5">Get a quote</a>
      </nav>
    </header>

    <!-- Phones get a WhatsApp button; it bows out at the contact section. -->
    <a id="wa-fab" href={whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp Thomas" class="fixed right-4 bottom-[calc(1rem+env(safe-area-inset-bottom,0px))] z-30 grid size-14 place-items-center rounded-full bg-whatsapp text-[#1f2737] shadow-xl shadow-black/50 transition-[scale] duration-300 data-off:scale-0 sm:hidden">
      <svg viewBox="0 0 24 24" class="size-7" fill="currentColor" aria-hidden="true"><path d={waPath} /></svg>
    </a>

    <main id="main" tabindex="-1" class="outline-none">
      <!-- Hero: the giant line on the left, PublishDemo (the editing panel publishing a change, a different example site each loop) on the right. -->
      <section id="hero" class="relative isolate">
        <div class="grid min-h-[100dvh] grid-rows-[1fr_auto] px-4 pt-24 pb-8 sm:px-8">
          <div class="relative grid content-center gap-4">
            <div class="relative z-10 lg:pointer-events-none">
              <p data-intro-copy class="pointer-events-auto inline-flex items-center gap-2 rounded-full bg-white/[0.05] px-3.5 py-1.5 text-sm font-medium ring-1 ring-line">
                <span class="rounded-full bg-accent px-2 py-0.5 text-xs font-semibold text-on-accent">£{site.priceFrom}</span>
                Fixed price <span class="text-muted">· pay when you’re happy</span>
              </p>
              <h1 data-letters class:list={[display, 'mt-6 text-[14.5vw] leading-[0.9] sm:text-[13vw] lg:text-[10vw]']}>
                <span class="block">Websites that</span> <span class="block">make your</span> <span class="block text-accent">phone ring.</span>
              </h1>
            </div>
            <div class="relative lg:absolute lg:inset-y-0 lg:right-0 lg:grid lg:w-[34%] lg:content-center xl:w-[38%]">
              <figure class="m-0">
                <PublishDemo />
                <figcaption data-intro-copy class="mt-3 font-mono text-[11px] tracking-[0.2em] text-muted uppercase">Drawing of the +£{cmsPrice} editing panel · <a href="#edit-it-yourself" class="text-fg underline underline-offset-4">See the real one</a></figcaption>
              </figure>
            </div>
          </div>
          <div data-intro-copy class="mt-8 grid gap-6 border-t border-line pt-6 md:grid-cols-[1fr_auto] md:items-center">
            <p class="max-w-lg text-lg text-pretty text-muted">Websites for UK small businesses. Fixed price, live in {site.turnaround}, and you pay once you’re happy. Want to change the words and photos yourself? Add your own <a href="#edit-it-yourself" class="text-fg underline underline-offset-4">editing panel</a>.</p>
            <div class="flex flex-wrap gap-3">
              <a href={mailto} class="btn-primary min-h-14 px-7 text-base max-sm:w-full">Get a free quote<Icon name="arrow" class="size-4" /></a>
              <a href={whatsapp} target="_blank" rel="noopener" class="btn-whatsapp min-h-14 px-7 text-base max-sm:w-full">WhatsApp me</a>
            </div>
          </div>
        </div>
      </section>

      <!-- The six template sites (live ones are on /work): a grid of looping scroll-throughs (recorded from each site). -->
      <section id="sites" aria-labelledby="sites-title" class="scroll-mt-20 px-4 pt-32 sm:px-8">
        <h2 id="sites-title" data-split class:list={[display, 'text-[15vw] leading-[0.9] sm:text-[9.5vw]']}><span class="block">Pick a look.</span> <span class="block text-accent">Make it yours.</span></h2>
        <p class="mt-6 max-w-md text-lg text-muted">Full websites, each with its own look. Open one and have a look around.</p>
        <ul class="mt-14 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
          {home.map((c) => <WorkCard c={c} />)}
        </ul>
        {work.length > home.length && (
          <a href="/work" class="btn-ghost mt-14 min-h-14 px-7 text-base max-sm:w-full">View all {work.length} sites<Icon name="arrow" class="size-4" /></a>
        )}
      </section>

      <!-- The CMS options as giant type with one big way to get in touch, the three steps beside them, the add-ons as a quiet list. -->
      <section id="services" class="scroll-mt-20 px-4 py-24 sm:px-8 sm:py-32">
        <div class="grid gap-14 lg:grid-cols-[1fr_1.1fr]">
          <div>
            <p class="font-mono text-xs tracking-[0.2em] text-accent uppercase">Edit it yourself</p>
            <h2 data-split class:list={[display, 'mt-4 text-6xl leading-[0.9] sm:text-8xl']}>You edit it. <span class="text-accent">I keep it fast.</span></h2>
            <p class="mt-6 max-w-md text-lg text-pretty text-muted">Change your words, photos and prices yourself. I connect the site to the CMS that fits the job, and the pages stay quick.</p>
            <ul class="mt-10 divide-y divide-line border-y border-line">
              {cms.map(([n, t]) => (
                <li class="grid gap-1.5 py-4 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-6">
                  <span class:list={[display, 'text-5xl leading-none sm:text-6xl']}>{n}</span>
                  <span class="font-mono text-xs tracking-[0.15em] text-muted uppercase">{t}</span>
                </li>
              ))}
            </ul>
            <a href={whatsapp} target="_blank" rel="noopener" class="btn mt-10 min-h-20 w-full justify-between rounded-2xl bg-whatsapp px-7 text-xl text-[#1f2737] shadow-xl shadow-whatsapp/20 hover:shadow-whatsapp/40 sm:text-2xl">
              <span class="flex items-center gap-3"><svg viewBox="0 0 24 24" class="size-8" fill="currentColor" aria-hidden="true"><path d={waPath} /></svg>WhatsApp me</span>
              <span class="text-sm font-medium max-sm:hidden">One message, no forms</span>
            </a>
          </div>
          <div>
            <h2 data-split class:list={[display, 'text-6xl leading-[0.9] sm:text-8xl']}>Three steps. <span class="text-muted">You only do the first one.</span></h2>
            <ol class="mt-10 divide-y divide-line border-y border-line">
              {steps.map((s) => (
                <li class="grid grid-cols-[auto_1fr] gap-6 py-6">
                  <span aria-hidden="true" class:list={[display, 'text-6xl leading-none text-accent']}>{s.n}</span>
                  <div><h3 class="text-xl font-semibold">{s.title}</h3><p class="mt-1 text-pretty text-muted">{s.text}</p></div>
                </li>
              ))}
            </ol>
            <ul class="mt-10 grid gap-x-8 gap-y-4 sm:grid-cols-2">
              {extras.map((x) => (
                <li class="flex flex-wrap items-baseline justify-between gap-x-3 border-b border-line pb-3"><span class="font-semibold">{x.name}</span><span class="font-mono text-sm text-accent">{x.price}</span></li>
              ))}
            </ul>
          </div>
        </div>

        <!-- The Edit it yourself add-on in action: a real Payload panel and the client-starter site, recorded locally (client-starter/cms). -->
        <div id="edit-it-yourself" class="mt-24 grid scroll-mt-20 gap-10 lg:grid-cols-[1.6fr_1fr] lg:items-center">
          <div class="overflow-hidden rounded-2xl border border-line">
            <Vid src="/work/cms-demo" poster="/work/cms-demo.jpg" class="aspect-[8/5] w-full" />
          </div>
          <div>
            <p class="font-mono text-xs tracking-[0.2em] text-accent uppercase">Edit it yourself · +£{cmsPrice}, one-off</p>
            <h3 class:list={[display, 'mt-4 text-5xl leading-[0.9] sm:text-6xl']}>Change it <span class="text-accent">without calling me.</span></h3>
            <p class="mt-6 text-lg text-pretty text-muted">I build your website with its own editing panel. You change prices, words and your phone number whenever you like, and it goes live on its own. No waiting on me, no monthly fee.</p>
            <ol class="mt-8 divide-y divide-line border-y border-line">
              {[['Log in', 'Your own panel, with your own password. No code, no page builder.'], ['Change it', 'Prices, words, phone number, the areas you cover. The design stays as it is.'], ['Press Publish changes', 'Your website updates by itself in a minute or two.']].map(([t, x], i) => (
                <li class="grid grid-cols-[1.5rem_1fr] gap-4 py-4">
                  <span aria-hidden="true" class:list={[display, 'text-3xl leading-none text-accent']}>{i + 1}</span>
                  <div><p class="font-semibold">{t}</p><p class="mt-1 text-pretty text-muted">{x}</p></div>
                </li>
              ))}
            </ol>
            <p class="mt-4 text-sm text-pretty text-muted">The video is a real panel (Payload CMS) on an example site. Estancia La Josefina, one of my live sites, runs on Payload too, in Spanish and English. Rather just send me a message? That is the Care plan.</p>
          </div>
        </div>
      </section>

      <!-- For the bigger clients: what else gets built, with the two businesses above as the proof. -->
      <section id="apps" aria-labelledby="apps-title" class="scroll-mt-20 border-t border-line px-4 py-24 sm:px-8 sm:py-32">
        <p class="font-mono text-xs tracking-[0.2em] text-accent uppercase">Bigger jobs</p>
        <h2 id="apps-title" data-split class:list={[display, 'mt-4 text-6xl leading-[0.9] sm:text-8xl lg:text-9xl']}>More than a website? <span class="text-accent">I build that too.</span></h2>
        <div class="mt-8 grid gap-6 md:grid-cols-[1fr_auto] md:items-end">
          <p class="max-w-xl text-lg text-pretty text-muted">Bookings, payments, customer logins, an app in the stores, or the backend behind it all. <span class="text-fg">SoyMenu is a web app I built on my own. ArquerosYa, which I co-founded, is a web app plus iOS and Android apps in the stores, with the API behind them.</span></p>
          <a href={wa('Hi Thomas, I have a bigger project in mind.')} target="_blank" rel="noopener" class="btn-ghost min-h-14 px-7 max-sm:w-full">Tell me about it<Icon name="arrow" class="size-4" /></a>
        </div>
        <ol class="mt-14 grid gap-px overflow-hidden rounded-3xl bg-line ring-1 ring-line sm:grid-cols-2 xl:grid-cols-4">
          {builds.map(([title, text, stack], i) => (
            <li data-rise class="flex flex-col bg-paper p-7 sm:p-8">
              <span aria-hidden="true" class:list={[display, 'text-6xl leading-none text-accent']}>{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-10 text-2xl font-semibold">{title}</h3>
              <p class="mt-2 text-pretty text-muted">{text}</p>
              <p class="mt-auto pt-8 font-mono text-xs tracking-[0.15em] text-muted uppercase">{stack}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- Questions: all collapsed, one open at a time. Anything else goes to Boti. -->
      <section id="faq" class="scroll-mt-20 border-t border-line px-4 py-24 sm:px-8 sm:py-32">
        <div class="grid gap-12 lg:grid-cols-[1fr_1.6fr]">
          <div class="lg:sticky lg:top-24 lg:self-start">
            <h2 data-split class:list={[display, 'text-6xl leading-[0.9] sm:text-8xl']}>Ask <span class="text-accent">Boti.</span></h2>
            <Boti class="mt-8 hidden w-36 lg:block" />
            <button type="button" data-boti-open class="btn-ghost mt-8">Ask something else</button>
          </div>
          <div class="divide-y divide-line border-y border-line">
            {faqs.map(([q, a]) => (
              <details name="faq" class="faq group">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-lg font-semibold text-pretty transition-colors hover:text-accent group-open:text-accent [&::-webkit-details-marker]:hidden">
                  <span class="transition-transform duration-300 group-hover:translate-x-1.5 group-open:translate-x-1.5">{q}</span><span aria-hidden="true" class="grid size-8 shrink-0 place-items-center rounded-full text-2xl leading-none text-muted ring-1 ring-line transition duration-300 group-hover:ring-accent group-open:rotate-45 group-open:bg-accent group-open:text-on-accent group-open:ring-accent">+</span>
                </summary>
                <p class="max-w-2xl pb-6 text-pretty text-muted">{a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- The ask: one giant line, one person behind it, three ways in. -->
      <!-- The 3D robot (scripts/robot.ts) beside "Yours next.", following the pointer. -->
      <section id="contact" class="relative scroll-mt-20 border-t border-line px-4 py-24 sm:px-8 sm:py-32">
        <h2 data-split class:list={[display, 'text-[19vw] leading-[0.85] sm:text-[16vw]']}>Yours <span class="text-accent">next.</span></h2>
        <div id="robot-stage" class="relative mt-6 h-72 sm:h-[26rem] lg:absolute lg:top-2 lg:right-8 lg:mt-0 lg:h-[18rem] lg:w-[24%] xl:h-[22rem]">
          <p aria-hidden="true" class="pointer-events-none absolute right-0 bottom-2 left-0 z-10 text-center font-mono text-[11px] tracking-[0.2em] text-muted uppercase motion-reduce:hidden"><span class="pointer-coarse:hidden">Move your mouse. Click the robot</span><span class="hidden pointer-coarse:inline">Tap anywhere, then tap the robot</span></p>
          <canvas class="absolute inset-0 size-full touch-pan-y" role="img" aria-label="A small 3D robot hovering beside the heading"></canvas>
        </div>
        <div class="mt-12 grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
          <div class="flex items-center gap-4">
            <span class="size-14 shrink-0 overflow-hidden rounded-2xl bg-accent/10"><Image src={thomasFull} alt="" width={240} class="w-[180%] max-w-none -ml-[33%]" /></span>
            <p class="max-w-md text-lg text-pretty text-muted">Tell me what you do and where. I'll come back with a fixed price. No obligation, no deposit. <span class="text-fg">Usually replies within a day.</span></p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a href={whatsapp} target="_blank" rel="noopener" class="btn-whatsapp min-h-14 px-7 max-sm:w-full">WhatsApp me</a>
            <a href={mailto} class="btn-primary min-h-14 px-7 max-sm:w-full">Get a free quote<Icon name="arrow" class="size-4" /></a>
          </div>
        </div>
        <p class="mt-8 text-muted">
          Or call <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="inline-block py-1 font-semibold text-fg underline-offset-4 hover:underline">{site.phone}</a> or{' '}
          <button type="button" data-boti-open="Get me a price" class="inline-block py-1 font-semibold text-fg underline-offset-4 hover:underline">get a price from Boti</button>
        </p>
      </section>
    </main>

    <footer class="border-t border-line px-4 pt-14 text-sm text-muted sm:px-8">
      <div class="flex flex-wrap justify-between gap-10">
        <div>
          <Logo class="size-10" />
          <p class="mt-4 max-w-xs text-pretty">Websites for local businesses, built and looked after. London, UK.</p>
          <a href={`mailto:${site.email}`} class="mt-4 inline-block py-2 font-semibold text-fg underline-offset-4 hover:underline">{site.email}</a>
        </div>
        <nav aria-label="Footer" class="flex gap-12">
          <div class="flex flex-col items-start">
            {[['#sites', 'Examples'], ['#services', 'Services'], ['#faq', 'Questions'], ['#contact', 'Contact']].map(([h, t]) => <a href={h} class="py-1.5 transition hover:text-fg">{t}</a>)}
          </div>
          <div class="flex flex-col items-start">
            <a href="/cv" class="py-1.5 transition hover:text-fg">CV</a>
            <a href={site.linkedin} target="_blank" rel="noopener" class="py-1.5 transition hover:text-fg">LinkedIn</a>
            <a href={site.github} target="_blank" rel="noopener" class="py-1.5 transition hover:text-fg">GitHub</a>
            <a href="/privacy" class="py-1.5 transition hover:text-fg">Privacy</a>
          </div>
        </nav>
      </div>
      <p aria-hidden="true" class:list={[display, 'mt-14 text-center text-[clamp(2.5rem,13vw,13rem)] leading-[0.85] whitespace-nowrap text-fg/[0.06] select-none']}>Thomas Beckford</p>
      <p class="border-t border-line py-5 text-center text-xs">© {new Date().getFullYear()} {site.name} · London, UK</p>
    </footer>
  </div>

  <!-- Site preview: the example opens over the page instead of leaving it. -->
  <dialog id="preview" data-lenis-prevent aria-labelledby="preview-title" class="m-auto size-full max-h-none max-w-none bg-transparent p-0 backdrop:bg-black/80 backdrop:backdrop-blur-sm sm:h-[min(78dvh,760px)] sm:w-[min(1100px,calc(100vw-4rem))]">
    <div class="flex size-full flex-col overflow-hidden bg-accent text-on-accent sm:rounded-[1.75rem] sm:p-2 sm:pt-0 sm:shadow-[0_0_90px_-20px] sm:shadow-accent/50">
      <div class="flex items-center justify-between gap-3 py-2 pr-1 pl-4 text-sm sm:pl-3">
        <p id="preview-title" data-preview-title class="min-w-0 font-semibold text-ellipsis whitespace-nowrap overflow-hidden"></p>
        <div class="flex shrink-0 items-center gap-1">
          <a data-preview-open target="_blank" rel="noopener" class="rounded-full px-3 py-2 font-semibold opacity-70 transition hover:opacity-100">New tab ↗</a>
          <button type="button" data-preview-close autofocus aria-label="Close preview" class="grid size-10 place-items-center rounded-full bg-on-accent text-2xl leading-none text-accent transition hover:scale-105">×</button>
        </div>
      </div>
      <iframe data-preview-frame title="Site preview" class="min-h-0 flex-1 bg-white sm:rounded-[1.25rem]"></iframe>
    </div>
  </dialog>

  <BotiChat trades={trades.filter((t) => !t.pick).map((t) => t.name)} />
</BaseLayout>

<script>
  import '@/scripts/motion'

  // The WhatsApp button bows out from the contact section, where it points, to the end of the page.
  const fab = document.getElementById('wa-fab')!
  new IntersectionObserver(([e]) => {
    const off = e.isIntersecting || e.boundingClientRect.top < 0
    fab.toggleAttribute('data-off', off)
    fab.inert = off
  }).observe(document.getElementById('contact')!)

  // Example sites open in the preview modal; modified clicks (new tab, etc.) still go straight there.
  const preview = document.getElementById('preview') as HTMLDialogElement
  const frame = preview.querySelector<HTMLIFrameElement>('[data-preview-frame]')!
  let opener: HTMLElement | null = null
  document.querySelectorAll<HTMLAnchorElement>('a[data-preview]').forEach((a) =>
    a.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button) return
      e.preventDefault()
      opener = a
      frame.src = a.href
      frame.title = a.dataset.preview!
      preview.querySelector('[data-preview-title]')!.textContent = a.dataset.preview!
      preview.querySelector<HTMLAnchorElement>('[data-preview-open]')!.href = a.href
      preview.showModal()
    }),
  )
  preview.querySelector('[data-preview-close]')!.addEventListener('click', () => preview.close())
  preview.addEventListener('click', (e) => e.target === preview && preview.close())
  preview.addEventListener('close', () => {
    frame.src = 'about:blank'
    opener?.focus({ preventScroll: true })
  })
  // Esc inside a same-origin example still closes (a cross-origin page keeps its keys to itself).
  frame.addEventListener('load', () => {
    try { frame.contentWindow!.addEventListener('keydown', (e) => e.key === 'Escape' && preview.close()) } catch {}
  })
  // An example's "Get one like this" jumps this page to #contact: close the preview on the way.
  addEventListener('hashchange', () => preview.close())

  // The robot (in #contact): its own small chunk, loaded after the page. No WebGL: the stage stays empty.
  const robot = document.getElementById('robot-stage')!
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches
  import('@/scripts/robot').then((m) => m.mount(robot, reduced, document.getElementById('contact')!)).catch(() => robot.replaceChildren())
</script>
