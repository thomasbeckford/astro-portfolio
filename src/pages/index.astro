---
import { Image } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Logo from '@/components/Logo.astro'
import Icon from '@/components/Icon.astro'
import Phone from '@/components/Phone.astro'
import Cookie from '@/components/Cookie.astro'
import CookieChat from '@/components/CookieChat.astro'
import { site, services, faqs, foundingOffer, whatsapp as wa } from '@/site'
import thomas from '@/assets/thombeck-pro.png'
import arquerosya from '@/assets/work/arquerosya.png'
import josefina from '@/assets/work/josefina.png'
import soymenu from '@/assets/work/soymenu.png'
import soyreserva from '@/assets/work/soyreserva.png'
import soygestion from '@/assets/work/soygestion.png'
import CV from '@/components/CV.astro'

// Proof strip: real numbers already stated elsewhere on the page, just made bigger. No invented quotes.
const stats = [
  { count: null, text: site.years, label: 'Years shipping production code' },
  { count: 100, suffix: '+', label: 'Restaurants using software I built, since 2019' },
  { count: 10900, suffix: '+', label: 'People signed up to an app I built and run' },
]

const mailto = `mailto:${site.email}?subject=${encodeURIComponent('Website quote')}`
const whatsapp = wa("Hi Thomas, I'd like a website quote.")

// Plain promises that remove the reasons people don't get in touch. All already true elsewhere on the page.
const promises = ['See it before you pay', 'No deposit', 'Domain in your name']

const steps = [
  { n: '01', title: 'Send one message', text: 'WhatsApp or email. Tell me what you do and where. Two minutes, no forms, no calls unless you want one.' },
  { n: '02', title: `See it in ${site.turnaround}`, text: 'I write the words, pick the photos and build it. You get a link to the real site on your phone.' },
  { n: '03', title: 'Pay when you’re happy', text: 'Tell me what to change. Once you’re happy it goes live on your domain, and only then you pay. No deposit.' },
]

const brands = ['Five Iron Golf', 'Lane7', 'Sixes', 'Lévy Gorvy']

const work = [
  { name: 'Estancia La Josefina', sticker: 'Live', tag: 'Client website', url: 'https://www.estancialajosefina.com/en', img: josefina, text: 'A lodge in Patagonia. One page, two languages, photos front and centre and an enquiry button always in reach.' },
  { name: 'ArquerosYa', sticker: 'From scratch', tag: 'My own business · Argentina', url: 'https://arquerosya.com.ar/', img: arquerosya, text: 'A marketplace for hiring goalkeepers, built from scratch: web app, iOS and Android apps, and the API behind them. 10,900+ goalkeepers signed up.' },
  { name: 'SoyMenu', sticker: 'Since 2019', tag: 'My own business · Argentina', url: 'https://soymenu.com.ar/', img: soymenu, text: 'QR menus for 100+ restaurants, live since 2019. Owners change prices from their phone in seconds.' },
  { name: 'SoyReserva', tag: 'My own business · Argentina', url: 'https://soyreserva.com.ar/', img: soyreserva, text: 'Online table bookings for restaurants: tables, guests and no-shows in one place.' },
  { name: 'SoyGestión', tag: 'My own business · Argentina', url: 'https://soygestion.com.ar/', img: soygestion, text: 'Sales, costs and cash flow for restaurant owners, instead of spreadsheets.' },
]

// ponytail: row repeated 3x so the strip never runs out while it slides
const tape = ['See it before you pay', 'No deposit', `Live in ${site.turnaround}`, 'Fixed price', 'Domain in your name']
const marquee = ['Roofers', 'Electricians', 'Cafés', 'Salons', 'Plumbers', 'Gardeners', 'Builders', 'Restaurants']

// Live preview: each trade gets its own design, not just a colour. `look` becomes CSS vars on the phone site.
// Phone numbers sit in Ofcom's drama range (07700 900xxx), so they're never real.
const sans = 'var(--font-sans)'
const serif = 'ui-serif, Georgia, serif'
const light = { on: '#fff', bar: '#fff', glow: '16%' }
const dark = { on: '#fff', fg: '#fff', soft: 'rgb(255 255 255/.7)', panel: 'rgb(255 255 255/.06)', line: 'rgb(255 255 255/.14)', glow: '55%' }
const trades = [
  {
    name: 'Plumber', quip: 'Mind the pipes.', demo: 'Dave’s Plumbing', head: 'Leak? Boiler down? We’re on our way.', lede: 'Emergency call-outs, boilers and bathrooms across {area}.', cta: 'Get a fixed price',
    look: { ...light, c: '#0e7490', bg: '#f4f8fa', fg: '#0f172a', soft: 'rgb(15 23 42/.65)', panel: '#e3f1f4', line: 'rgb(14 116 144/.25)', r: '3cqw', font: sans, w: '800', case: 'none', align: 'left' },
    points: ['Gas Safe registered', 'Price agreed before we start', 'Serving {area} and nearby'],
    extra: { label: 'Emergency call-out', items: ['Day or night, seven days a week'] },
  },
  {
    name: 'Roofer', quip: 'Heights? Not for biscuits.', demo: 'Kestrel Roofing', head: 'Roof leaking? Fixed properly, first time.', lede: 'Repairs, re-roofs and flat roofs across {area}, with a written guarantee.', cta: 'Book a free roof check',
    look: { ...dark, c: '#dc2626', bg: '#111317', bar: '#16181d', r: '0.8cqw', font: sans, w: '800', case: 'uppercase', align: 'left' },
    points: ['Free, no-obligation quotes', 'Fully insured', 'Serving {area} and nearby'],
    extra: { label: 'Free roof check', items: ['Photos of your roof the same day'] },
  },
  {
    name: 'Electrician', quip: 'Ooh, sparky.', demo: 'Bright Spark Electrical', head: 'Sparks you can trust.', lede: 'Rewires, fuse boards and EV chargers across {area}. Certified and insured.', cta: 'Get a quote',
    look: { c: '#111', on: '#facc15', bg: '#facc15', bar: 'rgb(0 0 0/.07)', fg: '#111', soft: 'rgb(0 0 0/.72)', panel: 'rgb(0 0 0/.07)', line: 'rgb(0 0 0/.22)', glow: '0%', r: '0px', font: 'var(--font-mono)', w: '700', case: 'uppercase', align: 'left' },
    points: ['Part P certified', 'All work guaranteed', 'Serving {area} and nearby'],
    extra: { label: 'What we do', items: ['EV chargers', 'Fuse boards', 'Rewires', 'Lighting'], chips: true },
  },
  {
    name: 'Café', quip: 'Do you do biscuits? Asking for me.', demo: 'The Corner Café', head: 'Proper coffee. Proper breakfast.', lede: 'Your local in {area}. Open from 7, seven days a week.', cta: 'See the full menu',
    look: { ...light, c: '#9a3412', bg: '#f6efe4', bar: '#efe3d0', fg: '#2b1d14', soft: 'rgb(43 29 20/.65)', panel: '#fffaf2', line: 'rgb(43 29 20/.15)', r: '2cqw', font: serif, w: '600', case: 'none', align: 'center' },
    points: ['Dogs welcome', 'Seats outside', 'Takeaway all day'],
    extra: { label: 'On the menu', items: ['Flat white|£3.20', 'Full English|£9.50', 'Bacon roll|£4.50'] },
  },
  {
    name: 'Salon', quip: 'I’m all crumbs. Can you help?', demo: 'Bloom & Co', head: 'Walk in. Walk out wow.', lede: 'Cuts, colour and nails in {area}. Book online in seconds.', cta: 'Book online',
    look: { ...light, c: '#be185d', bg: '#fff6f9', fg: '#3b0a24', soft: 'rgb(59 10 36/.62)', panel: '#fde8f0', line: 'rgb(190 24 93/.2)', r: '99cqw', font: serif, w: '500', case: 'none', align: 'center' },
    points: ['Walk-ins welcome', 'Bridal and events', 'Gift vouchers'],
    extra: { label: 'Free today', items: ['10:30', '12:15', '15:45'], chips: true },
  },
  {
    name: 'Gardener', quip: 'Lovely. I’ll bring the tea.', demo: 'Green Thumb Gardens', head: 'Gardens you’ll want to sit in.', lede: 'Lawns, hedges and full makeovers across {area}.', cta: 'Get a free quote',
    look: { ...light, c: '#4d7c0f', bg: '#e8f0e0', bar: '#f4f8ef', fg: '#1a2e05', soft: 'rgb(26 46 5/.66)', panel: '#f6faf1', line: 'rgb(77 124 15/.25)', r: '6cqw', font: sans, w: '600', case: 'lowercase', align: 'left' },
    points: ['Free quotes', 'Green waste taken away', 'Serving {area} and nearby'],
    extra: { label: 'Opening hours', items: ['Mon to Sat, 8am to 5pm'] },
  },
]
const lookStyle = (look: Record<string, string>) => Object.entries(look).map(([k, v]) => `--${k}:${v}`).join(';')
---

<BaseLayout
  schema={[{ '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }]}
  title={`${site.name} | Websites for local businesses in London`}
  description={`Websites for local businesses, built and looked after by ${site.name}, a London software engineer with ${site.years} years' experience. From £${site.priceFrom}, plus optional care plan and ads management.`}
>
  <!-- Full-width and transparent at the top; shrinks into a floating glass capsule once you scroll (same gesture as SoyMenu). -->
  <header id="nav" class="group fixed inset-x-0 top-0 z-40 px-0 pt-0 transition-[padding] duration-300 ease-out data-scrolled:px-3 data-scrolled:pt-3">
    <div class="mx-auto flex h-14 max-w-[120rem] items-center justify-between border border-transparent pr-2 pl-4 transition-[max-width,border-radius,background-color,border-color,box-shadow] duration-300 ease-out group-data-scrolled:max-w-5xl group-data-scrolled:rounded-full group-data-scrolled:border-line group-data-scrolled:bg-white/75 group-data-scrolled:shadow-xl group-data-scrolled:shadow-fg/5 group-data-scrolled:backdrop-blur-xl group-data-scrolled:backdrop-saturate-150 sm:h-16 sm:pl-6">
      <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight">
        <Logo class="size-8" />
        <span class="whitespace-nowrap max-[380px]:group-data-scrolled:sr-only">Thomas Beckford</span>
      </a>
      <nav class="flex items-center gap-7 text-sm text-muted">
        <a href="#services" class="hidden transition hover:text-fg md:inline">Services</a>
        <a href="#work" class="hidden transition hover:text-fg md:inline">Work</a>
        <a href="#about" class="hidden transition hover:text-fg md:inline">About</a>
        <button type="button" data-cookie-open aria-label="Ask Cookie, the quote helper" class="flex h-11 items-center gap-2 rounded-xl bg-white p-1.5 text-sm font-semibold text-fg ring-1 ring-line transition hover:-rotate-2 hover:ring-fg/25 sm:pr-3.5">
          <Cookie mood="mini" class="w-8" />
          <span class="hidden sm:inline">Ask Cookie</span>
        </button>
        <a href="#contact" class="btn-primary -ml-4 min-h-11 px-4 text-xs">Get a quote</a>
      </nav>
    </div>
  </header>

  <!-- Scroll badge: circular text spins as you scroll, the ring fills with page progress. Doubles as the quote button. -->
  <a id="badge" href="#contact" aria-label="Get a quote" class="group dock-in hidden transition-[scale] duration-300 data-off:scale-0 fixed right-6 bottom-6 z-30 size-24 xl:size-32 place-items-center rounded-full bg-white/85 shadow-xl shadow-fg/15 ring-1 ring-line backdrop-blur-xl sm:grid">
    <svg viewBox="0 0 100 100" aria-hidden="true" class="absolute inset-0 size-full -rotate-90">
      <circle cx="50" cy="50" r="48" pathLength="1" class="fill-none stroke-fg/10 stroke-[1.5]" />
      <circle cx="50" cy="50" r="48" pathLength="1" class="progress-scroll fill-none stroke-accent stroke-[1.5] [stroke-dasharray:1] [stroke-linecap:round]" />
    </svg>
    <svg viewBox="0 0 100 100" aria-hidden="true" class="spin-scroll absolute inset-0 size-full">
      <path id="badge-circle" d="M50,50 m-37,0 a37,37 0 1,1 74,0 a37,37 0 1,1 -74,0" fill="none" />
      <text class="fill-fg font-mono text-[10px] font-extrabold uppercase"><textPath href="#badge-circle" textLength="230" lengthAdjust="spacing">Get a quote ✦ Get a quote ✦</textPath></text>
    </svg>
    <span class="grid size-10 place-items-center rounded-full bg-accent text-white shadow-md shadow-accent/30 transition duration-300 group-hover:scale-110 group-hover:rotate-45 sm:size-12">
      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
    </span>
  </a>

  <!-- Phones get a WhatsApp button instead of the desktop badge; hides with it once the contact section is on screen. -->
  <a id="wa-fab" href={whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp Thomas" class="dock-in fixed right-4 bottom-[calc(1rem+env(safe-area-inset-bottom,0px))] z-30 grid size-14 place-items-center rounded-full bg-whatsapp text-fg shadow-xl shadow-fg/25 transition-[scale] duration-300 data-off:scale-0 sm:hidden">
    <svg viewBox="0 0 24 24" class="size-7" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.4-.2Z"/></svg>
  </a>

  <main id="main" tabindex="-1" class="outline-none">
    <!-- Split hero: the visitor types their business on the left, the phone on the right builds their site live. Stacks on phones. -->
    <section id="hero" class="relative isolate overflow-x-clip pt-28 sm:pt-36 lg:pt-32">
      <div aria-hidden="true" class="absolute top-0 right-0 -z-10 h-[760px] w-full bg-[radial-gradient(ellipse_55%_60%_at_80%_20%,rgb(37_99_235/0.2),transparent)]"></div>
      <div class="mx-auto grid max-w-6xl items-center gap-14 px-4 pb-20 sm:px-6 sm:pb-28 lg:min-h-[calc(100dvh-8rem)] lg:grid-cols-[1.1fr_1fr] lg:gap-8 lg:px-8 lg:pb-16">
        <form id="try-form" data-trades={JSON.stringify(trades)}>
          <p class="enter inline-flex items-center gap-2 rounded-full bg-white px-3.5 py-1.5 text-sm font-medium text-fg shadow-sm ring-1 ring-fg/10">
            <span class="rounded-full bg-accent px-2 py-0.5 text-xs font-semibold text-white">£{foundingOffer.price}</span>
            Founding offer for the first {foundingOffer.slots} clients
          </p>
          <h1 class="display enter mt-7 text-[2.9rem] leading-[0.95] text-balance [--d:90ms] sm:text-7xl lg:text-[clamp(3.25rem,7.5vh,5.2rem)]">
            Websites that make your <span class="mark">phone ring.</span>
          </h1>
          <p class="enter mt-6 max-w-xl text-lg [--d:170ms] lg:mt-5 text-pretty text-muted">
            I'm Thomas, a London developer with {site.years} years' experience. Type your business and watch the phone build it.
          </p>
          <div class="enter mt-7 grid gap-4 [--d:250ms] sm:grid-cols-2">
            <label class="block text-sm font-semibold">Your business<input name="name" class="field mt-2" placeholder="Dave’s Plumbing" maxlength="28" autocomplete="organization" /></label>
            <label class="block text-sm font-semibold">Where<input name="area" class="field mt-2" placeholder="Bromley" maxlength="40" autocomplete="address-level2" /></label>
          </div>
          <fieldset class="enter mt-4 [--d:290ms]">
            <legend class="text-sm font-semibold">What you do</legend>
            <div class="mt-2 flex flex-wrap gap-2">
              {
                trades.map((t, i) => (
                  <label class="cursor-pointer rounded-xl px-3.5 py-2 text-sm ring-1 ring-fg/15 transition ring-inset hover:bg-fg/[0.06] has-checked:bg-fg has-checked:text-white has-checked:ring-fg has-focus-visible:outline-2 has-focus-visible:outline-accent">
                    <input type="radio" name="trade" value={i} checked={i === 0} class="sr-only" />
                    {t.name}
                  </label>
                ))
              }
            </div>
          </fieldset>
          <div class="enter mt-8 flex flex-wrap items-center gap-3 [--d:330ms] lg:mt-7">
            <a id="try-cta" href={mailto} class="btn-primary min-h-14 px-7 text-base max-sm:w-full">Get a free quote<Icon name="arrow" class="size-4" /></a>
            <a href={whatsapp} target="_blank" rel="noopener" class="btn-whatsapp min-h-14 px-7 text-base max-sm:w-full">WhatsApp me</a>
          </div>
          <p class="enter mt-6 flex items-center gap-3 text-sm text-muted [--d:370ms]">
            <Image src={thomas} alt="" width={64} class="size-9 rounded-xl object-cover ring-2 ring-white" />
            <span><strong class="font-semibold text-fg">From £{site.priceFrom}, fixed price.</strong> Live in {site.turnaround}.</span>
          </p>
        </form>

        <!-- The live phone. Tilts toward the pointer, Cookie chats beside it about what you type. -->
        <div class="enter relative mx-auto [--d:420ms]">
          <div class="hero-exit">
            <div id="tilt" class="transition-transform duration-500 ease-out [transform:perspective(1600px)_rotateX(var(--rx,4deg))_rotateY(var(--ry,-8deg))]">
              <Phone class="float w-[280px] sm:w-[320px] lg:w-[min(340px,calc((100dvh-9rem)*0.44))]">
                <div id="try-site" aria-hidden="true" class="@container flex aspect-[9/19.5] flex-col bg-(--bg) font-(family-name:--font) text-(--fg) transition-colors duration-500 [text-align:var(--align)]" style={lookStyle(trades[0].look)}>
                  <div class="flex items-center justify-between gap-[3cqw] bg-(--bar) px-[5cqw] py-[4cqw] text-left shadow-[0_1px_0_var(--line)] transition-colors duration-500">
                    <div class="min-w-0">
                      <p data-k="name" class="truncate text-[6.5cqw] tracking-tight [font-weight:var(--w)] [text-transform:var(--case)]">Dave’s Plumbing</p>
                      <p class="truncate text-[3.4cqw] text-(--soft)"><span data-k="trade">Plumber</span> · <span data-k="area">Bromley</span></p>
                    </div>
                    <span class="grid size-[11cqw] shrink-0 place-items-center rounded-[min(var(--r),3cqw)] bg-(--c) text-(--on) transition-colors duration-500"><Icon name="phone" class="size-[5cqw]" /></span>
                  </div>
                  <div class="flex-1 bg-[radial-gradient(120%_70%_at_80%_0%,color-mix(in_oklab,var(--c)_var(--glow),transparent),transparent)] px-[5cqw] pt-[9cqw] transition-[background] duration-500">
                    <span data-k="area" class="inline-block rounded-[min(var(--r),1.5cqw)] bg-(--c) px-[3cqw] py-[1.2cqw] text-[3.2cqw] font-bold tracking-[0.12em] text-(--on) uppercase transition-colors duration-500">Bromley</span>
                    <p data-k="head" class="mt-[4cqw] text-[10cqw] leading-[0.95] tracking-tight text-balance [font-weight:var(--w)] [text-transform:var(--case)]">{trades[0].head}</p>
                    <p data-k="lede" class="mt-[4cqw] text-[4cqw] leading-snug text-(--soft)">{trades[0].lede.replace('{area}', 'Bromley')}</p>
                    <span class="mt-[6cqw] flex items-center justify-center gap-[2cqw] rounded-[var(--r)] bg-(--c) py-[3.5cqw] text-[4.4cqw] font-semibold text-(--on) transition-colors duration-500"><Icon name="phone" class="size-[4.4cqw]" />Call 07700 900412</span>
                    <span class="mt-[2.5cqw] flex justify-center rounded-[var(--r)] py-[3.5cqw] text-[4.4cqw] font-semibold ring-1 ring-(--line) ring-inset"><span data-k="cta">{trades[0].cta}</span>&nbsp;→</span>
                    <!-- Each trade's own extras, rendered up front; the script only flips which one shows. -->
                    {
                      trades.map((t, i) => (
                        <div data-trade={i} hidden={i !== 0}>
                          <ul class="mt-[6cqw] space-y-[1.5cqw] text-[3.8cqw] font-medium">
                            {t.points.map((pt) => <li><span class="text-(--c)">✓</span> {pt.split('{area}').map((part, j) => (j ? [<span data-k="area">Bromley</span>, part] : part))}</li>)}
                          </ul>
                          <div class="mt-[6cqw] rounded-[min(var(--r),4cqw)] bg-(--panel) p-[4cqw] text-[3.6cqw] ring-1 ring-(--line)">
                            <p class="text-(--soft)">{t.extra.label}</p>
                            {t.extra.chips ? (
                              <p class="mt-[2cqw] flex flex-wrap gap-[1.5cqw] [justify-content:var(--align)]">{t.extra.items.map((x) => <span class="rounded-[var(--r)] px-[2.5cqw] py-[1cqw] ring-1 ring-(--line)">{x}</span>)}</p>
                            ) : (
                              t.extra.items.map((x) => <p class="mt-[1.5cqw] flex gap-[2cqw] [justify-content:var(--align)] has-[span]:justify-between">{x.split('|').map((s, j) => (j ? <span class="font-semibold text-(--c)">{s}</span> : s))}</p>)
                            )}
                          </div>
                        </div>
                      ))
                    }
                  </div>
                </div>
              </Phone>
            </div>
          </div>
          <div class="absolute -bottom-6 -left-6 z-10 flex items-end gap-1 sm:-left-24">
            <Cookie live id="try-cookie" class="w-20 sm:w-24" />
            <p id="try-quip" aria-live="polite" class="mb-16 max-w-40 rounded-[16px_16px_16px_4px] bg-fg px-3 py-2 text-sm font-semibold text-white shadow-lg sm:mb-20">Go on, type your business.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Proof strip: numbers count up once in view. Real figures already said elsewhere on the page, just made bigger. -->
    <section aria-label="Track record" class="border-y border-line bg-white">
      <div class="mx-auto max-w-6xl lg:px-8"><div class="grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-[repeat(3,1fr)_1.2fr]">
        {
          stats.map((s, i) => (
            <div class="reveal flex items-baseline gap-4 bg-white px-4 py-6 sm:block sm:px-6 sm:py-10" style={`--d:${i * 80}ms`}>
              <p class="display shrink-0 text-4xl tabular-nums sm:text-5xl">
                {s.count === null ? s.text : <span data-count={s.count} data-suffix={s.suffix}>{s.count.toLocaleString('en-GB') + s.suffix}</span>}
              </p>
              <p class="text-sm text-pretty text-muted sm:mt-2">{s.label}</p>
            </div>
          ))
        }
        <ul class="reveal flex flex-col justify-center gap-2 bg-white px-4 py-6 text-sm font-medium [--d:240ms] sm:px-6 sm:py-10">
          {promises.map((p) => <li class="flex items-center gap-2.5"><span class="grid size-5 place-items-center rounded-full bg-accent/10 text-xs text-accent">✓</span>{p}</li>)}
        </ul></div>
      </div>
    </section>

    <!-- One tape at a slight angle. Wider than the screen so the tilt never shows an edge. -->
    <section aria-hidden="true" class="overflow-clip pt-12 pb-20 sm:pt-20 sm:pb-32">
      <div class="relative -mx-[5%] -rotate-2 bg-accent py-4 shadow-xl shadow-accent/25 sm:py-6">
        <div class="marquee flex w-max gap-10 whitespace-nowrap">
          {[...marquee, ...marquee, ...marquee].map((w) => (
            <span class="display flex items-center gap-10 text-4xl text-white sm:text-6xl">
              {w}
              <span class="text-white/40">✦</span>
            </span>
          ))}
        </div>
      </div>
    </section>

    <section id="how" class="light py-24 sm:py-32">
