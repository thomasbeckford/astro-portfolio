<script>
  // Nav turns into a floating capsule once the page scrolls.
  const nav = document.getElementById('nav')!
  // The quote badge bows out once the contact section, where it points, is on screen.
  const badge = document.getElementById('badge')!
  const fab = document.getElementById('wa-fab')!
  const contact = document.getElementById('contact')!
  const docks = CSS.supports('animation-timeline: scroll()') && !matchMedia('(prefers-reduced-motion: reduce)').matches
  const onScroll = () => {
    nav.toggleAttribute('data-scrolled', scrollY > 40)
    const atContact = contact.getBoundingClientRect().top < innerHeight * 0.8
    badge.toggleAttribute('data-off', atContact)
    fab.toggleAttribute('data-off', atContact)
    // Hidden (scaled away at contact, or still docked out near the top) = out of tab order and screen readers too.
    badge.inert = fab.inert = atContact || (docks && scrollY < 200)
  }
  addEventListener('scroll', onScroll, { passive: true })
  onScroll()

  // Reveal in and out: hidden while off screen (only things that start below the fold, so nothing blinks on load and no-JS shows everything).
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const pending = [...document.querySelectorAll<HTMLElement>('.reveal')].filter((el) => el.getBoundingClientRect().top > innerHeight)
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) e.target.toggleAttribute('data-pending', !e.isIntersecting)
      },
      { rootMargin: '-6% 0px -10% 0px' },
    )
    for (const el of pending) {
      el.setAttribute('data-pending', '')
      io.observe(el)
    }
  }

  // Cookie reacts: a short run of faces, then back to hello.
  const react = (el: HTMLElement, steps: [string, number][]) => {
    let t = 0
    for (const [m, ms] of [...steps, ['hello', 0] as [string, number]]) {
      setTimeout(() => {
        el.dataset.mood = m
        el.classList.remove('mascot-pop')
        void el.getBoundingClientRect()
        el.classList.add('mascot-pop')
      }, t)
      t += ms
    }
  }

  // Try it: mirror the form into the phone site and the quote email.
  const tryForm = document.getElementById('try-form') as HTMLFormElement
  const trySite = document.getElementById('try-site')!
  const tryCta = document.getElementById('try-cta') as HTMLAnchorElement
  const trades = JSON.parse(tryForm.dataset.trades!) as { name: string; quip: string; demo: string; head: string; lede: string; cta: string; look: Record<string, string> }[]
  const set = (k: string, v: string) => trySite.querySelectorAll(`[data-k="${k}"]`).forEach((el) => (el.textContent = v))
  const render = () => {
    const f = new FormData(tryForm)
    const val = (k: string) => String(f.get(k) ?? '').trim() || (tryForm.elements.namedItem(k) as HTMLInputElement).placeholder
    const t = trades[Number(f.get('trade'))]
    const nameInput = tryForm.elements.namedItem('name') as HTMLInputElement
    nameInput.placeholder = t.demo
    const name = val('name')
    const area = val('area')
    for (const [k, v] of Object.entries(t.look)) trySite.style.setProperty(`--${k}`, v)
    trySite.querySelectorAll<HTMLElement>('[data-trade]').forEach((el) => (el.hidden = el.dataset.trade !== f.get('trade')))
    set('name', name)
    set('area', area)
    set('trade', t.name)
    set('head', t.head)
    set('cta', t.cta)
    set('lede', t.lede.replace('{area}', area))
    // The email carries only what the visitor typed, never the demo placeholders.
    const typed = (k: string) => String(f.get(k) ?? '').trim()
    const body = [`Hi Thomas, I'd like a website like the one I just made on your page.`, '', picked ? `Trade: ${t.name}` : null, typed('name') ? `Business: ${typed('name')}` : null, typed('area') ? `Area: ${typed('area')}` : null].filter((l) => l !== null).join('\n')
    tryCta.href = `mailto:${tryCta.href.slice(7).split('?')[0]}?subject=${encodeURIComponent(typed('name') ? `Website for ${typed('name')}` : 'Website quote')}&body=${encodeURIComponent(body)}`
  }
  // Cookie's running commentary. ponytail: textContent only, the visitor's text never becomes HTML.
  const tryCookie = document.getElementById('try-cookie')!
  const quip = document.getElementById('try-quip')!
  let quipTimer = 0
  tryForm.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement
    clearTimeout(quipTimer)
    quipTimer = window.setTimeout(() => {
      const v = el.value.trim()
      if (el.name === 'trade') quip.textContent = trades[Number(el.value)].quip
      else if (!v) return
      else quip.textContent = el.name === 'name' ? `${v}? I’d ring them.` : `${v}! Lovely round there.`
      quip.classList.remove('bubble-in')
      void quip.offsetWidth
      quip.classList.add('bubble-in')
      react(tryCookie, [['done', 1400]])
    }, el.name === 'trade' ? 0 : 600)
  })
  // Only a trade the visitor chose goes in the email, not one the slideshow landed on. Programmatic .checked fires no input event.
  // Registered before render so the click that picks a trade already counts.
  let picked = false
  tryForm.addEventListener('input', () => (picked = true))
  tryForm.addEventListener('input', render)
  // Browser may restore typed values on back/reload; only then resync (and keep their pick), so the default mailto stays generic.
  const restored = !!((tryForm.elements.namedItem('name') as HTMLInputElement).value || (tryForm.elements.namedItem('area') as HTMLInputElement).value || !tryForm.querySelector<HTMLInputElement>('input[name=trade][value="0"]')!.checked)
  if (restored) {
    picked = true
    render()
  }
  // Until the visitor touches the form, the phone cycles through the trades on its own. Pauses off screen and in background tabs.
  if (!restored && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let heroVisible = true
    new IntersectionObserver(([e]) => (heroVisible = e.isIntersecting)).observe(trySite)
    const radios = tryForm.querySelectorAll<HTMLInputElement>('input[name=trade]')
    const cycle = setInterval(() => {
      if (document.hidden || !heroVisible) return
      const i = [...radios].findIndex((r) => r.checked)
      radios[(i + 1) % radios.length].checked = true
      render()
    }, 2800)
    for (const ev of ['pointerdown', 'focusin']) tryForm.addEventListener(ev, () => clearInterval(cycle), { once: true })
  }
  tryForm.addEventListener('submit', (e) => e.preventDefault())

  // The questions Cookie.
  const faqCookie = document.getElementById('faq-cookie')!
  document.querySelectorAll('#faq details').forEach((d) =>
    d.addEventListener('toggle', () => (d as HTMLDetailsElement).open && react(faqCookie, [['thinking', 550], ['done', 1600]])),
  )
  // The label hides once checked, taking focus with it: hand focus to the first question it revealed.
  const faqMore = document.getElementById('faq-more') as HTMLInputElement
  faqMore.addEventListener('change', () => faqMore.checked && document.querySelectorAll<HTMLElement>('#faq summary')[5]?.focus())

  // Proof strip: count up from 0 once each number scrolls into view, once.
  const counters = document.querySelectorAll<HTMLElement>('[data-count]')
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches
  const animateCount = (el: HTMLElement) => {
    const target = Number(el.dataset.count)
    const suffix = el.dataset.suffix ?? ''
    if (reducedMotion) {
      el.textContent = target.toLocaleString('en-GB') + suffix
      return
    }
    const start = performance.now()
    const dur = 1100
    const tick = (now: number) => {
      const p = Math.min(1, (now - start) / dur)
      el.textContent = Math.round(target * (1 - (1 - p) ** 3)).toLocaleString('en-GB') + suffix
      if (p < 1) requestAnimationFrame(tick)
    }
    requestAnimationFrame(tick)
  }
  const countIo = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue
      animateCount(e.target as HTMLElement)
      countIo.unobserve(e.target)
    }
  }, { threshold: 0.6 })
  counters.forEach((el) => countIo.observe(el))

  // Hero phone tilts toward the pointer; cards get a glow that follows it. Skipped for reduced motion and touch.
  if (matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
    const tilt = document.getElementById('tilt')!
    document.getElementById('hero')!.addEventListener('pointermove', (e) => {
      tilt.style.setProperty('--ry', `${(e.clientX / innerWidth - 0.5) * 14 - 8}deg`)
      tilt.style.setProperty('--rx', `${4 - (e.clientY / innerHeight - 0.5) * 8}deg`)
    })
    document.addEventListener('pointermove', (e) => {
      const el = (e.target as Element).closest<HTMLElement>('.spot')
      if (!el) return
      const r = el.getBoundingClientRect()
      el.style.setProperty('--x', `${e.clientX - r.left}px`)
      el.style.setProperty('--y', `${e.clientY - r.top}px`)
    })
  }
</script>
