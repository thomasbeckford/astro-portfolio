            <span class="flex items-center gap-3 rounded-xl bg-fg px-5 py-3 text-sm font-semibold text-paper transition group-hover:bg-fg/90" aria-hidden="true">
              <span class="group-open:hidden">Open CV</span><span class="hidden group-open:inline">Close</span>
              <span class="text-lg leading-none transition group-open:rotate-45">+</span>
            </span>
          </summary>
          <div class="border-t border-line p-6 sm:p-10">
            <CV />
