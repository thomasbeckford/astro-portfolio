---
// The home: Bricolage Grotesque headlines on white. The hero lets the visitor try their own name on an example site
// (SiteBuilder, which also loads Archivo), then the example sites, price, questions and the ask. Motion comes from scripts/motion.ts.
import { Image } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Logo from '@/components/Logo.astro'
import Icon from '@/components/Icon.astro'
import { site, services, faqs, steps, whatsapp as wa } from '@/site'
import { work, home } from '@/work'
import WorkCard from '@/components/WorkCard.astro'
import SiteBuilder from '@/components/SiteBuilder.astro'
import PublishDemo from '@/components/PublishDemo.astro'
import thomasFull from '@/assets/thombeck.png'

// The quote message comes with blanks to fill, so a lead arrives with what I need to price the site.
const quote = "Hi Thomas, I'd like a quote for a website for my business.\n\nBusiness name: \nWhat we do: \nArea we cover: \nCurrent website (if any): "
const mailto = `mailto:${site.email}?subject=${encodeURIComponent('Website quote')}&body=${encodeURIComponent(quote)}`
const whatsapp = wa(quote)
const [, ...extras] = services
// The add-ons beside the demo: anchor, how it's paid, the promise, one line on what it does.
const addons = [
  ['edit-it-yourself', 'Edit it yourself · one-off', 'Change it without calling me.', 'Your own editing panel: prices, words, your number. No monthly fee.'],
  ['enquiry-alerts', 'Enquiry alerts · one-off', 'Never lose an enquiry.', 'Every WhatsApp or email tap pings your phone and goes in a list, with a nudge if it waits 3 days.'],
  ['dashboards', 'Dashboards · on quote', 'Your numbers, on one screen.', 'Jobs, invoices and costs. Am I making money, who owes me, is next week full?'],
]
// What the 'Bigger jobs' section lists: title, what it is, what it's built with.
const builds = [
  ['Web apps', 'Bookings, payments, customer logins and dashboards.', 'Next.js · TanStack Start · Stripe'],
  ['Mobile apps', 'iOS and Android from one codebase, in the stores.', 'React Native · Expo'],
  ['Backend and APIs', 'Databases, integrations, the part nobody sees.', 'Node · Fastify · Postgres'],
  ['AI features', 'Chatbots, automation and agents that do real work.', 'LLM APIs · agents'],
]
const waPath = 'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.4-.2Z'
// The tapes under the hero: what you get on the mint one, who it's for on the navy one. Each list runs four times so the -50% loop is seamless.
const perks = ['Fixed price', 'Pay when you’re happy', `Live in ${site.turnaround}`, 'Free hosting', 'Edit it yourself']
const trades = ['Trades', 'Pubs', 'Hotels', 'Venues', 'Roofers', 'Electricians', 'Decorators', 'Landscapers', 'Builders', 'Golf bars']
const loop = (xs: string[]) => [...xs, ...xs, ...xs, ...xs]
const display = 'font-(family-name:--display) font-extrabold tracking-[-0.025em]'
---

<BaseLayout
  schema={[{ '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }]}
  title={`Websites for UK tradespeople and small businesses | ${site.name}`}
  description={`Websites for tradespeople, hospitality and small businesses across the UK, built by ${site.name}, a London developer. Fixed price, free hosting, no deposit: you pay once you're happy. Edit it yourself or let me look after it.`}
>
  <!-- With motion, hold the headline back until SplitText has cut it, so it never flashes whole first.
       The style below unhides it after 2.5s no matter what, so a failed script can't leave it blank.
       Phones skip the hold and the letters (data-letters="wide"): there the headline is the first thing read, it shows at once. -->
  <script is:inline>
    if (matchMedia('(prefers-reduced-motion: no-preference) and (min-width: 640px)').matches) document.documentElement.setAttribute('data-hold', '')
  </script>
  <style is:inline>
    html[data-hold] #hero h1, html[data-hold] [data-stripes] { visibility: hidden; animation: unhide 0s 2.5s forwards }
    @keyframes unhide { to { visibility: visible } }
  </style>

  <div class="overflow-x-clip bg-paper xl:pl-14 [--color-paper:#ffffff] [--display:var(--font-display)]">
    <!-- A floating island, not a full-width bar: the page shows around it. -->
    <header class="fixed top-3.5 left-1/2 z-40 flex h-[3.875rem] w-[min(57.5rem,calc(100%-1.5rem))] -translate-x-1/2 items-center justify-between gap-3 rounded-full bg-white/80 pr-2 pl-5 shadow-[0_0_0_1px_rgb(15_23_42/0.08),0_14px_34px_-18px_rgb(15_23_42/0.35)] backdrop-blur-md">
      <a href="/" aria-label="tebeck, home" class="py-2"><Logo class="text-[1.75rem]" animated /></a>
      <nav aria-label="Main" class="flex items-center gap-1.5 text-sm font-semibold">
        <a href="#sites" class="nav-link hidden md:inline-flex">Work</a>
        <a href="#services" class="nav-link hidden md:inline-flex">Services</a>
        <a href="#faq" class="nav-link hidden md:inline-flex">Questions</a>
        <a href={whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp Thomas" class="hidden size-11 place-items-center rounded-full bg-whatsapp text-white transition hover:scale-105 sm:grid"><svg viewBox="0 0 24 24" class="size-5.5" fill="currentColor" aria-hidden="true"><path d={waPath} /></svg></a>
        <a href="#contact" class="btn-primary min-h-11 px-5">Get a quote</a>
      </nav>
    </header>

    <!-- Phones get a WhatsApp button; it bows out at the contact section. -->
    <a id="wa-fab" href={whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp Thomas" class="fixed right-4 bottom-[calc(1rem+env(safe-area-inset-bottom,0px))] z-30 grid size-14 place-items-center rounded-full bg-whatsapp text-white shadow-xl shadow-black/20 transition-[scale] duration-300 data-off:scale-0 sm:hidden">
      <svg viewBox="0 0 24 24" class="size-7" fill="currentColor" aria-hidden="true"><path d={waPath} /></svg>
    </a>

    <!-- Wide screens: the navy tape also runs down the left edge and moves with the scroll (one only: a second on the right was dizzying, Thomas). -->
    <div aria-hidden="true" class="rail rail-navy"><div>{loop(trades).map((t) => <><span>{t}</span><i /></>)}</div></div>

    <main id="main" tabindex="-1" class="outline-none">
      <!-- Hero: the line across the top, then the pitch, the phone building a site and the try-it line (SiteBuilder). -->
      <section id="hero" class="relative isolate px-4 pt-28 pb-12 sm:px-8 lg:pt-32">
        <div class="mx-auto max-w-[80rem]">
          <SiteBuilder>
            <h1 data-letters="wide" data-ring="ring." class:list={[display, 'text-[clamp(2.5rem,4.2vw,4rem)] leading-[0.98] text-balance xl:text-center']}>
              Websites that make your phone <span class="inline-block text-accent">ring.</span>
            </h1>
            <p slot="aside" class="max-w-lg text-lg text-pretty text-muted sm:text-xl">For UK small businesses, from trades to pubs, hotels and venues. Fixed price, live in {site.turnaround}, and you pay once you’re happy.</p>
            <div slot="aside" class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
              <a href={mailto} class="btn-primary min-h-14 px-7 text-base max-sm:w-full">Like it? Get a quote<Icon name="arrow" class="size-4" /></a>
              <a href={whatsapp} target="_blank" rel="noopener" class="btn-whatsapp min-h-14 px-7 text-base max-sm:w-full">WhatsApp me</a>
            </div>
          </SiteBuilder>
        </div>
      </section>

      <!-- Two tapes cross under the hero, running opposite ways. -->
      <div aria-hidden="true" class="tapes">
        <div class="tape tape-navy"><div>{loop(trades).map((t) => <><span>{t}</span><i /></>)}</div></div>
        <div class="tape tape-pop"><div>{loop(perks).map((t) => <><span>{t}</span><i /></>)}</div></div>
      </div>

      <!-- The six template sites (live ones are on /work): a grid of looping scroll-throughs (recorded from each site). -->
      <section id="sites" aria-labelledby="sites-title" class="scroll-mt-20 px-4 pt-20 sm:px-8">
        <h2 id="sites-title" data-split class:list={[display, 'text-[10vw] leading-[0.95] sm:text-[6vw]']}><span class="block">Pick a look.</span> <span class="block text-accent">Make it yours.</span></h2>
        <p class="mt-6 max-w-md text-lg text-muted">Full websites, each with its own look, for trades and for hospitality: bars, hotels and venues, with bookings built in. Open one and have a look around.</p>
        <ul class="mt-14 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
          {home.map((c) => <WorkCard c={c} />)}
        </ul>
        {work.length > home.length && (
          <a href="/work" class="btn-ghost mt-14 min-h-14 px-7 text-base max-sm:w-full">View all {work.length} sites<Icon name="arrow" class="size-4" /></a>
        )}
      </section>

      <!-- Club stripes between sections, drawn across on scroll (motion.ts). -->
      <div class="mt-28"><div aria-hidden="true" data-stripes class="grid gap-2"><i class="h-8 bg-fill"></i><i class="h-4 bg-navy"></i><i class="h-2 bg-pop"></i><i class="h-4 bg-navy"></i><i class="h-8 bg-fill"></i></div></div>

      <!-- The three steps as giant type with one big way to get in touch, the steps themselves beside them, the add-ons as a quiet list. -->
      <section id="services" class="scroll-mt-20 px-4 py-24 sm:px-8 sm:py-32">
        <div class="mx-auto max-w-[96rem]">
        <div class="grid gap-14 lg:grid-cols-[1fr_1.1fr]">
          <div>
            <h2 data-split class:list={[display, 'text-5xl leading-[0.95] sm:text-7xl']}>Three steps. <span class="text-muted">You only do the first one.</span></h2>
            <a href={whatsapp} target="_blank" rel="noopener" class="btn mt-12 min-h-20 w-full justify-between rounded-2xl bg-whatsapp px-7 text-xl text-[#1f2737] shadow-xl shadow-whatsapp/20 hover:shadow-whatsapp/40 sm:text-2xl">
              <span class="flex items-center gap-3"><svg viewBox="0 0 24 24" class="size-8" fill="currentColor" aria-hidden="true"><path d={waPath} /></svg>WhatsApp me</span>
              <span class="text-sm font-medium max-sm:hidden">One message, no forms</span>
            </a>
          </div>
          <div>
            <ol class="divide-y divide-line border-y border-line">
              {steps.map((s) => (
                <li class="grid grid-cols-[auto_1fr] gap-6 py-6">
                  <span aria-hidden="true" class:list={[display, 'text-5xl leading-none text-accent tabular-nums']}>{s.n}</span>
                  <div><h3 class="text-xl font-semibold">{s.title}</h3><p class="mt-1 text-pretty text-muted">{s.text}</p></div>
                </li>
              ))}
            </ol>
            <ul class="mt-10 grid gap-x-8 gap-y-4 sm:grid-cols-2">
              {extras.map((x) => (
                <li class="flex flex-wrap items-baseline justify-between gap-x-3 border-b border-line pb-3"><span class="font-semibold">{x.name}</span><span class="font-mono text-sm text-accent">{x.price}</span></li>
              ))}
            </ul>
          </div>
        </div>

        </div>
      </section>

      <!-- Add-ons and bigger jobs in one band: one demo (edit it yourself: the Payload panel publishes, the site shows it), each add-on
           in a line beside it, then what else gets built. Three full demos here read as the guts, not the result. -->
      <section id="apps" aria-labelledby="apps-title" class="navy-band scroll-mt-20 px-4 py-24 sm:px-8 sm:py-32">
        <div class="mx-auto max-w-[96rem]">
        <p class="eyebrow">Add-ons and bigger jobs</p>
        <h2 id="apps-title" data-split class:list={[display, 'mt-4 text-5xl leading-[0.95] sm:text-7xl lg:text-8xl']}>More than a website? <span class="text-accent">I build that too.</span></h2>
        <div class="mt-14 grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:items-center lg:gap-24">
          <figure class="w-full"><PublishDemo /><figcaption class="mt-3 text-sm text-muted">An example business, not a client.</figcaption></figure>
          <ul class="divide-y divide-line border-y border-line">
            {addons.map(([id, tag, title, text]) => (
              <li id={id} class="scroll-mt-24 py-6">
                <p class="eyebrow">{tag}</p>
                <h3 class="mt-2 text-2xl font-semibold">{title}</h3>
                <p class="mt-1 text-pretty text-muted">{text}</p>
              </li>
            ))}
          </ul>
        </div>
        <div class="mt-24 grid gap-6 md:grid-cols-[1fr_auto] md:items-end">
          <p class="max-w-xl text-lg text-pretty text-muted">Bookings, payments, logins, apps in the stores, or the backend behind it. <span class="text-fg">SoyMenu is a web app I built on my own. ArquerosYa, which I co-founded, is a web app plus iOS and Android apps.</span></p>
          <a href={wa('Hi Thomas, I have a bigger project in mind.')} target="_blank" rel="noopener" class="btn-ghost min-h-14 px-7 max-sm:w-full">Tell me about it<Icon name="arrow" class="size-4" /></a>
        </div>
        <ol class="mt-14 grid gap-px overflow-hidden rounded-3xl bg-line ring-1 ring-line sm:grid-cols-2 xl:grid-cols-4">
          {builds.map(([title, text, stack], i) => (
            <li data-rise class="flex flex-col bg-paper p-7 sm:p-8">
              <span aria-hidden="true" class:list={[display, 'text-5xl leading-none text-accent']}>{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-10 text-2xl font-semibold">{title}</h3>
                            <p class="mt-auto pt-8 font-mono text-xs tracking-[0.15em] text-muted uppercase">{stack}</p>
            </li>
          ))}
        </ol>
        </div>
      </section>

      <!-- Questions: all collapsed, one open at a time. -->
      <section id="faq" class="scroll-mt-20 px-4 py-24 sm:px-8 sm:py-32">
        <div class="mx-auto grid max-w-[96rem] gap-12 lg:grid-cols-[1fr_1.6fr] lg:gap-32">
          <div class="lg:sticky lg:top-24 lg:self-start">
            <h2 data-split class:list={[display, 'text-5xl leading-[0.95] sm:text-7xl']}>Good <span class="text-accent">questions.</span></h2>
            <a href="#contact" class="btn-ghost mt-8">Ask something else</a>
          </div>
          <div class="divide-y divide-line border-y border-line">
            {faqs.map(([q, a]) => (
              <details name="faq" class="faq group">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-lg font-semibold text-pretty transition-colors hover:text-accent group-open:text-accent [&::-webkit-details-marker]:hidden">
                  <span class="transition-transform duration-300 group-hover:translate-x-1.5 group-open:translate-x-1.5">{q}</span><span aria-hidden="true" class="grid size-8 shrink-0 place-items-center rounded-full text-2xl leading-none text-muted ring-1 ring-line [transition:color_.3s,background-color_.3s,box-shadow_.3s,rotate_.3s_cubic-bezier(0.34,1.56,0.64,1)] group-hover:ring-accent group-open:rotate-45 group-open:bg-fill group-open:text-on-accent group-open:ring-accent">+</span>
                </summary>
                <p class="max-w-2xl pb-6 text-pretty text-muted">{a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- The ask on the brand blue, the stripes running into it: one giant line, one person behind it, three ways in.
           WhatsApp leads (it's how trades message), email sits behind it as the quiet option. -->
      <div aria-hidden="true" data-stripes class="grid gap-2"><i class="h-2 bg-pop"></i><i class="h-4 bg-navy"></i><i class="h-3 bg-fill"></i><i class="h-6 bg-fill"></i></div>
      <section id="contact" class="accent-band relative scroll-mt-20 px-4 py-24 [--color-fill-ink:#e0e7ff] [--color-fill:#ffffff] [--color-on-accent:#1d4ed8] sm:px-8 sm:py-32">
        <h2 data-split class:list={[display, 'text-[13vw] leading-[0.9] sm:text-[11vw]']}>Yours <span class="text-navy">next.</span></h2>
        <div class="mt-12 grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
          <div class="flex items-center gap-4">
            <span class="size-20 shrink-0 overflow-hidden rounded-2xl bg-accent/10 sm:size-24"><Image src={thomasFull} alt="Thomas Beckford" width={360} class="w-[180%] max-w-none -ml-[33%]" /></span>
            <p class="max-w-md text-lg text-pretty text-muted"><span class="text-fg">I'm Thomas.</span> Tell me what you do and where. I'll come back with a fixed price. No obligation, no deposit. <span class="text-fg">Usually replies within a day.</span></p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a href={whatsapp} target="_blank" rel="noopener" class="btn min-h-14 bg-whatsapp px-7 text-[#1f2737] shadow-xl shadow-navy/25 hover:scale-[1.03] max-sm:w-full"><svg viewBox="0 0 24 24" class="size-6" fill="currentColor" aria-hidden="true"><path d={waPath} /></svg>WhatsApp me</a>
            <a href={mailto} class="btn-ghost min-h-14 px-7 max-sm:w-full">Or email for a quote<Icon name="arrow" class="size-4" /></a>
            <p class="w-full text-sm font-medium text-balance text-fg">No deposit · Pay when you’re happy · Domain in your name</p>
          </div>
        </div>
        <p class="mt-8 text-muted">
          Or call <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="inline-block py-1 font-semibold text-fg underline-offset-4 hover:underline">{site.phone}</a>.
        </p>
      </section>
    </main>

    <footer class="px-4 pt-14 text-sm text-muted sm:px-8">
      <div class="flex flex-wrap justify-between gap-10">
        <div>
          <Logo class="text-4xl" />
          <p class="mt-4 max-w-xs text-pretty">Websites for local businesses, built and looked after. London, UK.</p>
          <a href={`mailto:${site.email}`} class="mt-4 inline-block py-2 font-semibold text-fg underline-offset-4 hover:underline">{site.email}</a>
        </div>
        <nav aria-label="Footer" class="flex gap-12">
          <div class="flex flex-col items-start">
            {[['#sites', 'Examples'], ['#services', 'Services'], ['#faq', 'Questions'], ['#contact', 'Contact']].map(([h, t]) => <a href={h} class="py-1.5 transition hover:text-fg">{t}</a>)}
          </div>
          <div class="flex flex-col items-start">
            <a href="/cv" class="py-1.5 transition hover:text-fg">CV</a>
            <a href={site.linkedin} target="_blank" rel="noopener" class="py-1.5 transition hover:text-fg">LinkedIn</a>
            <a href={site.github} target="_blank" rel="noopener" class="py-1.5 transition hover:text-fg">GitHub</a>
            <a href="/privacy" class="py-1.5 transition hover:text-fg">Privacy</a>
          </div>
        </nav>
      </div>
      <p aria-hidden="true" class:list={[display, 'mt-14 text-center text-[clamp(1.5rem,10.5vw,9.5rem)] leading-[0.9] whitespace-nowrap text-fg/[0.06] select-none']}>Thomas Beckford</p>
      <p class="border-t border-line py-5 text-center text-xs">© {new Date().getFullYear()} {site.name} · London, UK</p>
    </footer>
  </div>

  <!-- Site preview: the example opens over the page instead of leaving it. -->
  <dialog id="preview" data-lenis-prevent aria-labelledby="preview-title" class="m-auto size-full max-h-none max-w-none bg-transparent p-0 backdrop:bg-black/80 backdrop:backdrop-blur-sm sm:h-[min(78dvh,760px)] sm:w-[min(1100px,calc(100vw-4rem))]">
    <div class="flex size-full flex-col overflow-hidden bg-fill text-on-accent sm:rounded-[1.75rem] sm:p-2 sm:pt-0 sm:shadow-[0_0_90px_-20px] sm:shadow-accent/50">
      <div class="flex items-center justify-between gap-3 py-2 pr-1 pl-4 text-sm sm:pl-3">
        <p id="preview-title" data-preview-title class="min-w-0 font-semibold text-ellipsis whitespace-nowrap overflow-hidden"></p>
        <div class="flex shrink-0 items-center gap-1">
          <a data-preview-open target="_blank" rel="noopener" class="rounded-full px-3 py-2 font-semibold opacity-70 transition hover:opacity-100">New tab ↗</a>
          <button type="button" data-preview-close autofocus aria-label="Close preview" class="grid size-10 place-items-center rounded-full bg-on-accent text-2xl leading-none text-accent transition hover:scale-105">×</button>
        </div>
      </div>
      <iframe data-preview-frame title="Site preview" class="min-h-0 flex-1 bg-white sm:rounded-[1.25rem]"></iframe>
    </div>
  </dialog>

</BaseLayout>

<script>
  import '@/scripts/motion'

  // The WhatsApp button bows out from the contact section, where it points, to the end of the page, and while the
  // hero's "Open it as a whole site" is on screen (it sat right on top of it).
  const fab = document.getElementById('wa-fab')!
  const hidden = new Set<Element>()
  const io = new IntersectionObserver((es) => {
    es.forEach((e) => (e.isIntersecting || (e.target.id === 'contact' && e.boundingClientRect.top < 0) ? hidden.add(e.target) : hidden.delete(e.target)))
    const off = hidden.size > 0
    fab.toggleAttribute('data-off', off)
    fab.inert = off
  })
  io.observe(document.getElementById('contact')!)
  io.observe(document.querySelector('[data-sb-open]')!)

  // Example sites open in the preview modal; modified clicks (new tab, etc.) still go straight there.
  const preview = document.getElementById('preview') as HTMLDialogElement
  const frame = preview.querySelector<HTMLIFrameElement>('[data-preview-frame]')!
  let opener: HTMLElement | null = null
  document.querySelectorAll<HTMLAnchorElement>('a[data-preview]').forEach((a) =>
    a.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button) return
      e.preventDefault()
      opener = a
      frame.src = a.href
      frame.title = a.dataset.preview!
      preview.querySelector('[data-preview-title]')!.textContent = a.dataset.preview!
      preview.querySelector<HTMLAnchorElement>('[data-preview-open]')!.href = a.href
      preview.showModal()
    }),
  )
  preview.querySelector('[data-preview-close]')!.addEventListener('click', () => preview.close())
  preview.addEventListener('click', (e) => e.target === preview && preview.close())
  preview.addEventListener('close', () => {
    frame.src = 'about:blank'
    opener?.focus({ preventScroll: true })
  })
  // Esc inside a same-origin example still closes (a cross-origin page keeps its keys to itself).
  frame.addEventListener('load', () => {
    try { frame.contentWindow!.addEventListener('keydown', (e) => e.key === 'Escape' && preview.close()) } catch {}
  })
  // An example's "Get one like this" jumps this page to #contact: close the preview on the way.
  addEventListener('hashchange', () => preview.close())
</script>
