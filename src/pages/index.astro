          <div class="reveal mt-8"><button type="button" data-boti-open class="btn-ghost">Ask something else</button></div>
        </div>
        <!-- First five on show; the rest behind one tap (CSS only, the checkbox flips them). -->
        <div class="group/faq space-y-4">
          {
            faqs.map(([q, a], i) => (
              <details name="faq" class:list={['reveal group', i >= 5 && 'hidden group-has-checked/faq:block']} style={`--d:${(i % 5) * 70}ms`}>
                <summary class="ml-auto flex w-fit max-w-[92%] cursor-pointer list-none items-center gap-3 rounded-[16px_4px_16px_16px] bg-white/[0.04] px-4 py-3 text-left font-semibold text-pretty ring-1 ring-line transition duration-200 hover:-translate-y-0.5 hover:ring-accent/50 group-open:bg-accent group-open:text-on-accent group-open:ring-accent [&::-webkit-details-marker]:hidden">
                  {q}
                  <span aria-hidden="true" class="text-lg leading-none text-muted transition group-open:rotate-45 group-open:text-on-accent">+</span>
                </summary>
                <div class="faq-answer mt-3 flex items-end gap-2">
                  <Boti mood="mini" class="w-8 shrink-0" />
                  <div class="relative max-w-[85%] rounded-[4px_16px_16px_16px] bg-night px-4 py-3 text-pretty text-fg/90 ring-1 ring-line">
                    <span class="faq-typing absolute inset-0 flex items-center gap-1 px-4" aria-hidden="true">
                      <span class="size-1.5 animate-bounce rounded-full bg-fg/70"></span>
                      <span class="size-1.5 animate-bounce rounded-full bg-fg/70 [animation-delay:.15s]"></span>
                      <span class="size-1.5 animate-bounce rounded-full bg-fg/70 [animation-delay:.3s]"></span>
                    </span>
                    <p class="faq-text">{a}</p>
                  </div>
                </div>
              </details>
            ))
          }
          <label class="ml-auto flex min-h-11 w-fit cursor-pointer items-center gap-2 rounded-xl px-3 text-sm font-semibold text-accent-ink group-has-checked/faq:hidden has-focus-visible:outline-2 has-focus-visible:outline-accent">
            <input id="faq-more" type="checkbox" class="sr-only" />{faqs.length - 5} more questions<Icon name="arrow" class="size-4 rotate-90" />
          </label>
        </div>
      </div>
      <!-- The bit, now a footnote to the questions: this site sets no cookies, so there's no banner, just Boti.
           "Ask Boti" opens the quote chat. -->
      <div class="reveal mx-auto mt-20 flex max-w-6xl flex-wrap items-center justify-between gap-6 px-4 sm:px-6 lg:px-8">
        <div>
          <p class="text-xl font-semibold tracking-tight">No tracking cookies. <span class="mark">Just a robot.</span></p>
          <p class="mt-2 max-w-lg text-sm text-pretty text-muted">Visits are counted without cookies, no ads follow you round the internet, and there's no cookie banner because there's nothing to ask about. Just a robot who knows Thomas's prices.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <button type="button" data-boti-open class="btn-primary">Ask Boti</button>
          <a href="/privacy" class="btn-ghost">Privacy notice</a>
        </div>
      </div>
    </section>

    <!-- Closing CTA: big left-aligned line, one person behind it, two ways in. -->
    <section id="contact" class="relative isolate overflow-hidden border-t border-line py-24 sm:py-36">
      <div aria-hidden="true" class="glow absolute -right-40 -bottom-60 -z-10 size-[44rem]"></div>
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-[1.4fr_1fr] lg:gap-20 lg:px-8">
        <h2 class="display text-[3rem] leading-[0.95] text-balance sm:text-7xl lg:text-[5.5rem]">
          {["Let's", 'get', 'your', 'phone'].map((w, i) => <><span class="word-in" style={`--i:${i}`}>{w}</span>{' '}</>)}<span class="word-in" style="--i:4"><span class="mark">ringing.</span></span>
        </h2>
        <!-- A note from one person, not a form: who you'll talk to, what happens next, two ways in. -->
        <div class="card reveal p-6 backdrop-blur-xl [--d:90ms] sm:p-8">
          <div class="flex items-center gap-4">
            <!-- Head and shoulders: the shirt anchors the bottom edge, so it no longer reads as a floating head. -->
            <span class="size-14 shrink-0 overflow-hidden rounded-2xl bg-accent/10"><Image src={thomasFull} alt="" width={240} class="w-[180%] max-w-none -ml-[33%]" /></span>
            <div>
              <p class="font-semibold">{site.name}</p>
              <p class="text-sm text-muted">Usually replies within a day</p>
            </div>
          </div>
          <p class="mt-6 text-pretty text-muted">Tell me what you do and where. I'll come back with a fixed price. No obligation, no deposit.</p>
          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            <a href={whatsapp} target="_blank" rel="noopener" class="btn-whatsapp min-h-14">WhatsApp me<Icon name="arrow" class="size-4" /></a>
            <a href={mailto} class="btn-ghost min-h-14">Get a free quote</a>
          </div>
          <p class="mt-5 border-t border-line pt-5 text-sm text-muted">
            Or call <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="inline-block py-1 font-semibold text-fg underline-offset-4 hover:underline">{site.phone}</a> or{' '}
            <button type="button" data-boti-open="Get me a price" class="inline-block py-1 font-semibold text-fg underline-offset-4 hover:underline">get a price from Boti</button>
          </p>
          <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-accent/10 px-3.5 py-1.5 text-sm font-semibold text-accent-ink">Christmas offer · £{christmasOffer.price}</p>
        </div>
      </div>
    </section>
  </main>

  <!-- Big name as the sign-off, then the paths people actually need: sections, contact, legal. -->
  <footer class="relative overflow-clip border-t border-line pt-16 text-sm text-muted">
    <div class="mx-auto grid max-w-6xl grid-cols-2 gap-10 px-4 sm:grid-cols-[1fr_auto_auto] sm:gap-16 sm:px-6 lg:px-8">
      <div class="col-span-2 sm:col-span-1">
        <Logo class="size-10" />
        <p class="mt-4 max-w-xs text-pretty">Websites for local businesses, built and looked after. London, UK.</p>
        <a href={`mailto:${site.email}`} class="mt-4 inline-block py-2 font-semibold text-fg underline-offset-4 hover:underline">{site.email}</a>
      </div>
      <nav aria-label="Footer" class="flex flex-col items-start">
        {[['#services', 'Services'], ['#work', 'Work'], ['#about', 'About'], ['#faq', 'Questions'], ['#contact', 'Contact']].map(([h, t]) => <a href={h} class="py-1.5 transition hover:text-fg">{t}</a>)}
      </nav>
      <div class="flex flex-col items-start">
        <a href={site.linkedin} target="_blank" rel="noopener" class="py-1.5 transition hover:text-fg">LinkedIn</a>
        <a href={site.github} target="_blank" rel="noopener" class="py-1.5 transition hover:text-fg">GitHub</a>
        <a href="/privacy" class="py-1.5 transition hover:text-fg">Privacy</a>
      </div>
    </div>
    <p aria-hidden="true" class="display mt-14 text-center text-[clamp(2.25rem,11vw,10rem)] leading-[0.78] whitespace-nowrap text-fg/[0.06] select-none">Thomas Beckford</p>
    <p class="border-t border-line py-5 text-center text-xs">© {new Date().getFullYear()} {site.name} · London, UK</p>
  </footer>

  <BotiChat trades={trades.filter((t) => !t.pick).map((t) => t.name)} />
</BaseLayout>

<style>
  #grid-bg {
    --line: color-mix(in oklab, var(--color-fg) 6%, transparent);
    background: linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 48px 48px, linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 48px 48px;
    mask-image: radial-gradient(ellipse 90% 70% at 50% 0%, #000 20%, transparent 100%);
  }
  :global([data-split]) #hero-title {
    visibility: hidden;
    animation: unhide 0s 2.5s forwards;
  }
  @keyframes unhide {
    to {
      visibility: visible;
    }
  }
  :global(.cursor-ring) {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 70;
    pointer-events: none;
    border-radius: 9999px;
    transition: opacity 0.2s, scale 0.3s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.3s;
    width: 36px;
    height: 36px;
    margin: -18px 0 0 -18px;
    border: 1.5px solid var(--color-accent);
    box-shadow: 0 0 18px color-mix(in oklab, var(--color-accent) 40%, transparent);
  }
  :global(.cursor-ring[data-hot]) {
    scale: 1.8;
    background: color-mix(in oklab, var(--color-accent) 14%, transparent);
  }
  :global(html[data-cursor-out] .cursor-ring),
  :global(html:has(dialog[open]) .cursor-ring) {
    opacity: 0;
  }
  /* A terminal caret after Boti's line. */
  .quip::after {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 0.25em;
    vertical-align: -0.15em;
    background: var(--color-accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .quip::after {
      animation: caret 1s steps(1) infinite;
    }
  }
  @keyframes caret {
    50% {
      opacity: 0;
    }
  }
</style>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { SplitText } from 'gsap/SplitText'
  gsap.registerPlugin(ScrollTrigger, SplitText)

  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches

  // Reveal in and out: hidden while off screen (only things that start below the fold, so nothing blinks on load and no-JS shows everything).
  if (!reducedMotion) {
    const pending = [...document.querySelectorAll<HTMLElement>('.reveal')].filter((el) => el.getBoundingClientRect().top > innerHeight)
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) e.target.toggleAttribute('data-pending', !e.isIntersecting)
      },
      { rootMargin: '-6% 0px -10% 0px' },
    )
    for (const el of pending) {
      el.setAttribute('data-pending', '')
      io.observe(el)
    }
  }

  // Boti reacts: a short run of faces, then back to hello.
  const reacting = new WeakMap<HTMLElement, number[]>()
  const react = (el: HTMLElement, steps: [string, number][]) => {
    reacting.get(el)?.forEach(clearTimeout) // a new reaction replaces one still running
    const timers: number[] = []
    reacting.set(el, timers)
    let t = 0
    for (const [m, ms] of [...steps, ['hello', 0] as [string, number]]) {
      timers.push(window.setTimeout(() => {
        el.dataset.mood = m
        el.classList.remove('mascot-pop')
        void el.getBoundingClientRect()
        el.classList.add('mascot-pop')
      }, t))
      t += ms
    }
  }

  // Try it: mirror the form into the phone site, the page accent and the quote email.
  const tryForm = document.getElementById('try-form') as HTMLFormElement
  const trySite = document.getElementById('try-site')!
  const tryCta = document.getElementById('try-cta') as HTMLAnchorElement
  const ticks = document.querySelectorAll<HTMLElement>('[data-tick]')
  const trades = JSON.parse(tryForm.dataset.trades!) as { name: string; style: string; neon: string; quip: string; demo: string; head: string; lede: string; cta: string }[]
  const set = (k: string, v: string) => trySite.querySelectorAll(`[data-k="${k}"]`).forEach((el) => (el.textContent = v))
  const render = () => {
    const f = new FormData(tryForm)
    const val = (k: string) => String(f.get(k) ?? '').trim() || (tryForm.elements.namedItem(k) as HTMLInputElement).placeholder
    const i = Number(f.get('trade'))
    const t = trades[i]
    const nameInput = tryForm.elements.namedItem('name') as HTMLInputElement
    nameInput.placeholder = t.demo
    const name = val('name')
    const area = val('area')
    trySite.querySelectorAll<HTMLElement>('[data-trade]').forEach((el) => (el.hidden = el.dataset.trade !== f.get('trade')))
    set('name', name)
    set('area', area)
    set('trade', t.name)
    set('head', t.head)
    set('cta', t.cta)
    set('lede', t.lede.replace('{area}', area))
    // The whole page takes the trade's colour.
    document.documentElement.style.setProperty('--color-accent', t.neon)
    ticks.forEach((el, n) => el.toggleAttribute('data-on', n === i))
    // The email carries only what the visitor typed, never the demo placeholders.
    const typed = (k: string) => String(f.get(k) ?? '').trim()
    const redo = picked && t.style === 'redo'
    const body = [redo ? `Hi Thomas, my website's old and I'd like it rebuilt.` : `Hi Thomas, I'd like a website like the one I just made on your page.`, '', picked && !redo ? `Trade: ${t.name}` : null, typed('name') ? `Business: ${typed('name')}` : null, typed('area') ? `Area: ${typed('area')}` : null].filter((l) => l !== null).join('\n')
    tryCta.href = `mailto:${tryCta.href.slice(7).split('?')[0]}?subject=${encodeURIComponent(`${redo ? 'Website redesign' : 'Website'}${typed('name') ? ` for ${typed('name')}` : ' quote'}`)}&body=${encodeURIComponent(body)}`
  }
  // Boti's running commentary. ponytail: textContent only, the visitor's text never becomes HTML.
  const tryBot = document.getElementById('try-bot')!
  const tryCheer = () => react(tryBot, [['done', 1400]])
  const quip = document.getElementById('try-quip')!
  let quipTimer = 0
  tryForm.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement
    clearTimeout(quipTimer)
    quipTimer = window.setTimeout(() => {
      const v = el.value.trim()
      if (el.name === 'trade') quip.textContent = trades[Number(el.value)].quip
      else if (!v) return
      else quip.textContent = el.name === 'name' ? `${v}? I’d ring them.` : `${v}! Lovely round there.`
      quip.classList.remove('bubble-in')
      void quip.offsetWidth
      quip.classList.add('bubble-in')
      tryCheer()
    }, el.name === 'trade' ? 0 : 600)
  })
  // Only a trade the visitor chose goes in the email, not one the slideshow or the scroll landed on. Programmatic .checked fires no input event.
  // Registered before render so the click that picks a trade already counts.
  let picked = false
  tryForm.addEventListener('input', (e) => {
    if ((e.target as HTMLInputElement).name === 'trade') picked = true
  })
  tryForm.addEventListener('input', render)
  const radios = [...tryForm.querySelectorAll<HTMLInputElement>('input[name=trade]')]
  const show = (i: number) => {
    if (radios[i].checked) return
    radios[i].checked = true
    render()
  }
  // Browser may restore typed values on back/reload; only then resync, so the default mailto stays generic.
  // A restored radio may be one the slideshow landed on, so it never counts as picked.
  const restored = !!((tryForm.elements.namedItem('name') as HTMLInputElement).value || (tryForm.elements.namedItem('area') as HTMLInputElement).value)
  if (restored || !radios[0].checked) render()
  // Until the visitor picks a trade, the page cycles through the trades' colours on its own while the try-it section is on screen
  // (moving content off-screen with no pause control fails WCAG 2.2.2). It hands over to the scroll while the desktop hero
  // is pinned, rests in background tabs, and stops for good once they touch the form or open Boti's chat.
  let cycle = 0
  let scrubbing = false
  let heroOn = true
  if (!restored && !reducedMotion) {
    new IntersectionObserver(([e]) => (heroOn = e.isIntersecting)).observe(document.getElementById('try')!)
    cycle = window.setInterval(() => {
      if (document.hidden || scrubbing || !heroOn) return
      show((radios.findIndex((r) => r.checked) + 1) % radios.length)
    }, 3200)
    const stop = () => clearInterval(cycle)
    for (const ev of ['pointerdown', 'focusin']) tryForm.addEventListener(ev, stop, { once: true })
    for (const b of document.querySelectorAll('[data-boti-open]')) b.addEventListener('click', stop)
  }
  tryForm.addEventListener('submit', (e) => e.preventDefault())

  // Motion, desktop: the headline rises in by line, the try-it section pins while the phone turns through the trades.
  // gsap.matchMedia reverts all of it when the query stops matching. Reduced motion gets none of it.
  const mm = gsap.matchMedia()
  mm.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
    const title = document.getElementById('hero-title')!
    let played = false
    SplitText.create(title, {
      type: 'lines,words',
      mask: 'lines',
      autoSplit: true,
      onSplit: (self) => {
        gsap.set(title, { visibility: 'visible' })
        if (played) return
        played = true
        return gsap.from(self.words, { yPercent: 110, duration: 1, ease: 'expo.out', stagger: 0.05, delay: 0.1 })
      },
    })

    gsap.fromTo('#spin', { rotateY: -14, rotateX: 4 }, {
      rotateY: 18,
      rotateX: -6,
      scale: 1.06,
      ease: 'none',
      scrollTrigger: {
        trigger: '#try',
        start: 'top top',
        end: '+=180%',
        pin: true,
        scrub: 0.6,
        onToggle: (s) => (scrubbing = s.isActive),
        onUpdate: (s) => {
          if (picked || s.progress < 0.02) return
          show(Math.min(radios.length - 1, Math.floor(s.progress * radios.length)))
        },
      },
    })

    // The giant trade word slides across behind the phone as the hero scrolls.

    // Section titles rise in word by word as they reach the viewport.
    const heads = gsap.utils.toArray<HTMLElement>('main section:not(#hero) .h2')
    const splits = heads.map((h) =>
      SplitText.create(h, {
        type: 'words',
        mask: 'words',
        onSplit: (self) => gsap.from(self.words, { yPercent: 105, duration: 0.9, ease: 'expo.out', stagger: 0.04, scrollTrigger: { trigger: h, start: 'top 85%', once: true } }),
      }),
    )
    // Work phones rise up and straighten out as they scroll in.
    gsap.utils.toArray<HTMLElement>('.work-phone').forEach((ph, i) => {
      gsap.fromTo(ph, { yPercent: 35, rotateZ: i % 2 ? 8 : -8 }, { yPercent: 0, rotateZ: 0, ease: 'none', scrollTrigger: { trigger: ph.closest('a'), start: 'top bottom', end: 'top 40%', scrub: 0.8 } })
    })

    return () => {
      splits.forEach((x) => x.revert())
    }
  })
  // Phones: no scroll-jacking, just one turn of the phone as it lands.
  mm.add('(max-width: 1023px) and (prefers-reduced-motion: no-preference)', () => {
    gsap.from('#spin', { rotateY: -40, duration: 1.6, ease: 'expo.out', scrollTrigger: { trigger: '#spin', start: 'top 80%', once: true } })
  })

  // Nav turns into a floating capsule once the page scrolls. Created after the pins so positions account for them.
  const nav = document.getElementById('nav')!
  ScrollTrigger.create({ start: 40, end: 'max', onToggle: (s) => nav.toggleAttribute('data-scrolled', s.isActive) })
  // The quote badge bows out once the contact section, where it points, is on screen.
  // Hidden (scaled away at contact, or still docked out near the top) = out of tab order and screen readers too.
  const badge = document.getElementById('badge')!
  const fab = document.getElementById('wa-fab')!
  const docks = CSS.supports('animation-timeline: scroll()') && !reducedMotion
  let atContact = false
  let docked = !docks
  const syncDock = () => {
    badge.toggleAttribute('data-off', atContact)
    fab.toggleAttribute('data-off', atContact)
    badge.inert = fab.inert = atContact || !docked
  }
  ScrollTrigger.create({ trigger: '#contact', start: 'top 80%', end: 'max', onToggle: (s) => ((atContact = s.isActive), syncDock()) })
  if (docks) ScrollTrigger.create({ start: 200, end: 'max', onToggle: (s) => ((docked = s.isActive), syncDock()) })
  syncDock()

  // Boti answers the questions.
  const faqBot = document.getElementById('faq-bot')!
  document.querySelectorAll('#faq details').forEach((d) =>
    d.addEventListener('toggle', () => (d as HTMLDetailsElement).open && react(faqBot, [['thinking', 550], ['done', 1600]])),
  )
  // The label hides once checked, taking focus with it: hand focus to the first question it revealed.
  const faqMore = document.getElementById('faq-more') as HTMLInputElement
  faqMore.addEventListener('change', () => faqMore.checked && document.querySelectorAll<HTMLElement>('#faq summary')[5]?.focus())

  // Proof strip: count up from 0 once each number scrolls into view, once.
  const counters = document.querySelectorAll<HTMLElement>('[data-count]')
  const animateCount = (el: HTMLElement) => {
    const target = Number(el.dataset.count)
    const suffix = el.dataset.suffix ?? ''
    if (reducedMotion) {
      el.textContent = target.toLocaleString('en-GB') + suffix
      return
    }
    const start = performance.now()
    const dur = 1100
    const tick = (now: number) => {
      const p = Math.min(1, (now - start) / dur)
      el.textContent = Math.round(target * (1 - (1 - p) ** 3)).toLocaleString('en-GB') + suffix
      if (p < 1) requestAnimationFrame(tick)
    }
    requestAnimationFrame(tick)
  }
  const countIo = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue
      animateCount(e.target as HTMLElement)
      countIo.unobserve(e.target)
    }
  }, { threshold: 0.6 })
  counters.forEach((el) => countIo.observe(el))

  // Hero phone tilts toward the pointer; cards get a glow that follows it. Skipped for reduced motion and touch.
  if (matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
    const tilt = document.getElementById('tilt')!
    document.getElementById('try')!.addEventListener('pointermove', (e) => {
      tilt.style.setProperty('--ry', `${(e.clientX / innerWidth - 0.5) * 14 - 8}deg`)
      tilt.style.setProperty('--rx', `${4 - (e.clientY / innerHeight - 0.5) * 8}deg`)
    })
    // Cursor: the native pointer stays (a drawn one always runs a frame behind the hardware one, which feels sluggish);
    // a ring in the accent follows it closely and swells over anything clickable. Hidden while Boti's chat is open.
    const ring = Object.assign(document.createElement('div'), { className: 'cursor-ring' })
    document.body.append(ring)
    document.documentElement.toggleAttribute('data-cursor-out', true)
    const ringX = gsap.quickTo(ring, 'x', { duration: 0.15, ease: 'power2' })
    const ringY = gsap.quickTo(ring, 'y', { duration: 0.15, ease: 'power2' })
    addEventListener('pointermove', (e) => {
      ringX(e.clientX)
      ringY(e.clientY)
      ring.toggleAttribute('data-hot', !!(e.target as Element).closest('a, button, label, summary'))
      document.documentElement.toggleAttribute('data-cursor-out', false)
    }, { passive: true })
    document.addEventListener('mouseout', (e) => !e.relatedTarget && document.documentElement.toggleAttribute('data-cursor-out', true))
    // Main buttons lean toward the pointer, then spring back.
    document.querySelectorAll<HTMLElement>('main .btn-primary, main .btn-whatsapp').forEach((btn) => {
      const x = gsap.quickTo(btn, 'x', { duration: 0.5, ease: 'power3' })
      const y = gsap.quickTo(btn, 'y', { duration: 0.5, ease: 'power3' })
      btn.addEventListener('pointermove', (e) => {
        const r = btn.getBoundingClientRect()
        x((e.clientX - r.left - r.width / 2) * 0.3)
        y((e.clientY - r.top - r.height / 2) * 0.4)
      })
      btn.addEventListener('pointerleave', () => (x(0), y(0)))
    })
    document.addEventListener('pointermove', (e) => {
      const el = (e.target as Element).closest<HTMLElement>('.spot')
      if (!el) return
      const r = el.getBoundingClientRect()
      el.style.setProperty('--x', `${e.clientX - r.left}px`)
      el.style.setProperty('--y', `${e.clientY - r.top}px`)
    })
  }
  // The hero robot: its own small chunk, loaded after the page. It watches the pointer across the whole hero. No WebGL: the stage stays empty.
  const robot = document.getElementById('robot-stage')!
  import('@/scripts/robot').then((m) => m.mount(robot, reducedMotion, document.getElementById('hero')!)).catch(() => robot.replaceChildren())
</script>
