            </div>
          </div>
        </div>

        <!-- CV as a terminal-ish card: closed it previews the stack, open it's a timeline. -->
        <details class="glass group reveal mt-20 overflow-hidden rounded-3xl ring-1 ring-line">
          <summary class="flex cursor-pointer list-none flex-wrap items-center justify-between gap-6 p-6 sm:p-10 [&::-webkit-details-marker]:hidden">
            <span class="min-w-0">
              <span class="font-mono text-xs tracking-[0.2em] text-muted uppercase">For recruiters &amp; tech leads</span>
