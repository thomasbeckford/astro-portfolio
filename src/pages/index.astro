        </details>
      </div>
    </section>

    <!-- Questions as a chat: you tap a question, Boti types and answers. One open at a time (details name). -->
    <section id="faq" class="border-t border-line py-24 sm:py-32">
      <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 md:grid-cols-[300px_1fr] md:gap-20 lg:px-8">
        <div class="md:sticky md:top-28 md:self-start">
