---
import { Image } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Logo from '@/components/Logo.astro'
import Icon from '@/components/Icon.astro'
import Phone from '@/components/Phone.astro'
import Boti from '@/components/Boti.astro'
import BotiChat from '@/components/BotiChat.astro'
import { site, services, faqs, christmasOffer, steps, whatsapp as wa } from '@/site'
import thomas from '@/assets/thombeck-pro.png'
import thomasFull from '@/assets/thombeck.png'
import arquerosya from '@/assets/work/arquerosya.png'
import josefina from '@/assets/work/josefina.png'
import soymenu from '@/assets/work/soymenu.png'
import soyreserva from '@/assets/work/soyreserva.png'
import soygestion from '@/assets/work/soygestion.png'
import CV from '@/components/CV.astro'
import TradeSite from '@/components/TradeSite.astro'
import { trades } from '@/trades'
import '@fontsource-variable/unbounded'

// Proof strip: real numbers already stated elsewhere on the page, just made bigger. No invented quotes.
const stats = [
  { count: null, text: site.years, label: 'Years shipping production code' },
  { count: 100, suffix: '+', label: 'Restaurants using software I built, since 2019' },
  { count: 10900, suffix: '+', label: 'People signed up to an app I built and run' },
]

const mailto = `mailto:${site.email}?subject=${encodeURIComponent('Website quote')}`
const whatsapp = wa("Hi Thomas, I'd like a website quote.")

// Plain promises that remove the reasons people don't get in touch. All already true elsewhere on the page.
const promises = ['See it before you pay', 'No deposit', 'Domain in your name']


const brands = ['Five Iron Golf', 'Lane7', 'Sixes', 'Lévy Gorvy']

const work = [
  { name: 'Estancia La Josefina', sticker: 'Live', tag: 'Client website', url: 'https://www.estancialajosefina.com/en', img: josefina, text: 'A lodge in Patagonia. One page, two languages, photos front and centre and an enquiry button always in reach.' },
  { name: 'ArquerosYa', sticker: 'From scratch', tag: 'My own business · Argentina', url: 'https://arquerosya.com.ar/', img: arquerosya, text: 'A marketplace for hiring goalkeepers, built from scratch: web app, iOS and Android apps, and the API behind them. 10,900+ goalkeepers signed up.' },
  { name: 'SoyMenu', sticker: 'Since 2019', tag: 'My own business · Argentina', url: 'https://soymenu.com.ar/', img: soymenu, text: 'QR menus for 100+ restaurants, live since 2019. Owners change prices from their phone in seconds.' },
  { name: 'SoyReserva', tag: 'My own business · Argentina', url: 'https://soyreserva.com.ar/', img: soyreserva, text: 'Online table bookings for restaurants: tables, guests and no-shows in one place.' },
  { name: 'SoyGestión', tag: 'My own business · Argentina', url: 'https://soygestion.com.ar/', img: soygestion, text: 'Sales, costs and cash flow for restaurant owners, instead of spreadsheets.' },
]

// One scroll-linked strip of who it's for. The page's only marquee.
const marquee = ['Roofers', 'Electricians', 'Cafés', 'Salons', 'Plumbers', 'Gardeners', 'Builders', 'Restaurants']

---

<BaseLayout
  dark
  schema={[{ '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }]}
  title={`Websites for UK tradespeople, from £${site.priceFrom} | ${site.name}`}
  description={`Websites for tradespeople and small businesses across the UK, built by ${site.name}, a London developer. From £${site.priceFrom}, free hosting, no deposit: you pay once you're happy. Edit it yourself or let me look after it.`}
>
  <!-- Desktop with motion: hold the headline back until SplitText has cut it, so it never flashes whole first.
       The <style> below unhides it after 2.5s no matter what, so a failed script can't leave it blank. -->
  <script is:inline>
    if (matchMedia('(min-width: 1024px) and (prefers-reduced-motion: no-preference)').matches) document.documentElement.setAttribute('data-split', '')
  </script>

  <!-- Full-width and transparent at the top; shrinks into a floating glass capsule once you scroll (same gesture as SoyMenu). -->
  <header id="nav" class="group fixed inset-x-0 top-0 z-40 px-0 pt-0 transition-[padding] duration-300 ease-out data-scrolled:px-3 data-scrolled:pt-3">
    <div class="mx-auto flex h-16 max-w-[120rem] items-center justify-between border border-transparent pr-2 pl-4 transition-[max-width,border-radius,background-color,border-color,box-shadow] duration-300 ease-out group-data-scrolled:max-w-6xl group-data-scrolled:rounded-full group-data-scrolled:border-line group-data-scrolled:bg-paper/70 group-data-scrolled:shadow-xl group-data-scrolled:shadow-black/40 group-data-scrolled:backdrop-blur-xl group-data-scrolled:backdrop-saturate-150 sm:h-20 sm:pr-2.5 sm:pl-7">
      <a href="/" class="flex items-center gap-3">
        <Logo class="size-9 sm:size-11" />
        <span class="display text-[15px] whitespace-nowrap sm:text-lg max-[420px]:sr-only">Thomas Beckford</span>
      </a>
      <nav class="flex items-center gap-2 font-mono sm:gap-3 md:gap-8 text-[13px] tracking-[0.12em] text-muted uppercase">
        <a href="#services" class="hidden transition hover:text-fg md:inline"><span class="text-accent">01</span> Services</a>
        <a href="#work" class="hidden transition hover:text-fg md:inline"><span class="text-accent">02</span> Work</a>
        <a href="#about" class="hidden transition hover:text-fg md:inline"><span class="text-accent">03</span> About</a>
        <button type="button" data-boti-open aria-label="Ask Boti, the quote helper" class="flex h-12 items-center gap-2.5 rounded-xl bg-white/[0.05] p-1.5 font-sans text-[15px] font-semibold tracking-normal text-fg normal-case ring-1 ring-line transition hover:-rotate-2 hover:ring-fg/25 sm:pr-3.5">
          <Boti mood="mini" class="w-9" />
          <span class="hidden pr-1 sm:inline">Ask Boti</span>
        </button>
        <a href="#contact" class="btn-primary min-h-12 md:-ml-5 px-5 font-sans text-[15px] tracking-normal normal-case max-sm:px-4 max-sm:text-sm">Get a quote</a>
      </nav>
    </div>
  </header>

  <!-- Scroll badge: circular text spins as you scroll, the ring fills with page progress. Doubles as the quote button. -->
  <a id="badge" href="#contact" aria-label="Get a quote" class="group dock-in hidden transition-[scale] duration-300 data-off:scale-0 fixed right-6 bottom-6 z-30 size-24 xl:size-32 place-items-center rounded-full bg-paper/80 shadow-xl shadow-black/50 ring-1 ring-line backdrop-blur-xl sm:grid">
    <svg viewBox="0 0 100 100" aria-hidden="true" class="absolute inset-0 size-full -rotate-90">
      <circle cx="50" cy="50" r="48" pathLength="1" class="fill-none stroke-fg/10 stroke-[1.5]" />
      <circle cx="50" cy="50" r="48" pathLength="1" class="progress-scroll fill-none stroke-accent stroke-[1.5] [stroke-dasharray:1] [stroke-linecap:round]" />
    </svg>
    <svg viewBox="0 0 100 100" aria-hidden="true" class="spin-scroll absolute inset-0 size-full">
      <path id="badge-circle" d="M50,50 m-37,0 a37,37 0 1,1 74,0 a37,37 0 1,1 -74,0" fill="none" />
      <text class="fill-fg font-mono text-[10px] font-extrabold uppercase"><textPath href="#badge-circle" textLength="230" lengthAdjust="spacing">Get a quote ✦ Get a quote ✦</textPath></text>
    </svg>
    <span class="grid size-10 place-items-center rounded-full bg-accent text-on-accent shadow-md shadow-accent/30 transition duration-300 group-hover:scale-110 group-hover:rotate-45 sm:size-12">
      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
    </span>
  </a>

  <!-- Phones get a WhatsApp button instead of the desktop badge; hides with it once the contact section is on screen. -->
  <a id="wa-fab" href={whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp Thomas" class="dock-in fixed right-4 bottom-[calc(1rem+env(safe-area-inset-bottom,0px))] z-30 grid size-14 place-items-center rounded-full bg-whatsapp text-[#1f2737] shadow-xl shadow-black/50 transition-[scale] duration-300 data-off:scale-0 sm:hidden">
    <svg viewBox="0 0 24 24" class="size-7" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.4-.2Z"/></svg>
  </a>

  <!-- Grid: faint squares fixed behind the whole page, like drawing paper, so the glass cards have something to blur. CSS only. -->
  <div id="grid-bg" aria-hidden="true" class="pointer-events-none fixed inset-0"></div>

  <main id="main" tabindex="-1" class="relative outline-none">
    <!-- Hero: who and what on the left; on the right a 3D robot, raymarched in one shader (src/scripts/robot.ts, no 3D
         library), follows the pointer: the animation work, shown rather than claimed. Reduced motion: one still frame. -->
    <section id="hero" class="relative isolate overflow-x-clip">
      <div class="mx-auto grid min-h-[100dvh] max-w-7xl items-center gap-8 px-4 pt-28 pb-16 sm:px-6 sm:pt-36 sm:pb-24 lg:grid-cols-[1.1fr_1fr] lg:gap-8 lg:px-8 lg:pt-24 lg:pb-12">
        <div>
          <p class="enter inline-flex items-center gap-2 rounded-full bg-white/[0.04] px-3.5 py-1.5 text-sm font-medium ring-1 ring-line">
            <span class="rounded-full bg-accent px-2 py-0.5 text-xs font-semibold text-on-accent">£{christmasOffer.price}</span>
            Christmas offer <span class="text-muted">· normally £{site.priceFrom}</span>
          </p>
          <h1 id="hero-title" class="display mt-7 text-[2.9rem] leading-[0.95] text-balance max-lg:enter [--d:90ms] sm:text-7xl lg:text-[clamp(3.25rem,7.5vh,5.2rem)]">
            Websites that make your <span class="mark">phone ring.</span>
          </h1>
          <!-- Says what this is in one line, before anything clever: who it's for, what you get, how you pay. -->
          <p class="enter mt-6 max-w-xl text-lg text-pretty [--d:130ms] sm:text-xl">I build websites for UK small businesses, new or rebuilt. Fixed price, live in {site.turnaround}, and you pay once you’re happy.</p>
          <!-- A face and a name up top: the visitor is hiring a person, not a template. -->
          <div class="enter mt-6 flex max-w-xl items-center gap-4 [--d:170ms]">
            <span class="size-16 shrink-0 overflow-hidden rounded-2xl bg-accent/10 ring-2 ring-accent shadow-lg shadow-accent/20 sm:size-[4.5rem]"><Image src={thomasFull} alt="" width={192} class="w-[180%] max-w-none -ml-[33%]" /></span>
            <p class="text-lg text-pretty text-muted"><strong class="display block text-2xl text-fg sm:text-[1.7rem]">I'm Thomas.</strong> London developer, {site.years} years' experience.</p>
          </div>
          <div class="enter mt-8 flex flex-wrap items-center gap-3 [--d:330ms] lg:mt-7">
            <a href={mailto} class="btn-primary min-h-14 px-7 text-base max-sm:w-full">Get a free quote<Icon name="arrow" class="size-4" /></a>
            <a href={whatsapp} target="_blank" rel="noopener" class="btn-whatsapp min-h-14 px-7 text-base max-sm:w-full">WhatsApp me</a>
          </div>
        </div>
        <div id="robot-stage" class="enter relative h-80 [--d:420ms] sm:h-[30rem] lg:h-[min(38rem,72dvh)]">
          <p aria-hidden="true" class="pointer-events-none absolute right-0 bottom-3 left-0 z-10 text-center font-mono text-[11px] tracking-[0.2em] text-muted uppercase motion-reduce:hidden"><span class="pointer-coarse:hidden">Move your mouse. Click the robot</span><span class="hidden pointer-coarse:inline">Tap anywhere, then tap the robot</span></p>
          <canvas class="absolute inset-0 size-full touch-pan-y" role="img" aria-label="A small 3D robot hovering beside the headline"></canvas>
        </div>
      </div>
    </section>

    <!-- Try it: type your business on the left, the phone on the right builds the site live.
         Desktop: the section pins and scrolling turns the phone through the trades, recolouring the page. Phones: it cycles on its own. -->
    <section id="try" class="relative isolate overflow-x-clip border-t border-line">
      <div class="mx-auto grid min-h-[100dvh] max-w-7xl items-center gap-14 px-4 py-24 sm:px-6 sm:py-28 lg:grid-cols-[1.1fr_1fr] lg:gap-8 lg:px-8 lg:py-12">
        <form id="try-form" data-trades={JSON.stringify(trades)}>
          <p class="eyebrow reveal">Try it</p>
          <h2 class="h2 reveal mt-4 max-w-xl">Type your business. <span class="text-muted">Watch the phone build it.</span></h2>
          <div class="reveal mt-8 grid gap-4 sm:grid-cols-2">
            <label class="block text-sm font-semibold">Your business<input name="name" class="field mt-2" placeholder={trades[0].demo} maxlength="28" autocomplete="organization" /></label>
            <label class="block text-sm font-semibold">Where<input name="area" class="field mt-2" placeholder="Bromley" maxlength="40" autocomplete="address-level2" /></label>
          </div>
          <fieldset class="reveal mt-4">
            <legend class="text-sm font-semibold">What you do</legend>
            <div class="mt-2 flex flex-wrap gap-2">
              {
                trades.map((t, i) => (
                  <label class="cursor-pointer rounded-xl px-3.5 py-2 text-sm ring-1 ring-fg/15 transition ring-inset hover:bg-fg/[0.06] has-checked:bg-accent has-checked:font-semibold has-checked:text-on-accent has-checked:ring-accent has-focus-visible:outline-2 has-focus-visible:outline-accent">
                    <input type="radio" name="trade" value={i} checked={i === 0} class="sr-only" />
                    {t.pick ?? t.name}
                  </label>
                ))
              }
            </div>
          </fieldset>
          <div class="reveal mt-8 flex flex-wrap items-center gap-3 lg:mt-7">
            <a id="try-cta" href={mailto} class="btn-primary min-h-14 px-7 text-base max-sm:w-full">Get a free quote<Icon name="arrow" class="size-4" /></a>
            <a href={whatsapp} target="_blank" rel="noopener" class="btn-whatsapp min-h-14 px-7 text-base max-sm:w-full">WhatsApp me</a>
          </div>
          <!-- Boti (a still of the hero's 3D robot) cheers at what's typed, so he sits right under the fields. Quip to his right, tail pointing at him. -->
          <div class="reveal mt-8 flex items-center gap-4">
            <Boti id="try-bot" class="w-24 shrink-0" />
            <p id="try-quip" aria-live="polite" class="quip max-w-56 rounded-[16px_16px_16px_4px] bg-night/90 px-3.5 py-2.5 font-mono text-[13px] leading-snug text-fg ring-1 ring-accent/60 shadow-[0_10px_40px_-10px_color-mix(in_oklab,var(--color-accent)_50%,transparent)] backdrop-blur-md">Go on, type your business.</p>
          </div>
        </form>

        <!-- The live phone in a 3D stage: #spin turns with scroll (GSAP), #tilt leans toward the pointer. -->
        <div class="reveal relative mx-auto [perspective:1600px]">
          <div aria-hidden="true" class="glow absolute top-1/2 left-1/2 -z-10 size-[160%] -translate-1/2"></div>
          <p aria-hidden="true" class="mb-5 text-center font-mono text-[11px] tracking-[0.2em] text-muted uppercase">Live preview · example</p>
          <div id="spin" class="[transform-style:preserve-3d]">
            <div id="tilt" class="transition-transform duration-500 ease-out [transform:rotateX(var(--rx,4deg))_rotateY(var(--ry,-8deg))]">
              <Phone class="float w-[280px] shadow-[0_40px_120px_-30px_color-mix(in_oklab,var(--color-accent)_45%,transparent)] sm:w-[320px] lg:w-[min(350px,calc((100dvh-15rem)*0.46))] rounded-[13%/6.5%]">
                <TradeSite trades={trades} />
              </Phone>
            </div>
          </div>
          <div aria-hidden="true" class="mt-6 flex justify-center gap-1.5">
            {trades.map((_, i) => <span data-tick={i} data-on={i === 0 ? '' : undefined} class="h-1 w-6 rounded-full bg-fg/15 transition-colors duration-500 data-on:bg-accent"></span>)}
          </div>
        </div>
      </div>
      <p aria-hidden="true" class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 font-mono text-[11px] tracking-[0.2em] text-muted uppercase lg:block motion-reduce:hidden">Scroll to switch trades</p>
    </section>

    <!-- Proof strip: numbers count up once in view (real figures, said elsewhere on the page), then one scroll-linked line of who it's for. -->
    <section aria-label="Track record" class="border-y border-line">
      <div class="mx-auto max-w-6xl lg:px-8"><div class="grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-[repeat(3,1fr)_1.2fr]">
        {
          stats.map((s, i) => (
            <div class="reveal flex items-baseline gap-4 bg-paper px-4 py-6 sm:block sm:px-6 sm:py-10" style={`--d:${i * 80}ms`}>
              <p class="display shrink-0 text-4xl tabular-nums sm:text-5xl">
                {s.count === null ? s.text : <span data-count={s.count} data-suffix={s.suffix}>{s.count.toLocaleString('en-GB') + s.suffix}</span>}
              </p>
              <p class="font-mono text-xs tracking-wide text-pretty text-muted uppercase sm:mt-3">{s.label}</p>
            </div>
          ))
        }
        <ul class="reveal flex flex-col justify-center gap-2 bg-paper px-4 py-6 text-sm font-medium [--d:240ms] sm:px-6 sm:py-10">
          {promises.map((p) => <li class="flex items-center gap-2.5"><span class="grid size-5 place-items-center rounded-full bg-accent/15 text-xs text-accent">✓</span>{p}</li>)}
        </ul></div>
      </div>
      <div aria-hidden="true" class="overflow-clip border-t border-line py-5">
        <div class="marquee flex w-max gap-8 font-mono text-sm tracking-[0.2em] whitespace-nowrap text-muted uppercase">
          {[...marquee, ...marquee, ...marquee].map((w) => <span class="flex items-center gap-8">{w}<span class="text-accent">✦</span></span>)}
        </div>
      </div>
    </section>

    <!-- Three steps, all on one screen: side by side on desktop, a list on phones. No pin, so scrolling never stalls. -->
    <section id="how" class="py-24 sm:py-32">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <h2 class="h2 reveal max-w-3xl">Three steps. <span class="text-muted">You only do the first one.</span></h2>
        <ol id="how-steps" class="mt-12 grid gap-12 lg:mt-16 lg:grid-cols-3 lg:gap-10">
          {
            steps.map((s) => (
              <li class="reveal grid content-start items-end gap-4 sm:grid-cols-[auto_1fr] sm:gap-10 lg:grid-cols-1 lg:gap-6">
                <p class="display text-7xl leading-[0.8] text-accent tabular-nums lg:text-[7rem]">{s.n}</p>
                <div>
                  <h3 class="text-2xl font-semibold tracking-tight lg:text-3xl">{s.title}</h3>
                  <p class="mt-3 max-w-md text-pretty text-muted lg:text-lg">{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <!-- The guarantee, said once and plainly: it restates step 3, no new promise. -->
        <p class="reveal mt-14 max-w-2xl text-2xl font-semibold tracking-tight text-balance">My guarantee fits in one line: <span class="mark">don’t like it, don’t pay.</span> <span class="text-muted">No deposit, no small print.</span></p>
        <div class="reveal mt-8 flex flex-wrap items-center gap-3">
          <a href={whatsapp} target="_blank" rel="noopener" class="btn-whatsapp">Send the first message</a>
          <span class="text-sm text-muted">I reply within a day.</span>
        </div>
      </div>
    </section>

    <section id="services" class="py-24 sm:py-32">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <p class="eyebrow reveal">Services</p>
        <h2 class="h2 reveal mt-4 max-w-3xl">You send one message. <span class="text-muted">I&nbsp;do the rest.</span></h2>
        <!-- Bento: the website is the product, so it gets the lit tile; add-ons sit in a quiet list beside it. -->
        <div class="mt-14 grid gap-4 lg:grid-cols-[1.15fr_1fr]">
          {
            services.slice(0, 1).map((x) => (
              <div class="glass reveal relative isolate flex flex-col overflow-hidden rounded-3xl p-7 ring-1 ring-accent/40 sm:p-10">
                <div aria-hidden="true" class="glow absolute -top-40 -right-40 -z-10 size-[28rem]"></div>
                <h3 class="font-mono text-xs tracking-[0.2em] text-accent uppercase">{x.name}</h3>
                <p class="display mt-6 text-6xl sm:text-8xl">£{christmasOffer.price}</p>
                <p class="mt-3 max-w-sm text-sm text-muted">Christmas offer, {christmasOffer.note}. Normally £{site.priceFrom}.</p>
                <ul class="mt-8 mb-10 grid content-start gap-3 border-t border-line pt-8 sm:max-lg:grid-cols-2 lg:gap-4 lg:text-lg">
                  {x.items.map((t) => <li class="flex gap-2.5"><span aria-hidden="true" class="text-accent">✓</span>{t}</li>)}
                </ul>
                <a href={mailto} class="btn-primary mt-auto w-fit">Get a free quote<Icon name="arrow" class="size-4" /></a>
              </div>
            ))
          }
          <div class="card reveal relative divide-y divide-line px-7 [--d:90ms] sm:px-9">
            {
              services.slice(1).map((x) => (
                <div class="py-7 sm:py-8">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    <h3 class="text-lg font-semibold">{x.name}</h3>
                    <p class="font-mono text-sm font-semibold text-accent">{x.price}</p>
                  </div>
                  <p class="mt-1 text-sm text-muted">{x.note}</p>
                  <ul class="mt-4 space-y-1.5 text-muted">
                    {x.items.map((t) => <li>{t}</li>)}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section id="work" class="py-24 sm:py-32">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
          <h2 class="h2 reveal max-w-3xl">Live and running. <span class="text-muted">A client site, and businesses I run myself.</span></h2>
          <p class="reveal max-w-sm text-pretty text-muted">Everything here I designed and built from scratch. My own products serve customers in Argentina, which is why they're in Spanish.</p>
        </div>
        <!-- Featured client site wide, then my own products as a row of phones. -->
        {
          work.slice(0, 1).map((w) => (
            <a href={w.url} target="_blank" rel="noopener" class="card spot reveal group relative mt-14 grid items-center gap-8 overflow-visible! p-6 hover:ring-accent/40 sm:grid-cols-[1fr_200px] sm:p-10 lg:grid-cols-[1fr_240px]">
              <div>
                <p class="font-mono text-xs tracking-wide text-muted uppercase">{w.tag}</p>
                <h3 class="display mt-3 text-4xl sm:text-5xl">{w.name}</h3>
                <p class="mt-4 max-w-md text-lg text-pretty text-muted">{w.text}</p>
                <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-accent">Visit the site<Icon name="arrow" class="size-4 -rotate-45 transition group-hover:rotate-0" /></span>
              </div>
              <div class="relative mx-auto w-[180px] sm:w-full">
                <Phone class="work-phone w-full rotate-3 transition duration-500 group-hover:rotate-0">
                  <Image src={w.img} alt={`${w.name} website on a phone`} widths={[240, 480]} sizes="240px" />
                </Phone>
                {w.sticker && <span class="sticker group-hover:rotate-0">{w.sticker}</span>}
              </div>
            </a>
          ))
        }
        <div class="mt-12 grid grid-cols-2 gap-x-4 gap-y-12 lg:grid-cols-4 lg:gap-x-8">
          {
            work.slice(1).map((w, i) => (
              <a href={w.url} target="_blank" rel="noopener" class="reveal group relative block" style={`--d:${i * 80}ms`}>
                <!-- Phone rises out of the tile's bottom edge, cropped clean (overflow-hidden); the sticker sits outside so the crop never cuts it. -->
                <div class="grid place-items-center overflow-hidden rounded-3xl bg-white/[0.03] px-6 pt-8 ring-1 ring-line ring-inset transition duration-300 group-hover:-translate-y-1 group-hover:ring-accent/40 sm:px-10">
                  <Phone class="work-phone -mb-16 w-full max-w-[150px] transition duration-500 group-hover:-translate-y-2">
                    <Image src={w.img} alt={`${w.name} website on a phone`} widths={[150, 300]} sizes="150px" />
                  </Phone>
                </div>
                {w.sticker && <span class="sticker group-hover:rotate-0">{w.sticker}</span>}
                <h3 class="mt-8 flex items-center gap-2 text-lg font-semibold">{w.name}<Icon name="arrow" class="size-4 -rotate-45 text-muted transition group-hover:text-fg" /></h3>
                <p class="mt-0.5 font-mono text-xs tracking-wide text-muted uppercase">{w.tag}</p>
                <p class="mt-2 text-sm text-pretty text-muted">{w.text}</p>
              </a>
            ))
          }
        </div>
      </div>
