---
import { Image } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Logo from '@/components/Logo.astro'
import CV from '@/components/CV.astro'
import { site } from '@/site'
import thomas from '@/assets/thombeck-pro.png'

// Recruiter landing: LinkedIn's website link points here, so hiring people skip the local-business pitch.
const mailto = `mailto:${site.email}?subject=${encodeURIComponent('Role')}`
---

<BaseLayout title={`CV | ${site.name}, AI-native full-stack engineer`} description={`${site.name}: senior full-stack engineer in London, ${site.years} years. Ships production apps fast by directing AI agents. Experience, stack and contact.`}>
  <main id="main" class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <a href="/" class="flex w-fit items-center gap-2.5 font-semibold tracking-tight"><Logo class="size-8" />{site.name}</a>
    <div class="mt-14 grid items-center gap-10 md:grid-cols-[1fr_220px]">
      <div>
        <p class="eyebrow">CV · London</p>
        <h1 class="h2 mt-3">Senior full-stack engineer. <span class="mark">AI-native.</span></h1>
        <p class="mt-5 max-w-xl text-pretty text-muted">{site.years} years shipping production web and mobile products, plus products of my own with paying users. I build by directing Claude Code agents: I write the spec, set the guardrails and review every change, so features land in days, not weeks.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={mailto} class="btn-primary">Email me</a>
          <a href="/" class="btn-ghost">See what I build</a>
        </div>
      </div>
      <Image src={thomas} alt="Thomas Beckford" width={440} class="mx-auto w-44 -rotate-2 rounded-3xl shadow-2xl shadow-fg/20 md:w-full" />
    </div>
    <!-- White card like the home one: the timeline dots' white ring assumes a white background. -->
    <section class="mt-16 rounded-3xl bg-white p-6 text-fg sm:p-10">
      <h2 class="mb-3 text-lg font-semibold">Experience and stack</h2>
      <CV />
    </section>
  </main>
</BaseLayout>
