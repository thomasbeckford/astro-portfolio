---
import { Image } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Logo from '@/components/Logo.astro'
import Icon from '@/components/Icon.astro'
import Phone from '@/components/Phone.astro'
import TradeSite from '@/components/TradeSite.astro'
import { site, steps, services, whatsapp as wa } from '@/site'
import { trades } from '@/trades'
import { landings, type Landing } from '@/landings'
import thomasFull from '@/assets/thombeck.png'

// Landings (/websites-for-{trade}, /website-redesign): same offer as the home page, said in that audience's terms.
// Static, no scripts. Fixed pages (index, cv, privacy) win over this route, so a landing path can't shadow them.
export const getStaticPaths = () => landings.map((l) => ({ params: { page: l.path }, props: { l } }))

const { l } = Astro.props as { l: Landing }
const trade = trades.find((t) => t.name === l.trade)!
const whatsapp = wa(l.ask ?? `Hi Thomas, I'm ${l.role} and I'd like a website quote.`)
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(`Website quote (${l.trade.toLowerCase()})`)}`
const others = landings.filter((x) => x !== l)
const url = `${site.url}/${l.path}`
const website = services[0]
---

<BaseLayout
  title={l.quote ? `${l.title} | Keep your web address and email | ${site.name}` : `${l.title} | From £${site.priceFrom}, live in ${site.turnaround} | ${site.name}`}
  description={l.quote ? `${l.title} in the UK by ${site.name}, a London developer. Your old site rebuilt for phones, same domain and email. Fixed quote, you see it before you pay.` : `${l.title} in the UK, built by ${site.name}, a London developer. Fixed price from £${site.priceFrom}, free hosting, you see it before you pay, no deposit.`}
  schema={[
    { '@type': 'Service', '@id': `${url}#service`, url, name: l.title, serviceType: 'Website design', audience: { '@type': 'BusinessAudience', name: l.plural }, provider: { '@id': `${site.url}/#business` }, areaServed: { '@type': 'Country', name: 'United Kingdom' }, ...(!l.quote && { offers: { '@type': 'Offer', priceCurrency: 'GBP', priceSpecification: { '@type': 'PriceSpecification', minPrice: site.priceFrom, priceCurrency: 'GBP' } } }) },
    { '@type': 'FAQPage', mainEntity: l.faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  ]}
>
  <header class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight"><Logo class="size-8" />{site.name}</a>
    <a href="#contact" class="btn-primary min-h-11 px-4 text-xs">Get a quote</a>
  </header>

  <main id="main">
    <section class="relative isolate overflow-x-clip pt-10 pb-20 sm:pt-16 sm:pb-28">
      <div aria-hidden="true" class="absolute top-0 right-0 -z-10 h-[640px] w-full bg-[radial-gradient(ellipse_55%_60%_at_80%_20%,rgb(37_99_235/0.18),transparent)]"></div>
      <div class="mx-auto grid max-w-6xl items-center gap-14 px-4 sm:px-6 lg:grid-cols-[1.2fr_1fr] lg:px-8">
        <div>
          <p class="eyebrow">For {l.plural} · UK</p>
          <h1 class="display mt-5 text-[2.6rem] leading-[0.98] text-balance sm:text-6xl">{l.head} <span class="mark">{l.mark}</span></h1>
          <p class="mt-6 max-w-xl text-lg text-pretty text-muted">{l.lede}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={whatsapp} target="_blank" rel="noopener" class="btn-whatsapp min-h-14 px-7 text-base max-sm:w-full">WhatsApp me</a>
            <a href={mailto} class="btn-ghost min-h-14 px-7 text-base max-sm:w-full">Get a free quote<Icon name="arrow" class="size-4" /></a>
          </div>
          <p class="mt-6 flex items-center gap-3 text-sm text-muted">
            <span class="size-9 overflow-hidden rounded-xl bg-accent/10 ring-2 ring-white"><Image src={thomasFull} alt="" width={128} class="w-[180%] max-w-none -ml-[33%]" /></span>
            {l.quote ? <span><strong class="font-semibold text-fg">Fixed price, quoted up front.</strong> Send me your web address. You see the new site before you pay.</span> : <span><strong class="font-semibold text-fg">From £{site.priceFrom}, fixed price.</strong> Live in {site.turnaround}. You see it before you pay.</span>}
          </p>
        </div>
        <figure class="mx-auto">
          <Phone class="w-[260px] -rotate-3 sm:w-[300px]"><TradeSite trades={[trade]} /></Phone>
          <figcaption class="mt-5 text-center text-sm text-muted">{l.caption ?? `A made-up ${l.trade.toLowerCase()}, to show the idea.`}<br />Yours is built around your business.</figcaption>
        </figure>
      </div>
    </section>

    <section class="light py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <h2 class="h2 max-w-3xl">{l.needsHead ?? `What ${l.plural}’ sites need.`} <span class="text-muted">All of it included.</span></h2>
        <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            l.needs.map(([t, d]) => (
              <li class="card p-6 sm:p-7">
                <h3 class="font-semibold">{t}</h3>
                <p class="mt-2 text-pretty text-muted">{d}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="py-20 sm:py-28">
      <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-[1fr_1fr] lg:gap-20 lg:px-8">
        <div>
          <h2 class="h2">Three steps. <span class="text-muted">You only do the first one.</span></h2>
          <ol class="mt-10 space-y-8">
            {
              steps.map((s) => (
                <li class="flex gap-5">
                  <span class="display text-4xl text-accent tabular-nums">{s.n}</span>
                  <div>
                    <h3 class="text-lg font-semibold">{l.quote && s.n === '02' ? 'See it before it goes live' : s.title}</h3>
                    <p class="mt-1 max-w-md text-pretty text-muted">{s.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <p class="mt-10 max-w-xl text-2xl font-semibold tracking-tight text-balance">My guarantee fits in one line: <span class="mark">don’t like it, don’t pay.</span> <span class="text-muted">No deposit, no small print.</span></p>
        </div>
        <div class="accent-band self-start rounded-3xl p-7 shadow-2xl shadow-[#2563eb]/30 sm:p-10">
          <h3 class="text-lg font-semibold">{l.quote ? l.title : website.name}</h3>
          <p class="display mt-6 text-6xl sm:text-7xl">{l.quote ? 'On quote' : `£${site.priceFrom}`}</p>
          <p class="mt-3 max-w-sm text-sm text-muted">{l.quote ? 'Send me your web address. I look at what is there and come back with a fixed price, usually within a day.' : website.note}</p>
          <ul class="mt-8 grid gap-3 border-t border-line pt-8">
            {website.items.map((t) => <li class="flex gap-2.5"><span aria-hidden="true">✓</span>{t}</li>)}
          </ul>
          <a href="/#services" class="mt-8 inline-block text-sm font-semibold underline underline-offset-4">Care plan and ads, optional</a>
        </div>
      </div>
    </section>

    <section class="light py-20 sm:py-28">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <h2 class="h2">Questions {l.plural} ask.</h2>
        <div class="mt-10 divide-y divide-line border-y border-line">
          {
            l.faqs.map(([q, a]) => (
              <details name="faq" class="group py-5">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-pretty [&::-webkit-details-marker]:hidden">
                  {q}
                  <span aria-hidden="true" class="text-xl leading-none text-muted transition group-open:rotate-45">+</span>
                </summary>
                <p class="mt-3 text-pretty text-muted">{a}</p>
              </details>
            ))
          }
        </div>
        <p class="mt-6 text-sm text-muted">More on price, ownership and how I work in the <a href="/#faq" class="font-semibold text-fg underline underline-offset-4">main FAQ</a>.</p>
      </div>
    </section>

    <section id="contact" class="py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-4 text-center sm:px-6 lg:px-8">
        <h2 class="h2 mx-auto max-w-3xl">Let’s get your phone <span class="mark">ringing.</span></h2>
        <p class="mx-auto mt-5 max-w-lg text-pretty text-muted">{l.quote ? 'Send me your web address.' : 'Tell me what you do and where.'} I'll come back with a fixed price, usually within a day. No obligation, no deposit.</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={whatsapp} target="_blank" rel="noopener" class="btn-whatsapp min-h-14 px-7 text-base max-sm:w-full">WhatsApp me<Icon name="arrow" class="size-4" /></a>
          <a href={mailto} class="btn-ghost min-h-14 px-7 text-base max-sm:w-full">Email me</a>
        </div>
        <p class="mt-5 text-sm text-muted">Or call <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="font-semibold text-fg underline-offset-4 hover:underline">{site.phone}</a></p>
      </div>
    </section>
  </main>

  <footer class="border-t border-line py-8 text-sm text-muted">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
      <p>© {new Date().getFullYear()} {site.name} · London, UK</p>
      <nav aria-label="Other pages" class="flex flex-wrap gap-x-5 gap-y-1">
        <a href="/" class="py-1.5 hover:text-fg">Home</a>
        {others.map((x) => <a href={`/${x.path}`} class="py-1.5 hover:text-fg">{x.title}</a>)}
        <a href="/privacy" class="py-1.5 hover:text-fg">Privacy</a>
      </nav>
    </div>
  </footer>
</BaseLayout>
