---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Logo from '@/components/Logo.astro'
import { site } from '@/site'

// Plain-English UK GDPR notice (Art. 13: who, what, why, lawful basis, how long, rights). Keep it true: if analytics,
// forms or new third parties are added, this page changes too.
const updated = '8 October 2026'
// Static copy, so set:html is safe; it lets the email and ICO be real links.
const sections = [
  ['Who I am', `${site.name}, a sole trader in London, UK. I’m the controller of any personal data on this site. Contact: <a href="mailto:${site.email}" class="font-medium text-accent-ink underline underline-offset-2">${site.email}</a>.`],
  ['What this site collects', 'Nothing by itself. There are no analytics, no advertising or tracking cookies, and no forms that save what you type. Cookie, the quote helper, runs in your browser and sends nothing until you tap WhatsApp or email.'],
  ['Your privacy choice', 'The consent banner is run by Usercentrics GmbH (Munich), acting for me as a processor. Its script loads on every page, so Usercentrics sees your IP address and browser details. Your choice is kept in your browser’s storage, which is strictly necessary and needs no consent, and a pseudonymous record of it is kept so I can show what you chose (legal obligation). You can change or withdraw it any time with the “Privacy settings” button below or in the footer of the home page. The settings panel also lists Usercentrics’ own privacy details.'],
  ['Hosting', 'The site is hosted by Vercel Inc., which processes basic server logs (such as IP address and browser) to deliver the site and keep it secure (legitimate interests). I don’t use them for anything else.'],
  ['When you contact me', 'If you message me on WhatsApp or by email, I get what you send: usually your name, number or email, and details about your business. I use it only to reply, quote and do the work you ask for (steps before a contract, then the contract). I don’t sell it or add you to mailing lists. If we don’t work together, I delete it within 12 months. If we do, I keep invoices and the records behind them for 6 years, as HMRC requires (legal obligation). WhatsApp (Meta) and email (Google) handle those messages under their own privacy policies.'],
  ['Your rights', `You can ask to see, correct, delete or move the data I hold about you, ask me to restrict how I use it, or object to it. Where something relies on your consent, you can withdraw it any time. Email <a href="mailto:${site.email}" class="font-medium text-accent-ink underline underline-offset-2">${site.email}</a> and I’ll reply within a month. If you’re unhappy with the answer you can complain to the Information Commissioner’s Office at <a href="https://ico.org.uk/make-a-complaint/" class="font-medium text-accent-ink underline underline-offset-2">ico.org.uk</a>.`],
]
---

<BaseLayout title={`Privacy | ${site.name}`} description={`How ${site.name}'s website handles personal data. Short version: no tracking.`}>
  <main id="main" class="mx-auto max-w-2xl px-4 py-16 sm:px-6 sm:py-24">
    <a href="/" class="flex w-fit items-center gap-2.5 font-semibold tracking-tight"><Logo class="size-8" />{site.name}</a>
    <p class="eyebrow mt-14">Privacy</p>
    <h1 class="h2 mt-3">Short version: <span class="mark">no tracking.</span></h1>
    <p class="mt-4 text-sm text-muted">Last updated {updated}</p>
    <div class="mt-10 space-y-8">
      {
        sections.map(([h, p]) => (
          <section>
            <h2 class="text-lg font-semibold">{h}</h2>
            <p class="mt-2 text-pretty text-muted" set:html={p} />
          </section>
        ))
      }
    </div>
    <div class="mt-12 flex flex-wrap gap-3">
      <button type="button" data-privacy class="btn-primary">Privacy settings</button>
      <a href="/" class="btn-ghost">Back to the site</a>
    </div>
    <p id="privacy-note" aria-live="polite" class="mt-4 min-h-5 text-sm text-muted"></p>
  </main>
</BaseLayout>

<script>
  import { openPrivacySettings } from '@/consent'

  // If the panel can't open, say so instead of a dead button.
  document.querySelector('[data-privacy]')!.addEventListener('click', async () => {
    if (!(await openPrivacySettings())) document.getElementById('privacy-note')!.textContent = 'The settings panel didn’t load, maybe blocked by your browser. Nothing else is stored anyway.'
  })
</script>
