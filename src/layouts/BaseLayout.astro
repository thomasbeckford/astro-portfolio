---
import '@fontsource-variable/geist'
import '@fontsource-variable/jetbrains-mono'
import '@/styles/global.css'
import Analytics from '@vercel/analytics/astro'
import { site, services } from '@/site'

interface Props {
  title: string
  description: string
  noindex?: boolean
  schema?: object[] // extra JSON-LD nodes for this page
  dark?: boolean // the home's showcase theme; every other page stays on paper
}

const { title, description, noindex = false, schema = [], dark = false } = Astro.props
// No trailing slash, so it matches the sitemap and the links (/privacy, not /privacy/).
const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site)
const ogImage = new URL('/og.png', Astro.site)

const person = {
  '@type': 'Person',
  '@id': `${site.url}/#me`,
  name: site.name,
  jobTitle: site.role,
  url: site.url,
  image: ogImage.href,
  email: site.email,
  address: { '@type': 'PostalAddress', addressLocality: 'London', addressCountry: 'GB' },
  knowsAbout: ['Websites for tradespeople', 'Small business websites', 'Hospitality websites', 'Websites for hotels, bars and venues', 'Website redesign', 'Local SEO', 'Google Ads', 'Meta Ads', 'Headless CMS', 'Payload CMS', 'Sanity', 'Contentstack', 'Headless WordPress', 'Web applications', 'Dashboards', 'Mobile apps', 'Astro', 'Next.js', 'TanStack Start', 'React', 'React Native', 'Expo', 'TypeScript', 'Node.js', 'PostgreSQL', 'Stripe', 'GSAP', 'n8n', 'Automation'],
  sameAs: [site.linkedin, site.github],
}
const business = {
  '@type': 'ProfessionalService',
  '@id': `${site.url}/#business`,
  name: `${site.name}, websites for local businesses`,
  url: site.url,
  image: ogImage.href,
  logo: new URL('/icon-512.png', Astro.site).href,
  email: site.email,
  telephone: site.phone,
  founder: { '@id': person['@id'] },
  address: person.address,
  areaServed: [{ '@type': 'Country', name: 'United Kingdom' }],
  sameAs: [site.gbp],
  makesOffer: services.map((x) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: x.name, description: x.items.join('. ') },
  })),
}
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [person, business, { '@type': 'WebSite', url: site.url, name: site.name, inLanguage: 'en-GB', publisher: { '@id': person['@id'] } }, ...schema],
}
---

<!doctype html>
<html lang="en-GB" class:list={[dark && 'showcase']}>
  <head>
    <meta charset="utf-8" />
    <!-- Vercel Web Analytics is cookieless (a request hash dropped after 24h) and skips anyone with Global Privacy Control
         or Do Not Track on, as the privacy page says. Judgement call, not a given: we lean on PECR's statistics exemption. -->
    <script is:inline>
      // Read by Vercel's Astro component: returning null drops the event.
      window.webAnalyticsBeforeSend = (e) => (navigator.globalPrivacyControl || navigator.doNotTrack === '1' ? null : e)
    </script>
    <!-- Google Ads tag (2026-10-14, Thomas's call, ending the no-cookies promise). Consent Mode v2, all denied: no cookies
         until a consent banner grants them, only cookieless pings. Granting is the banner's job, still to do.
         Skipped entirely under Global Privacy Control or Do Not Track, as the privacy page says. -->
    <script is:inline>
      if (!(navigator.globalPrivacyControl || navigator.doNotTrack === '1')) {
        window.dataLayer = window.dataLayer || []
        window.gtag = function () { dataLayer.push(arguments) }
        gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied' })
        gtag('js', new Date())
        gtag('config', 'AW-18512791518')
        const s = document.createElement('script')
        s.async = true
        s.src = 'https://www.googletagmanager.com/gtag/js?id=AW-18512791518'
        document.head.append(s)
        // Conversion "WhatsApp or email click": the lead itself happens in WhatsApp or the mail app, this is the closest signal.
        // auxclick only for the middle button (Chromium fires it on right-click too). Privacy and CV emails aren't leads.
        if (!/^\/(privacy|cv)\b/.test(location.pathname))
          for (const type of ['click', 'auxclick'])
            addEventListener(type, (e) => {
              if ((e.type === 'click' || e.button === 1) && e.target.closest?.('a[href^="https://wa.me/"], a[href^="mailto:"]')) gtag('event', 'conversion', { send_to: 'AW-18512791518/p7OYCPGc4ZwdEN6Py_tE' })
            }, true)
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="author" content={site.name} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Plain-text summary for AI assistants" />
    <meta name="theme-color" content={dark ? '#07080b' : '#eceef4'} />
    <meta name="color-scheme" content={dark ? 'dark' : 'light'} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: websites that make your phone ring. Fixed price, pay when you’re happy.`} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#main" class="btn-primary fixed top-3 left-3 z-50 -translate-y-24 focus:translate-y-0">Skip to content</a>
    <slot />
    <Analytics />
    <script>
      // Where the visitor came from (?ref=meta-electrician, or else the referring site), added to the end of WhatsApp
      // and email messages so every lead says its source. Tagged at click time, so links built later are covered too.
      // ponytail: in memory only (storage would need consent), so ref and gclid are lost if they browse to another page first.
      const fromSite = document.referrer && new URL(document.referrer).host !== location.host ? new URL(document.referrer).hostname : ''
      const query = new URLSearchParams(location.search)
      const ref = (query.get('ref') || fromSite).replace(/[^\w.-]/g, '').slice(0, 40)
      // A short code per page view, in the message and in the beacon below, so n8n's lead row matches the chat that arrives.
      const code = [...crypto.getRandomValues(new Uint8Array(4))].map((n) => 'ABCDEFGHJKMNPQRSTUVWXYZ23456789'[n % 31]).join('')
      const tag = ref ? `(ref: ${ref} #${code})` : `(#${code})`
      // Rebuilt by hand, not with URL.searchParams: that encodes spaces as "+", which mail apps show literally.
      const tagged = (href: string, key: string) => {
        const [base, query = ''] = href.split('?')
        const params = new URLSearchParams(query)
        const text = (params.get(key) ?? '').trimEnd()
        if (text.includes(tag)) return href
        params.set(key, text ? `${text}\n\n${tag}` : tag)
        return `${base}?${[...params].map(([k, v]) => `${k}=${encodeURIComponent(v)}`).join('&')}`
      }
      // One beacon per page view to n8n (lead registry + Telegram alert). The ad click ID goes only when the Ads tag
      // would load too (no GPC/DNT), so n8n can report closed clients back to Google Ads. Form-encoded: no CORS preflight.
      const leadHook = 'https://n8n-production-d039.up.railway.app/webhook/lead-click'
      const quiet = (navigator as any).globalPrivacyControl || navigator.doNotTrack === '1'
      let sent = false
      // auxclick and contextmenu cover middle-click, "open in new tab" and copying the link.
      for (const type of ['click', 'auxclick', 'contextmenu'])
        addEventListener(
          type,
          (e) => {
            const a = (e.target as Element).closest?.<HTMLAnchorElement>('a[href^="https://wa.me/"], a[href^="mailto:"]')
            if (!a || /^\/(privacy|cv)\b/.test(location.pathname)) return
            const channel = a.protocol === 'mailto:' ? 'email' : 'whatsapp'
            a.href = tagged(a.href, channel === 'email' ? 'body' : 'text')
            // Only the live site reports: local dev and Vercel previews would put test taps in the Sheet.
            if (sent || type === 'contextmenu' || location.hostname.replace(/^www\./, '') !== 'tebeck.dev') return
            sent = true
            const gclid = quiet ? '' : (query.get('gclid') ?? '').slice(0, 200)
            navigator.sendBeacon(leadHook, new URLSearchParams({ code, ref, channel, gclid, page: location.pathname, device: matchMedia('(pointer: coarse)').matches ? 'mobile' : 'desktop' }))
          },
          true,
        )
    </script>
  </body>
</html>
