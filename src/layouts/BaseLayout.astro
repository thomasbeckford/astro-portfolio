---
import '@fontsource-variable/geist'
import '@fontsource-variable/jetbrains-mono'
import '@/styles/global.css'
import { site, services } from '@/site'

interface Props {
  title: string
  description: string
  noindex?: boolean
  schema?: object[] // extra JSON-LD nodes for this page
}

const { title, description, noindex = false, schema = [] } = Astro.props
// No trailing slash, so it matches the sitemap and the links (/privacy, not /privacy/).
const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site)
const ogImage = new URL('/og.png', Astro.site)

const person = {
  '@type': 'Person',
  '@id': `${site.url}/#me`,
  name: site.name,
  jobTitle: site.role,
  url: site.url,
  image: ogImage.href,
  email: site.email,
  address: { '@type': 'PostalAddress', addressLocality: 'London', addressCountry: 'GB' },
  knowsAbout: ['Local business websites', 'Local SEO', 'Google Ads', 'Meta Ads', 'React', 'Next.js', 'TypeScript', 'Node.js'],
  sameAs: [site.linkedin, site.github],
}
// What search engines and AI assistants should understand Thomas sells.
const business = {
  '@type': 'ProfessionalService',
  '@id': `${site.url}/#business`,
  name: `${site.name}, websites for local businesses`,
  url: site.url,
  image: ogImage.href,
  logo: new URL('/icon-512.png', Astro.site).href,
  email: site.email,
  founder: { '@id': person['@id'] },
  address: person.address,
  areaServed: [{ '@type': 'Country', name: 'United Kingdom' }],
  priceRange: `From £${site.priceFrom}`,
  makesOffer: services.map((x) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: x.name, description: x.items.join('. ') },
    ...(x.name === 'Website' && { priceSpecification: { '@type': 'PriceSpecification', minPrice: site.priceFrom, priceCurrency: 'GBP' } }),
  })),
}
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [person, business, { '@type': 'WebSite', url: site.url, name: site.name, inLanguage: 'en-GB', publisher: { '@id': person['@id'] } }, ...schema],
}
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <!-- No consent banner on purpose: no cookies, storage or third-party scripts, so PECR has nothing to ask about.
         Adding analytics, ads or embeds means bringing a consent banner back first. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="author" content={site.name} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Plain-text summary for AI assistants" />
    <meta name="theme-color" content="#eceef4" />
    <meta name="color-scheme" content="light" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: websites for local businesses, built and looked after. From £${site.priceFrom}.`} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#main" class="btn-primary fixed top-3 left-3 z-50 -translate-y-24 focus:translate-y-0">Skip to content</a>
    <slot />
  </body>
</html>
