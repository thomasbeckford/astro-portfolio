---
import '@fontsource-variable/geist'
import '@fontsource-variable/jetbrains-mono'
import '@/styles/global.css'
import Analytics from '@vercel/analytics/astro'
import { site, services, carePrice, cmsPrice } from '@/site'

interface Props {
  title: string
  description: string
  noindex?: boolean
  schema?: object[] // extra JSON-LD nodes for this page
  dark?: boolean // the home's showcase theme; every other page stays on paper
}

const { title, description, noindex = false, schema = [], dark = false } = Astro.props
// No trailing slash, so it matches the sitemap and the links (/privacy, not /privacy/).
const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site)
const ogImage = new URL('/og.png', Astro.site)

const person = {
  '@type': 'Person',
  '@id': `${site.url}/#me`,
  name: site.name,
  jobTitle: site.role,
  url: site.url,
  image: ogImage.href,
  email: site.email,
  address: { '@type': 'PostalAddress', addressLocality: 'London', addressCountry: 'GB' },
  knowsAbout: ['Websites for tradespeople', 'Small business websites', 'Website redesign', 'Local SEO', 'Google Ads', 'Meta Ads', 'Headless CMS', 'Payload CMS', 'Sanity', 'Contentstack', 'Headless WordPress', 'Web applications', 'Mobile apps', 'Astro', 'Next.js', 'TanStack Start', 'React', 'React Native', 'Expo', 'TypeScript', 'Node.js', 'PostgreSQL', 'Stripe', 'GSAP'],
  sameAs: [site.linkedin, site.github],
}
// What search engines and AI assistants should understand Thomas sells. Monthly prices carry a per-month unit.
const prices: Record<string, object> = {
  Website: { '@type': 'PriceSpecification', minPrice: site.priceFrom, priceCurrency: 'GBP' },
  'Edit it yourself': { '@type': 'PriceSpecification', price: cmsPrice, priceCurrency: 'GBP' },
  'Care plan': { '@type': 'UnitPriceSpecification', minPrice: carePrice, priceCurrency: 'GBP', unitCode: 'MON' },
}
const business = {
  '@type': 'ProfessionalService',
  '@id': `${site.url}/#business`,
  name: `${site.name}, websites for local businesses`,
  url: site.url,
  image: ogImage.href,
  logo: new URL('/icon-512.png', Astro.site).href,
  email: site.email,
  founder: { '@id': person['@id'] },
  address: person.address,
  areaServed: [{ '@type': 'Country', name: 'United Kingdom' }],
  priceRange: `From £${site.priceFrom}`,
  makesOffer: services.map((x) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: x.name, description: x.items.join('. ') },
    ...(prices[x.name] && { priceSpecification: prices[x.name] }),
  })),
}
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [person, business, { '@type': 'WebSite', url: site.url, name: site.name, inLanguage: 'en-GB', publisher: { '@id': person['@id'] } }, ...schema],
}
---

<!doctype html>
<html lang="en-GB" class:list={[dark && 'showcase']}>
  <head>
    <meta charset="utf-8" />
    <!-- No consent banner on purpose: no cookies or browser storage. Vercel Web Analytics is cookieless (a request hash
         dropped after 24h) and skips anyone with Global Privacy Control or Do Not Track on, as the privacy page says.
         Judgement call, not a given: we lean on PECR's statistics exemption. Ads pixels or embeds mean a banner first. -->
    <script is:inline>
      // Read by Vercel's Astro component: returning null drops the event.
      window.webAnalyticsBeforeSend = (e) => (navigator.globalPrivacyControl || navigator.doNotTrack === '1' ? null : e)
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="author" content={site.name} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Plain-text summary for AI assistants" />
    <meta name="theme-color" content={dark ? '#07080b' : '#eceef4'} />
    <meta name="color-scheme" content={dark ? 'dark' : 'light'} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: websites that make your phone ring. From £${site.priceFrom}, fixed price.`} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#main" class="btn-primary fixed top-3 left-3 z-50 -translate-y-24 focus:translate-y-0">Skip to content</a>
    <slot />
    <Analytics />
    <script>
      // Where the visitor came from (?ref=meta-electrician, or else the referring site), added to the end of WhatsApp
      // and email messages so every lead says its source. Tagged at click time, so links built later are covered too.
      // ponytail: in memory only (storage would need consent), so the ref is lost if they browse to another page first.
      const fromSite = document.referrer && new URL(document.referrer).host !== location.host ? new URL(document.referrer).hostname : ''
      const ref = (new URLSearchParams(location.search).get('ref') || fromSite).replace(/[^\w.-]/g, '').slice(0, 40)
      const tag = `(ref: ${ref})`
      // Rebuilt by hand, not with URL.searchParams: that encodes spaces as "+", which mail apps show literally.
      const tagged = (href: string, key: string) => {
        const [base, query = ''] = href.split('?')
        const params = new URLSearchParams(query)
        const text = (params.get(key) ?? '').trimEnd()
        if (text.includes(tag)) return href
        params.set(key, text ? `${text}\n\n${tag}` : tag)
        return `${base}?${[...params].map(([k, v]) => `${k}=${encodeURIComponent(v)}`).join('&')}`
      }
      // auxclick and contextmenu cover middle-click, "open in new tab" and copying the link.
      if (ref)
        for (const type of ['click', 'auxclick', 'contextmenu'])
          addEventListener(
            type,
            (e) => {
              const a = (e.target as Element).closest?.<HTMLAnchorElement>('a[href^="https://wa.me/"], a[href^="mailto:"]')
              if (a) a.href = tagged(a.href, a.protocol === 'mailto:' ? 'body' : 'text')
            },
            true,
          )
    </script>
  </body>
</html>
