---
// What a bay costs: a price per bay per hour for each time of the week, and a slider for how many of you there are,
// which splits it per head (motion.ts). Made up, and it says so. Without JS: the bay prices, split four ways.
import type { Demo } from '@/templates'
const { d } = Astro.props as { d: Demo }
const bays = d.bays ?? []
const players = 4, most = 8
const each = (p: number, n: number) => `£${(p / n).toFixed(2).replace(/\.00$/, '')}`
---
<section id="prices" data-prices class="px-4 py-24 sm:px-8 sm:py-32">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
      <div>
        <p class="font-(family-name:--display) text-sm font-black tracking-wide text-(--accent) uppercase">Pay by the bay, not the head</p>
        <h2 data-split class="mt-4 font-(family-name:--display) text-[clamp(2.25rem,8vw,5.5rem)] leading-[0.9] font-black tracking-[-0.03em] uppercase">Bays and prices</h2>
      </div>
      <div class="block w-full rounded-3xl border border-(--fg)/15 bg-(--panel) p-5 lg:w-[22rem]">
        <span class="flex items-baseline justify-between text-sm font-semibold"><span aria-hidden="true" class="tracking-widest text-(--muted) uppercase">In your bay</span><span aria-hidden="true"><b data-prices-n class="inline-block font-(family-name:--display) text-2xl font-black text-(--accent) tabular-nums">{players}</b> players</span></span>
        <input type="range" min="1" max={most} value={players} aria-label="Players in your bay" aria-valuetext={`${players} players`} data-prices-range class="mt-4 h-2 w-full cursor-pointer appearance-none rounded-full outline-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--accent) bg-(--fg)/15 accent-(--accent) [&::-webkit-slider-thumb]:size-6 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-(--accent) [&::-webkit-slider-thumb]:shadow-[0_0_0_6px_color-mix(in_oklab,var(--accent)_25%,transparent)] [&::-webkit-slider-thumb]:transition-transform active:[&::-webkit-slider-thumb]:scale-110 [&::-moz-range-thumb]:size-6 [&::-moz-range-thumb]:rounded-full [&::-moz-range-thumb]:border-0 [&::-moz-range-thumb]:bg-(--accent)" />
        <span aria-hidden="true" class="mt-2 flex justify-between text-xs text-(--muted)"><span>1</span><span>Up to {most} a bay</span></span>
        <span data-prices-say role="status" class="sr-only"></span>
      </div>
    </div>
    <ul class="mt-10 grid gap-4 md:grid-cols-3">
      {bays.map((b, i) => (
        <li data-rise data-price={b.price} class:list={['group relative flex flex-col overflow-hidden rounded-3xl border p-6 transition-[translate] duration-500 ease-out motion-safe:hover:-translate-y-1 sm:p-8', i === 1 ? 'border-(--accent) bg-(--accent) text-(--on-accent)' : 'border-(--fg)/15 bg-(--panel)']}>
          <p class:list={['text-sm font-semibold tracking-widest uppercase', i === 1 ? 'opacity-70' : 'text-(--muted)']}>{b.when}</p>
          <h3 class="mt-3 font-(family-name:--display) text-2xl leading-tight font-black uppercase sm:text-3xl">{b.name}</h3>
          <p class="mt-8 flex items-baseline gap-2"><span class="font-(family-name:--display) text-[clamp(3rem,7vw,4.5rem)] leading-none font-black">£{b.price}</span><span class:list={['text-sm font-semibold', i !== 1 && 'text-(--muted)']}>a bay, per hour</span></p>
          <p class:list={['mt-6 border-t pt-4 font-semibold', i === 1 ? 'border-(--on-accent)/20' : 'border-(--fg)/10']}><span data-prices-each class="inline-block tabular-nums">{each(b.price, players)}</span> each<span data-prices-with> with {players}</span></p>
        </li>
      ))}
    </ul>
    <ul class="mt-6 flex flex-wrap gap-2">
      {(d.included ?? []).map((x) => <li class="rounded-full border border-(--fg)/15 px-4 py-2 text-sm font-semibold"><span aria-hidden="true" class="mr-1.5 text-(--accent)">✓</span>{x}</li>)}
    </ul>
    <p class="mt-6 text-sm text-(--muted)">Example prices. Food and drinks on top, ordered from the bay.</p>
  </div>
</section>
