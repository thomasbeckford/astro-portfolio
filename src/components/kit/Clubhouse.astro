---
// Closing call for parties over photo 6 with an enquiry form, then a footer under a fringe of grass: every venue by city
// and the name cropped by the page edge. The form is method="dialog" so without JS it goes nowhere (and puts nobody's
// details in a URL); motion.ts says it's an example instead of sending.
import type { Demo } from '@/templates'
import { Image } from 'astro:assets'
import { fit, photos } from './media'
import { rng, grass } from './jungle'
const { d } = Astro.props as { d: Demo }
const pic = photos(d.slug)[5]
const fringe = grass(rng(11), 1200, 90, 150)
const venues = d.venues ?? []
const cities = [...new Set(venues.map((x) => x.city))]
const label = 'flex min-w-0 flex-col gap-1.5 text-xs font-semibold tracking-widest text-(--fg)/70 uppercase'
const input = 'w-full min-w-0 rounded-2xl border border-(--fg)/15 bg-(--fg)/5 px-4 py-3 text-base font-medium tracking-normal text-(--fg) normal-case outline-none transition-colors placeholder:text-(--fg)/35 focus:border-(--accent)'
---
<section id="contact" class="relative isolate overflow-hidden px-4 pt-32 pb-36 sm:px-8 sm:pt-48">
  {pic && <div class="absolute inset-0 -z-10 overflow-hidden"><Image src={pic} alt="" widths={[800, 1400, 2000]} sizes="100vw" data-parallax class="h-[124%] w-full object-cover" /></div>}
  <div class="absolute inset-0 -z-10 bg-linear-to-b from-(--bg) via-(--bg)/50 to-(--bg)/80"></div>
  <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[1fr_minmax(0,34rem)] lg:items-end">
    <div>
      <p class="font-(family-name:--display) text-sm font-black tracking-wide text-(--accent) uppercase">Parties and team socials</p>
      <h2 data-split class="mt-4 font-(family-name:--display) text-[clamp(2.75rem,12vw,9rem)] leading-[0.86] font-black tracking-[-0.03em] uppercase">{d.contact}</h2>
      <p class="mt-6 max-w-lg text-lg text-(--fg)/85">Birthdays, leaving drinks and whole-office takeovers. Tell us the date and the headcount, and a host sorts the rest.</p>
    </div>
    <form data-enquiry method="dialog" class="grid gap-4 rounded-[2rem] border border-(--fg)/15 bg-(--bg)/85 p-5 [color-scheme:dark] backdrop-blur-xl sm:grid-cols-2 sm:p-7">
      <label class={label}>Venue
        <select name="venue" class={input}>
          {cities.map((c) => <optgroup label={c}>{venues.filter((v) => v.city === c).map((v) => <option>{v.name}</option>)}</optgroup>)}
        </select>
      </label>
      <label class={label}>Type of event
        <select name="type" class={input}>{['Birthday', 'Work party', 'Leaving drinks', 'League night', 'Something else'].map((t) => <option>{t}</option>)}</select>
      </label>
      <label class={label}>Date<input type="date" name="date" required class={input} /></label>
      <label class={label}>Guests<input type="number" name="guests" min="2" max="200" value="12" required inputmode="numeric" class={input} /></label>
      <label class={label}>Name<input name="name" autocomplete="name" required class={input} /></label>
      <label class={label}>Email<input type="email" name="email" autocomplete="email" required class={input} /></label>
      <label class:list={[label, 'sm:col-span-2']}>Phone <span class="sr-only">(optional)</span><input type="tel" name="phone" autocomplete="tel" placeholder="Optional" class={input} /></label>
      <label class:list={[label, 'sm:col-span-2']}>Anything else<textarea name="message" rows="3" placeholder="Food, drinks, a time, a theme" class:list={[input, 'resize-y']}></textarea></label>
      <button class="rounded-full bg-(--accent) px-8 py-4 text-lg font-bold text-(--on-accent) transition-transform active:scale-[0.98] sm:col-span-2">Send enquiry →</button>
      <p data-enquiry-note role="status" class="text-center text-sm text-(--fg)/80 sm:col-span-2"></p>
    </form>
  </div>
  <svg aria-hidden="true" viewBox="0 0 1200 90" preserveAspectRatio="none" class="absolute inset-x-0 -bottom-px h-18 w-full"><path d={fringe} fill="var(--bg)" /></svg>
</section>
<footer class="overflow-hidden px-4 pt-20 sm:px-8">
  <div class="mx-auto grid max-w-7xl grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-5">
    {cities.map((c) => (
      <div>
        <p class="text-xs font-bold tracking-widest text-(--accent) uppercase">{c}</p>
        <ul class="mt-3 space-y-1">{venues.filter((v) => v.city === c).map((v) => <li><a href="#book" data-book-venue={v.name} class="hover:text-(--accent)">{v.name}</a></li>)}</ul>
      </div>
    ))}
  </div>
  <p aria-hidden="true" class="mt-16 translate-y-[16%] text-center font-(family-name:--display) leading-[0.8] font-black whitespace-nowrap text-(--accent) uppercase" style={`font-size:${fit(d.mark, d.font)}`}>{d.mark}</p>
</footer>
