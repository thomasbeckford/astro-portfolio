---
// Recent work as full-screen panels: each one slides up over the last (plain CSS sticky). Photos 6..8.
import type { Demo } from '@/templates'
import { Image } from 'astro:assets'
import { photos } from './media'
const { d } = Astro.props as { d: Demo }
const pics = photos(d.slug).slice(5)
const items = (d.projects ?? []).filter((_, i) => pics[i])
---
<section id="work" aria-label="Recent work">
  {items.map((p, i) => (
    <article class="sticky top-0 isolate h-[100dvh] overflow-hidden">
      <Image src={pics[i]} alt="" widths={[800, 1600, 2400]} sizes="100vw" class="absolute inset-0 -z-20 size-full object-cover" />
      <div class="absolute inset-0 -z-10 bg-linear-to-b from-black/55 via-transparent to-black/20"></div>
      <div class="flex items-baseline gap-6 px-4 pt-24 sm:px-8 sm:pt-28">
        <h3 class="font-(family-name:--display) text-4xl leading-none font-bold tracking-[-0.04em] text-white sm:text-7xl">{p.title}</h3>
        <span class="hidden h-px flex-1 self-center bg-white/50 sm:block"></span>
        <span class="ml-auto text-sm text-white/85 sm:ml-0 sm:text-base">{String(i + 1).padStart(2, '0')} · {p.kind}</span>
      </div>
    </article>
  ))}
</section>
