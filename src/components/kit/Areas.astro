---
import type { Demo } from '@/templates'
const { d } = Astro.props as { d: Demo }
---
<section id="areas" class="bg-(--panel) px-4 py-24 sm:px-8">
  <div class="mx-auto max-w-7xl">
    <p class="text-sm tracking-[0.2em] text-(--accent) uppercase">Where we work</p>
    <ul class="mt-8 flex flex-wrap gap-x-8 gap-y-2 font-(family-name:--display) text-4xl leading-tight tracking-tight uppercase sm:text-6xl" style={d.font === 'archivo' ? 'font-stretch:125%;font-weight:800' : undefined}>
      {d.areas.map((a, i) => <li data-rise class:list={[i % 2 && 'text-(--muted)']}>{a}</li>)}
    </ul>
  </div>
</section>
