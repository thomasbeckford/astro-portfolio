---
// Opening curtain: a grid of blocks that steps away from the bottom-left corner (motion.ts). CSS in global.css lifts
// it on its own after a moment if the script never runs, and never shows it under reduced motion.
---
<div data-curtain aria-hidden="true" class="pointer-events-none fixed inset-0 z-[60] grid grid-cols-6 grid-rows-4">
  {Array.from({ length: 24 }, () => <div class="origin-top bg-black"></div>)}
</div>
