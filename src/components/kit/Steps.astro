---
import type { Demo } from '@/templates'
const { d } = Astro.props as { d: Demo }
---
<section id="how" class="mx-auto max-w-7xl px-4 py-28 sm:px-8 sm:py-36">
  <h2 data-split class="font-(family-name:--display) text-5xl leading-none tracking-tight uppercase sm:text-8xl">How it works</h2>
  <ol class="mt-14 grid gap-10 md:grid-cols-3">
    {d.steps.map((s, i) => (
      <li data-rise class="border-t-2 border-(--accent) pt-6">
        <span class="font-(family-name:--display) text-8xl leading-none text-(--accent) sm:text-9xl">{i + 1}</span>
        <h3 class="mt-6 text-2xl font-semibold">{s.title}</h3>
        <p class="mt-2 text-(--muted)">{s.text}</p>
      </li>
    ))}
  </ol>
</section>
