---
// Weekly competitions with a countdown to the next one (motion.ts, UK time; without JS just the day and time), over
// photo 5, then the league cup's draw. The draw's results are made up and say so.
import type { Demo } from '@/templates'
import { Image } from 'astro:assets'
import { photos } from './media'
const { d } = Astro.props as { d: Demo }
const events = d.events ?? []
const t = d.teams ?? []
const pic = photos(d.slug)[4]
const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']
const clock = (hm: string) => { const [h, m] = hm.split(':').map(Number); return `${h % 12 || 12}${m ? `:${String(m).padStart(2, '0')}` : ''}${h < 12 ? 'am' : 'pm'}` }
const par = (s?: number) => (s === undefined ? '' : s < 0 ? `−${-s}` : s === 0 ? 'E' : `+${s}`)
type Side = { team?: string; score?: number }
type Game = [Side, Side]
// Sixteen teams, two halves meeting in the middle. Last 16 and quarter-finals played; semis next, then the final.
const game = (a?: string, b?: string, s?: number[]): Game => [{ team: a, score: s?.[0] }, { team: b, score: s?.[1] }]
const winner = (g: Game) => (g[0].score! < g[1].score! ? g[0] : g[1]).team
const last16 = [[-5, -2], [-1, -3], [-6, -4], [-2, -1], [-4, -3], [-2, -5], [-3, -1], [-1, -4]].map((s, i) => game(t[2 * i], t[2 * i + 1], s))
const quarters = [[-4, -2], [-3, -5], [-6, -3], [-2, -4]].map((s, i) => game(winner(last16[2 * i]), winner(last16[2 * i + 1]), s))
const semis = [0, 1].map((i) => game(winner(quarters[2 * i]), winner(quarters[2 * i + 1])))
const cols: { name: string; side: 'l' | 'r' | 'c'; games: Game[] }[] = [
  { name: 'Last 16', side: 'l', games: last16.slice(0, 4) },
  { name: 'Quarters', side: 'l', games: quarters.slice(0, 2) },
  { name: 'Semi', side: 'l', games: [semis[0]] },
  { name: 'Final', side: 'c', games: [game()] },
  { name: 'Semi', side: 'r', games: [semis[1]] },
  { name: 'Quarters', side: 'r', games: quarters.slice(2) },
  { name: 'Last 16', side: 'r', games: last16.slice(4) },
]
const won = (g: Game, i: number) => g[0].score !== undefined && g[1].score !== undefined && g[i].score! < g[1 - i].score!
// Bracket lines, drawn by each pair of games toward the next round (gap-x-6, so the line runs 0.75rem + 0.75rem).
// --draw lets motion.ts grow them out of the cards (pseudo-elements can't be tweened); without JS it stays 1.
const line = 'after:absolute after:border-(--fg)/25 after:scale-y-(--draw,1) before:absolute before:top-1/2 before:border-t before:border-(--fg)/25 before:scale-x-(--draw,1)'
const lines = {
  l: { 2: 'before:origin-left after:inset-y-1/4 after:-right-3 after:w-3 after:rounded-r-lg after:border-y after:border-r before:-right-6 before:w-3', 1: 'before:origin-left before:-right-6 before:w-6' },
  r: { 2: 'before:origin-right after:inset-y-1/4 after:-left-3 after:w-3 after:rounded-l-lg after:border-y after:border-l before:-left-6 before:w-3', 1: 'before:origin-right before:-left-6 before:w-6' },
}
---
<section id="tournaments" class="px-4 py-24 sm:px-8 sm:py-32">
  <div class="mx-auto max-w-7xl">
    <div class="relative isolate flex min-h-[26rem] flex-col justify-end overflow-hidden rounded-3xl p-6 sm:p-10">
      {pic && <div class="absolute inset-0 -z-10 overflow-hidden"><Image src={pic} alt="" widths={[800, 1400, 2000]} sizes="(min-width: 1280px) 80rem, 100vw" data-parallax class="h-[124%] w-full object-cover" /></div>}
      <div class="absolute inset-0 -z-10 bg-linear-to-t from-(--bg) via-(--bg)/40 to-transparent"></div>
      <p class="font-(family-name:--display) text-sm font-black tracking-wide text-(--accent) uppercase">Every week</p>
      <h2 data-split class="mt-3 font-(family-name:--display) text-[clamp(2.25rem,8vw,5.5rem)] leading-[0.9] font-black tracking-[-0.03em] uppercase">Tournaments</h2>
    </div>
    <ul class="mt-6 grid gap-px overflow-hidden rounded-3xl bg-(--fg)/10 sm:grid-cols-2">
      {events.map((e) => (
        <li data-rise class="flex flex-col bg-(--panel) p-6 transition-colors hover:bg-(--fg)/[0.06] sm:p-8">
          <p class="text-sm font-semibold tracking-widest text-(--muted) uppercase">{days[e.day]} · {clock(e.time)}</p>
          <h3 class="mt-3 font-(family-name:--display) text-2xl leading-tight font-black tracking-[-0.02em] uppercase sm:text-3xl">{e.title}</h3>
          <p class="mt-3 max-w-sm text-(--muted)">{e.text}</p>
          <p data-countdown data-day={e.day} data-time={e.time} class="mt-auto pt-8 font-(family-name:--display) text-lg font-black text-(--accent) empty:hidden"></p>
        </li>
      ))}
    </ul>
  </div>
  <div class="mx-auto mt-24 max-w-[86rem]">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h3 class="font-(family-name:--display) text-[clamp(1.75rem,5vw,3.25rem)] leading-none font-black tracking-[-0.03em] uppercase">The league cup</h3>
      <p class="text-sm text-(--muted)">Example draw and scores, against par.</p>
    </div>
    <div tabindex="0" role="region" aria-label="League cup draw" data-lenis-prevent-horizontal class="-mx-4 mt-8 snap-x snap-mandatory scroll-px-4 overflow-x-auto px-4 pb-4 [scrollbar-color:var(--accent)_transparent] [scrollbar-width:none] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--accent) sm:-mx-8 sm:scroll-px-8 sm:px-8 sm:[scrollbar-width:thin] xl:mx-0 xl:overflow-visible xl:px-0">
      <div data-cup class="grid w-max grid-cols-[repeat(7,11rem)] gap-x-6 xl:w-auto xl:grid-cols-7">
        {cols.map((c, ci) => <h4 id={`cup-${ci}`} class:list={['text-xs font-semibold tracking-widest uppercase', c.side === 'c' ? 'text-center text-(--accent)' : 'text-(--muted)', c.side === 'r' && 'text-right']}>{c.name}</h4>)}
        {cols.map((c, ci) => (
          <div data-cup-col={Math.abs(ci - 3)} data-side={ci < 3 ? 1 : -1} role="group" aria-labelledby={`cup-${ci}`} class="mt-4 flex min-h-[30rem] snap-start flex-col">
            {Array.from({ length: Math.ceil(c.games.length / 2) }, (_, p) => c.games.slice(p * 2, p * 2 + 2)).map((pair) => (
              <ul data-cup-pair class:list={['relative flex flex-1 flex-col justify-around', c.side !== 'c' && [line, lines[c.side][pair.length as 1 | 2]]]}>
                {pair.map((g) => (
                  <li data-cup-game class:list={['my-2 rounded-xl border bg-(--panel) text-xs xl:text-[0.8125rem]', c.side === 'c' ? 'border-(--accent) shadow-[0_0_40px_-10px_var(--accent)]' : 'border-(--fg)/15']}>
                    {g.map((side, i) => (
                      <p data-cup-side={won(g, i) ? 'win' : side.score !== undefined ? 'lose' : undefined} class:list={['flex items-center justify-between gap-2 px-3 py-2.5', i && 'border-t border-(--fg)/10', won(g, i) ? 'font-bold text-(--accent)' : side.score !== undefined && 'opacity-55']}>
                        <span class="line-clamp-2 leading-tight" title={side.team}>{side.team ?? 'To be decided'}</span>
                        <span data-score={side.score} class="font-(family-name:--display) text-xs font-black tabular-nums">{par(side.score) || (side.team ? 'Next' : '')}</span>
                      </p>
                    ))}
                  </li>
                ))}
              </ul>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
