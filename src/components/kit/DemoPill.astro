---
// tebeck's own label on every example site: what this is, and the way back.
import { site } from '@/site'
---
<aside id="demo-pill" aria-label="About this example" class="fixed right-3 bottom-3 z-50 flex items-center gap-1 rounded-full bg-black/85 p-1 pl-4 font-sans text-sm text-white shadow-lg backdrop-blur sm:right-5 sm:bottom-5">
  <a href="/templates" target="_top" class="py-2 pr-2 hover:underline">← Example<span class="hidden sm:inline"> by {site.name}</span></a>
  <a href="/#contact" target="_top" class="rounded-full bg-white px-4 py-2 font-semibold whitespace-nowrap text-black">Get one like this</a>
</aside>
<!-- Inside the home's preview window the frame already says what this is: no label there. -->
<script is:inline>if (self !== top) document.getElementById('demo-pill')?.remove()</script>
