---
// Brand mark: TB monogram, the T's crossbar runs into the B. Same shapes as public/favicon.svg.
const { class: cls = 'size-9' } = Astro.props
---

<svg viewBox="0 0 32 32" aria-hidden="true" class={cls}>
  <rect width="32" height="32" rx="7" style="fill: var(--color-accent)"></rect>
  <path d="M5.6 8h15a3.5 3.5 0 0 1 0 7h-6M14.6 15h7a4.5 4.5 0 0 1 0 9h-7M14.6 8v16" fill="none" style="stroke: var(--color-on-accent)" stroke-width="3.6" stroke-linejoin="round" stroke-linecap="square"></path>
</svg>
