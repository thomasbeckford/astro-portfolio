---
// Brand: the "tebeck" wordmark, hand-built from round strokes (no font), its full stop in the brand terracotta (tebeck.dev).
// public/favicon.svg is the short form, "t.". Strokes are centerlines on a baseline at y=100, x-height 34..100.
// `animated`: once per load the word writes itself stroke by stroke, in pen order, then the dot drops in and bounces;
// after that the dot breathes, and every few seconds it turns into a little bug that hops along the tops of the letters
// to the t (each letter dips as it lands) and leaps back home. Off by default: a logo that moves on every
// page gets tiring. Hovering the link always runs a wave through the letters and the dot jumps at the end of it.
const { class: cls = 'text-2xl', animated = false } = Astro.props

// [letter x offset, strokes in pen order]
const letters: [number, string[]][] = [
  [0, ['M14 -2 V66 A25 25 0 0 0 39 91 H44', 'M0 34 H40']],
  [52, ['M9 66 H59 A25 25 0 1 0 51.7 83.7']],
  [124, ['M9 -6 V91', 'M9 66 A25 25 0 1 1 9 66.01']],
  [196, ['M9 66 H59 A25 25 0 1 0 51.7 83.7']],
  [268, ['M51.7 48.3 A25 25 0 1 0 51.7 83.7']],
  [334, ['M9 -6 V91', 'M52 34 L12 72', 'M28 58 L54 91']],
]
let n = 0
---

<span class:list={['wordmark', animated && 'wordmark-play', cls]}>
  <span class="sr-only">tebeck</span>
  <svg aria-hidden="true" viewBox="-10 -16 450 126">
    {
      letters.map(([x, strokes], i) => (
        <g style={`--i:${i}`}>
          {strokes.map((d) => (
            <path d={d} transform={`translate(${x} 0)`} pathLength="1" style={`--s:${n++}`} />
          ))}
        </g>
      ))
    }
    <g class="wordmark-hop"><circle class="wordmark-dot" cx="420" cy="91" r="18" /></g>
  </svg>
</span>

<script>
  // The dot's walk (see the header). Stops are the dot's centre resting on a letter top: stroke top minus half the
  // stroke (9) minus the dot's radius (18). [x, y, letter index that dips].
  const HOME = [420, 91]
  // Only x-height tops, and low arcs: the ascenders would carry it out of the nav's pill.
  const STOPS = [[386, 7, 5], [302, 14, 4], [230, 14, 3], [170, 14, 2], [86, 14, 1], [40, 7, 0]]
  const HOP = 340, REST = 160, LOOK = 700, LEAP = 900

  function tour(svg: SVGSVGElement) {
    const dot = svg.querySelector<SVGGElement>('.wordmark-hop')!
    const letters = svg.querySelectorAll<SVGGElement>('g[style*="--i"]')
    const frames: Keyframe[] = []
    let t = 0
    const at = (x: number, y: number, scale: string) => frames.push({ offset: t, translate: `${x - HOME[0]}px ${y - HOME[1]}px`, scale })
    const hop = (a: number[], b: number[], ms: number, h: number) => {
      const t0 = t
      for (let i = 1; i <= 10; i++) {
        const k = i / 10
        t = t0 + ms * k
        const s = k < 0.2 ? '0.9 1.15' : k === 1 ? '1.25 0.75' : '1'
        at(a[0] + (b[0] - a[0]) * k, a[1] + (b[1] - a[1]) * k - 4 * h * k * (1 - k), s)
      }
    }
    at(HOME[0], HOME[1], '1')
    t = 120
    at(HOME[0], HOME[1], '1.2 0.8')
    let from = HOME
    const dips: [number, number][] = []
    for (const s of STOPS) {
      hop(from, s, HOP, 24)
      dips.push([t, s[2]])
      t += REST
      at(s[0], s[1], '1')
      from = s
    }
    t += LOOK
    at(from[0], from[1], '1.2 0.8')
    // Home in two goes: a long leap back onto the k's arm, then down to the baseline (straight home would cut the k's leg).
    hop(from, STOPS[0], LEAP, 35)
    dips.push([t, STOPS[0][2]])
    t += REST
    at(STOPS[0][0], STOPS[0][1], '1')
    hop(STOPS[0], HOME, HOP, 20)
    t += 220
    at(HOME[0], HOME[1], '1')
    const total = t
    for (const f of frames) f.offset = (f.offset as number) / total
    dot.animate(frames, { duration: total })
    for (const [ms, i] of dips)
      letters[i]?.animate([{ translate: '0 0' }, { translate: '0 7px' }, { translate: '0 0' }], { duration: 260, delay: ms, easing: 'ease-out' })
    return total
  }

  // Keepy-uppy: the k's leg (knee at 362,58) kicks the dot straight up, a few times, higher each time.
  function juggle(svg: SVGSVGElement) {
    const dot = svg.querySelector<SVGGElement>('.wordmark-hop')!
    const leg = svg.querySelectorAll<SVGGElement>('g[style*="--i"]')[5]?.querySelectorAll('path')[2]
    if (!leg) return 0
    leg.style.transformBox = 'view-box'
    leg.style.transformOrigin = '362px 58px'
    const frames: Keyframe[] = [{ offset: 0, translate: '0 0', scale: '1' }]
    let t = 0
    const kicks: number[] = []
    for (const h of [40, 52, 70]) {
      kicks.push(t)
      t += 90
      frames.push({ offset: t, translate: '0 0', scale: '0.85 1.2' })
      const up = 140 + h * 3
      for (let i = 1; i <= 10; i++) {
        const k = i / 10
        frames.push({ offset: t + up * 2 * k, translate: `0 ${-4 * h * k * (1 - k)}px`, scale: k === 1 ? '1.25 0.75' : '1' })
      }
      t += up * 2 + 60
      frames.push({ offset: t, translate: '0 0', scale: '1' })
    }
    t += 160
    frames.push({ offset: t, translate: '0 0', scale: '1' })
    for (const f of frames) f.offset = (f.offset as number) / t
    dot.animate(frames, { duration: t })
    for (const ms of kicks)
      leg.animate([{ rotate: '0deg' }, { rotate: '-35deg', offset: 0.35 }, { rotate: '0deg' }], { duration: 300, delay: ms, easing: 'ease-out' })
    return t
  }

  if (matchMedia('(prefers-reduced-motion: no-preference)').matches)
    for (const svg of document.querySelectorAll<SVGSVGElement>('.wordmark-play svg')) {
      let n = 0 // alternate: walk, juggle, walk...
      const loop = () => setTimeout(() => loop(), document.hidden ? 2000 : (n++ % 2 ? juggle(svg) : tour(svg)) + 7000) // hidden tab: just check again later
      setTimeout(loop, 4200) // after the write-in and the drop
    }
</script>
