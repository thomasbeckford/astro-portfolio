---
// Boti, the site's robot: stills of the hero's 3D robot (scripts/robot.ts), baked at 4x and downscaled so they stay crisp.
// 'mini' is head and shoulders, for avatars. data-mood is the hook scripts flip ('thinking' tilts, 'done' cheers on
// the full body). The eyes are baked in the electrician yellow the hero starts on, so they don't follow the trade accent.
import { Image } from 'astro:assets'
import head from '@/assets/boti/head.png'
import full from '@/assets/boti/full.png'
import cheer from '@/assets/boti/cheer.png'
interface Props {
  mood?: 'hello' | 'thinking' | 'done' | 'oops' | 'mini'
  class?: string
  id?: string
}
const { mood = 'hello', class: cls, id } = Astro.props
const mini = mood === 'mini'
---

<span class:list={['relative inline-block', cls]} id={id} data-mood={mini ? 'hello' : mood} aria-hidden="true">
  {
    mini ? (
      <Image src={head} width={64} densities={[1, 2]} alt="" class="boti-main block h-auto w-full" />
    ) : (
      <>
        <Image src={full} width={160} densities={[1, 2]} alt="" class="boti-main block h-auto w-full" />
        <Image src={cheer} width={160} densities={[1, 2]} alt="" loading="lazy" class="boti-cheer absolute inset-0 h-auto w-full" />
      </>
    )
  }
</span>
