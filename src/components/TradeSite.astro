---
// The demo site inside the phone. Each trade is its own whole design (trade.style), all rendered up front with
// the first one showing; the home hero script flips them by data-trade and fills the data-k slots as you type.
// The art is SVG and CSS, no photos: these businesses are made up, so nothing here pretends to be a real job.
import '@fontsource-variable/oswald'
import '@fontsource-variable/fraunces'
import Icon from '@/components/Icon.astro'
import type { Trade } from '@/trades'

const { trades, area = 'Bromley' } = Astro.props as { trades: Trade[]; area?: string }
const lede = (t: Trade) => t.lede.replace('{area}', area)
// "{area}" inside a point becomes a live slot.
const bits = (s: string) => s.split('{area}')
const price = (s: string) => s.split('|')
const tel = '07700 900412'
// Status bar ink per design, so the clock and battery read on each background.
const ink: Record<string, string> = { volt: '#fafafa', flow: '#fff', slate: '#0a0a0a', brew: '#fafaf9', bloom: '#2a0a1f', grove: '#ecfccb', redo: '#0a0a0a' }
---

<div id="try-site" aria-hidden="true" class="@container relative aspect-[9/19.5] overflow-hidden bg-black text-left">
  {
    trades.map((t, i) => (
      <div data-trade={i} hidden={i !== 0} class="ts absolute inset-0 flex flex-col overflow-hidden [&>div:last-child]:pt-[11cqw]">
        {/* Phone chrome on top of the site: clock, dynamic island, signal, battery; home bar at the bottom. */}
        <div class="absolute inset-x-0 top-0 z-10 flex h-[11cqw] items-center justify-between px-[7cqw] text-[3.6cqw] font-semibold" style={`color:${ink[t.style]}`}>
          <span class="font-sans tracking-tight">9:41</span>
          <span class="absolute top-[2.4cqw] left-1/2 h-[7cqw] w-[28cqw] -translate-x-1/2 rounded-full bg-black" />
          <span class="flex items-center gap-[1.2cqw]">
            <svg viewBox="0 0 18 12" class="h-[2.8cqw]" fill="currentColor"><rect x="0" y="8" width="3" height="4" rx="1" /><rect x="5" y="5.5" width="3" height="6.5" rx="1" /><rect x="10" y="3" width="3" height="9" rx="1" /><rect x="15" y="0" width="3" height="12" rx="1" /></svg>
            <svg viewBox="0 0 16 12" class="h-[2.8cqw]" fill="currentColor"><path d="M8 2.2c2.3 0 4.4.9 6 2.4l1.3-1.4A10.5 10.5 0 0 0 8 .3 10.5 10.5 0 0 0 .7 3.2L2 4.6a8.6 8.6 0 0 1 6-2.4Zm0 3.8c1.3 0 2.5.5 3.4 1.3l1.3-1.4A6.8 6.8 0 0 0 8 4.1a6.8 6.8 0 0 0-4.7 1.8l1.3 1.4C5.5 6.5 6.7 6 8 6Zm0 3.7 2-2.1a3 3 0 0 0-4 0l2 2.1Z" /></svg>
            <svg viewBox="0 0 27 13" class="h-[3cqw]" fill="none"><rect x="0.5" y="0.5" width="23" height="12" rx="3.5" stroke="currentColor" opacity=".4" /><rect x="2" y="2" width="18" height="9" rx="2" fill="currentColor" /><path d="M25 4.5v4c.8-.3 1.5-1.1 1.5-2s-.7-1.7-1.5-2Z" fill="currentColor" opacity=".4" /></svg>
          </span>
        </div>
        <span class="absolute bottom-[1.6cqw] left-1/2 z-10 h-[1.3cqw] w-[36cqw] -translate-x-1/2 rounded-full opacity-80" style={`background:${ink[t.style]}`} />
        {t.style === 'volt' && (
          /* Electrician: control-panel HUD. Black, hazard yellow, mono, a live circuit trace. */
          <div class="relative flex h-full flex-col bg-[#09090b] font-mono text-[#f4f4f5]">
            <div class="absolute inset-0 bg-[linear-gradient(#facc1514_1px,transparent_1px),linear-gradient(90deg,#facc1514_1px,transparent_1px)] bg-size-[8cqw_8cqw]" />
            <div class="relative h-[2.2cqw] bg-[repeating-linear-gradient(-45deg,#facc15_0_3cqw,#09090b_3cqw_6cqw)]" />
            <div class="relative flex items-center justify-between px-[5cqw] py-[4cqw]">
              <div class="min-w-0">
                <p data-k="name" class="truncate text-[5.2cqw] font-bold tracking-tight uppercase">{t.demo}</p>
                <p class="mt-[0.5cqw] text-[3cqw] text-[#facc15]"><span class="ts-blink">●</span> ONLINE · <span data-k="area">{area}</span></p>
              </div>
              <span class="grid size-[11cqw] shrink-0 place-items-center bg-[#facc15] text-[#09090b]"><Icon name="phone" class="size-[5cqw]" /></span>
            </div>
            <div class="relative px-[5cqw]">
              <p class="text-[3cqw] tracking-[0.3em] text-[#a1a1aa]">// <span data-k="trade">{t.name}</span>.SYS</p>
              <p data-k="head" class="mt-[3cqw] font-sans text-[12cqw] leading-[0.88] font-extrabold tracking-[-0.04em] uppercase">{t.head}</p>
              <svg viewBox="0 0 200 40" class="mt-[4cqw] w-full" fill="none" stroke="#facc15" stroke-width="1.5">
                <path class="ts-trace" pathLength="1" d="M0 30h40l8-18h30l6 18h50l10-24h20l6 24h30" />
                <circle cx="200" cy="30" r="3" fill="#facc15" />
              </svg>
              <p data-k="lede" class="mt-[3cqw] text-[3.6cqw] leading-snug text-[#a1a1aa]">{lede(t)}</p>
              <span class="mt-[5cqw] flex items-center justify-center gap-[2cqw] bg-[#facc15] py-[3.8cqw] text-[4cqw] font-bold text-[#09090b] uppercase shadow-[1.5cqw_1.5cqw_0_#facc1544]"><Icon name="phone" class="size-[4cqw]" />Call {tel}</span>
              <span class="mt-[3cqw] flex justify-center py-[3.4cqw] text-[3.8cqw] font-bold uppercase ring-1 ring-[#facc15]/60 ring-inset">[ <span data-k="cta">{t.cta}</span> ]</span>
              <ul class="mt-[5cqw] grid gap-[1.2cqw] text-[3.3cqw]">
                {t.points.map((pt, n) => <li class="flex gap-[2cqw]"><span class="text-[#facc15]">{String(n + 1).padStart(2, '0')}</span><span>{bits(pt).map((p, j) => <>{j > 0 && <span data-k="area">{area}</span>}{p}</>)}</span></li>)}
              </ul>
              <p class="mt-[4cqw] flex flex-wrap gap-[1.5cqw] text-[3cqw] uppercase">{t.extra.items.map((x) => <span class="px-[2cqw] py-[1cqw] ring-1 ring-[#3f3f46]">{x}</span>)}</p>
            </div>
            <p class="relative mt-auto overflow-hidden px-[3cqw] font-sans text-[30cqw] leading-[0.75] font-extrabold tracking-[-0.06em] text-transparent uppercase [-webkit-text-stroke:0.3cqw_#facc1566]" data-k="trade">{t.name}</p>
          </div>
        )}

        {t.style === 'flow' && (
          /* Plumber: deep water. Glass panels, moving waves, an always-on call badge. */
          <div class="relative flex h-full flex-col bg-[radial-gradient(120%_60%_at_100%_0%,#0e7490,transparent),linear-gradient(#082f49,#020617)] font-sans text-white">
            <svg viewBox="0 0 400 60" preserveAspectRatio="none" class="absolute bottom-0 h-[28%] w-[200%] text-[#22d3ee]/15">
              <path class="ts-wave" fill="currentColor" d="M0 30q50-25 100 0t100 0 100 0 100 0V60H0z" />
            </svg>
            <svg viewBox="0 0 400 60" preserveAspectRatio="none" class="absolute bottom-0 h-[20%] w-[200%] text-[#22d3ee]/25">
              <path class="ts-wave ts-slow" fill="currentColor" d="M0 30q50 25 100 0t100 0 100 0 100 0V60H0z" />
            </svg>
            <div class="relative mx-[4cqw] mt-[4cqw] flex items-center justify-between rounded-[5cqw] bg-white/10 px-[4cqw] py-[3cqw] ring-1 ring-white/15 backdrop-blur-md">
              <div class="min-w-0">
                <p data-k="name" class="truncate text-[5cqw] font-bold tracking-tight">{t.demo}</p>
                <p class="truncate text-[3cqw] text-white/60"><span data-k="trade">{t.name}</span> · <span data-k="area">{area}</span></p>
              </div>
              <span class="grid size-[10cqw] shrink-0 place-items-center rounded-full bg-[#22d3ee] text-[#082f49]"><Icon name="phone" class="size-[4.6cqw]" /></span>
            </div>
            <div class="relative px-[5cqw] pt-[8cqw]">
              <span class="inline-flex items-center gap-[1.5cqw] rounded-full bg-[#22d3ee]/15 px-[3cqw] py-[1.2cqw] text-[3cqw] font-semibold text-[#67e8f9] ring-1 ring-[#22d3ee]/40"><span class="ts-ping size-[1.8cqw] rounded-full bg-[#22d3ee]" />On call now</span>
              <p data-k="head" class="mt-[4cqw] text-[10.5cqw] leading-[0.95] font-extrabold tracking-[-0.04em] text-balance">{t.head}</p>
              <p data-k="lede" class="mt-[3cqw] text-[3.9cqw] leading-snug text-white/70">{lede(t)}</p>
              <span class="mt-[6cqw] flex items-center justify-center gap-[2cqw] rounded-full bg-[#22d3ee] py-[3.8cqw] text-[4.2cqw] font-bold text-[#082f49] shadow-[0_0_8cqw_#22d3ee66]"><Icon name="phone" class="size-[4.2cqw]" />Call {tel}</span>
              <span class="mt-[2.5cqw] flex justify-center rounded-full bg-white/10 py-[3.5cqw] text-[4cqw] font-semibold ring-1 ring-white/20 backdrop-blur"><span data-k="cta">{t.cta}</span>&nbsp;→</span>
              <div class="mt-[5cqw] rounded-[5cqw] bg-white/[0.07] p-[4cqw] ring-1 ring-white/15 backdrop-blur-md">
                <p class="text-[3cqw] font-semibold tracking-[0.15em] text-[#67e8f9] uppercase">{t.extra.label}</p>
                <p class="mt-[1cqw] text-[3.8cqw]">{t.extra.items[0]}</p>
              </div>
              <ul class="mt-[4cqw] space-y-[1.2cqw] text-[3.5cqw] text-white/80">
                {t.points.map((pt) => <li><span class="text-[#22d3ee]">◆</span> {bits(pt).map((p, j) => <>{j > 0 && <span data-k="area">{area}</span>}{p}</>)}</li>)}
              </ul>
            </div>
          </div>
        )}

        {t.style === 'slate' && (
          /* Roofer: brutalist poster. Concrete grey, signal red, condensed type, hard rules. */
          <div class="flex h-full flex-col bg-[#e4e4e7] font-['Oswald_Variable',sans-serif] text-[#0a0a0a]">
            <div class="flex items-stretch border-b-[0.8cqw] border-[#0a0a0a]">
              <div class="min-w-0 flex-1 px-[4cqw] py-[3cqw]">
                <p data-k="name" class="truncate text-[6cqw] leading-none font-bold uppercase">{t.demo}</p>
                <p class="mt-[1cqw] truncate text-[3cqw] tracking-[0.1em] uppercase"><span data-k="trade">{t.name}</span> / <span data-k="area">{area}</span></p>
              </div>
              <span class="grid w-[15cqw] place-items-center bg-[#dc2626] text-white"><Icon name="phone" class="size-[5.5cqw]" /></span>
            </div>
            <svg viewBox="0 0 100 14" preserveAspectRatio="none" class="h-[6cqw] w-full" fill="#0a0a0a"><path d="M0 14 10 2l10 12L30 2l10 12L50 2l10 12L70 2l10 12L90 2l10 12z" /></svg>
            <div class="px-[4cqw] pt-[3cqw]">
              <p class="inline-block bg-[#0a0a0a] px-[2cqw] text-[3.2cqw] tracking-[0.15em] text-white uppercase">No. 01 · <span data-k="area">{area}</span></p>
              <p data-k="head" class="mt-[2cqw] text-[14cqw] leading-[0.86] font-bold tracking-[-0.01em] uppercase">{t.head}</p>
              <p data-k="lede" class="mt-[3cqw] font-sans text-[3.7cqw] leading-snug font-medium text-[#3f3f46]">{lede(t)}</p>
              <span class="mt-[5cqw] flex items-center justify-center gap-[2cqw] bg-[#0a0a0a] py-[3.6cqw] text-[5cqw] tracking-wide text-white uppercase"><Icon name="phone" class="size-[4.6cqw]" />{tel}</span>
              <span class="mt-[2cqw] flex justify-center bg-[#dc2626] py-[3.4cqw] text-[4.6cqw] tracking-wide text-white uppercase"><span data-k="cta">{t.cta}</span>&nbsp;→</span>
              <ol class="mt-[4cqw] border-t-[0.6cqw] border-[#0a0a0a] font-sans text-[3.5cqw] font-semibold">
                {t.points.map((pt, n) => <li class="flex gap-[3cqw] border-b border-[#0a0a0a]/25 py-[1.6cqw]"><span class="font-['Oswald_Variable'] text-[#dc2626]">0{n + 1}</span><span>{bits(pt).map((p, j) => <>{j > 0 && <span data-k="area">{area}</span>}{p}</>)}</span></li>)}
              </ol>
            </div>
            <div class="mt-auto overflow-hidden bg-[#0a0a0a] py-[2.5cqw] text-[5cqw] tracking-wide whitespace-nowrap text-[#e4e4e7] uppercase"><p class="ts-wave inline-block w-max">{[0, 1].map(() => t.points.map((pt) => <span class="px-[3cqw]">{pt.replace('{area}', area)} <span class="text-[#dc2626]">■</span></span>))}</p></div>
          </div>
        )}

        {t.style === 'brew' && (
          /* Café: retro-futurist night menu. Ink black, hot orange, a spinning stamp, a receipt. */
          <div class="relative flex h-full flex-col bg-[#0c0a09] font-sans text-[#fafaf9]">
            <div class="absolute -top-[20cqw] -right-[20cqw] size-[70cqw] rounded-full bg-[#fb923c] blur-[18cqw] opacity-40" />
            <div class="relative flex items-center justify-between px-[5cqw] py-[4cqw]">
              <p data-k="name" class="truncate font-['Fraunces_Variable',serif] text-[6cqw] italic">{t.demo}</p>
              <span class="grid size-[10cqw] shrink-0 place-items-center rounded-full bg-[#fb923c] text-[#0c0a09]"><Icon name="phone" class="size-[4.6cqw]" /></span>
            </div>
            <div class="relative px-[5cqw] pt-[2cqw] text-center">
              <svg viewBox="0 0 100 100" class="ts-spin mx-auto size-[30cqw] text-[#fb923c]">
                <defs><path id={`ring-${i}`} d="M50 50m-38 0a38 38 0 1 1 76 0a38 38 0 1 1-76 0" /></defs>
                <text font-size="9.5" font-weight="700" letter-spacing="2.4" fill="currentColor"><textPath href={`#ring-${i}`}>FRESH COFFEE · OPEN FROM 7 · </textPath></text>
                <circle cx="50" cy="50" r="18" fill="currentColor" />
              </svg>
              <p class="mt-[2cqw] text-[3cqw] tracking-[0.3em] text-[#fb923c] uppercase"><span data-k="trade">{t.name}</span> · <span data-k="area">{area}</span></p>
              <p data-k="head" class="mt-[2cqw] font-['Fraunces_Variable',serif] text-[11cqw] leading-[0.95] font-semibold tracking-[-0.03em] text-balance">{t.head}</p>
              <p data-k="lede" class="mx-auto mt-[3cqw] max-w-[80cqw] text-[3.7cqw] leading-snug text-[#a8a29e]">{lede(t)}</p>
              <span class="mt-[5cqw] flex items-center justify-center gap-[2cqw] rounded-full bg-[#fb923c] py-[3.6cqw] text-[4.2cqw] font-bold text-[#0c0a09]"><span data-k="cta">{t.cta}</span>&nbsp;→</span>
              <div class="mt-[4cqw] rounded-[2cqw] bg-[#fafaf9] p-[4cqw] font-mono text-[3.3cqw] text-[#0c0a09] [mask:radial-gradient(1.6cqw_at_50%_0,transparent_98%,#000)_0_0/5cqw_100%_repeat-x]">
                <p class="text-center tracking-[0.2em] uppercase">{t.extra.label}</p>
                {t.extra.items.map((x) => <p class="mt-[1.5cqw] flex items-baseline gap-[1.5cqw]"><span>{price(x)[0]}</span><span class="flex-1 border-b border-dotted border-[#0c0a09]/40" /><span class="font-bold">{price(x)[1]}</span></p>)}
              </div>
            </div>
            <div class="relative mt-auto -rotate-3 overflow-hidden bg-[#fb923c] py-[2.5cqw] font-['Fraunces_Variable',serif] text-[5.5cqw] whitespace-nowrap text-[#0c0a09] italic"><p class="ts-wave inline-block w-max">{[0, 1].map(() => t.points.map((pt) => <span class="px-[3cqw]">{pt} ✺</span>))}</p></div>
            <div class="h-[6cqw]" />
          </div>
        )}

        {t.style === 'bloom' && (
          /* Salon: holographic chrome. Drifting colour blobs, glass slots, pill everything. */
          <div class="relative flex h-full flex-col overflow-hidden bg-[#fdf2f8] font-sans text-[#2a0a1f]">
            <div class="ts-drift absolute -top-[15cqw] -left-[20cqw] size-[75cqw] rounded-full bg-[#f472b6] blur-[14cqw] opacity-70" />
            <div class="ts-drift ts-slow absolute top-[40%] -right-[25cqw] size-[70cqw] rounded-full bg-[#a78bfa] blur-[14cqw] opacity-60" />
            <div class="relative flex items-center justify-between px-[5cqw] py-[4cqw]">
              <p data-k="name" class="truncate font-['Fraunces_Variable',serif] text-[6cqw] font-medium">{t.demo}</p>
              <span class="grid size-[10cqw] shrink-0 place-items-center rounded-full bg-[#2a0a1f] text-white"><Icon name="phone" class="size-[4.6cqw]" /></span>
            </div>
            <div class="relative px-[5cqw] pt-[8cqw] text-center">
              <span class="inline-block rounded-full bg-white/50 px-[3cqw] py-[1.2cqw] text-[3cqw] font-semibold tracking-[0.15em] uppercase ring-1 ring-white backdrop-blur"><span data-k="trade">{t.name}</span> · <span data-k="area">{area}</span></span>
              <p data-k="head" class="mt-[4cqw] bg-[linear-gradient(100deg,#2a0a1f_20%,#be185d_45%,#7c3aed_60%,#2a0a1f_85%)] bg-clip-text font-['Fraunces_Variable',serif] text-[12.5cqw] leading-[0.92] font-semibold tracking-[-0.04em] text-balance text-transparent">{t.head}</p>
              <p data-k="lede" class="mx-auto mt-[3cqw] max-w-[80cqw] text-[3.8cqw] leading-snug text-[#2a0a1f]/70">{lede(t)}</p>
              <span class="mt-[6cqw] flex items-center justify-center gap-[2cqw] rounded-full bg-[#2a0a1f] py-[3.8cqw] text-[4.2cqw] font-semibold text-white"><span data-k="cta">{t.cta}</span>&nbsp;✦</span>
              <div class="mt-[5cqw] rounded-[6cqw] bg-white/45 p-[4cqw] ring-1 ring-white backdrop-blur-md">
                <p class="text-[3cqw] font-semibold tracking-[0.15em] uppercase">{t.extra.label}</p>
                <p class="mt-[2.5cqw] flex justify-center gap-[2cqw]">{t.extra.items.map((x, n) => <span class:list={['rounded-full px-[3cqw] py-[1.5cqw] text-[3.4cqw] font-semibold', n === 0 ? 'bg-[#be185d] text-white' : 'bg-white/70']}>{x}</span>)}</p>
              </div>
              <p class="mt-[4cqw] text-[3.3cqw] text-[#2a0a1f]/70">{t.points.join(' · ')}</p>
            </div>
            <svg viewBox="0 0 100 100" class="ts-spin relative mx-auto mt-auto mb-[-14cqw] size-[60cqw] text-white/70"><path fill="currentColor" d="M50 0C54 38 62 46 100 50 62 54 54 62 50 100 46 62 38 54 0 50 38 46 46 38 50 0Z" /></svg>
          </div>
        )}

        {t.style === 'grove' && (
          /* Gardener: survey map. Forest dark, lime, topographic contour lines, soft rounded panels. */
          <div class="relative flex h-full flex-col bg-[#052e16] font-sans text-[#ecfccb]">
            <svg viewBox="0 0 100 200" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 size-full text-[#a3e635]/15" fill="none" stroke="currentColor" stroke-width="0.4">
              {[10, 18, 26, 34, 42, 50, 58].map((r) => <ellipse cx="78" cy="40" rx={r} ry={r * 0.7} transform={`rotate(-20 78 40)`} />)}
              {[8, 15, 22, 29, 36].map((r) => <ellipse cx="15" cy="160" rx={r * 1.2} ry={r} />)}
            </svg>
            <div class="relative flex items-center justify-between px-[5cqw] py-[4cqw]">
              <div class="min-w-0">
                <p data-k="name" class="truncate text-[5.4cqw] font-semibold tracking-tight lowercase">{t.demo}</p>
                <p class="truncate text-[3cqw] text-[#a3e635] lowercase"><span data-k="trade">{t.name}</span> · <span data-k="area">{area}</span></p>
              </div>
              <span class="grid size-[10cqw] shrink-0 place-items-center rounded-[3cqw] bg-[#a3e635] text-[#052e16]"><Icon name="phone" class="size-[4.6cqw]" /></span>
            </div>
            <div class="relative px-[5cqw] pt-[10cqw]">
              <p class="font-mono text-[2.8cqw] tracking-[0.2em] text-[#a3e635] uppercase">Garden care · <span data-k="area">{area}</span></p>
              <p data-k="head" class="mt-[3cqw] text-[11.5cqw] leading-[0.92] font-bold tracking-[-0.05em] lowercase">{t.head}</p>
              <p data-k="lede" class="mt-[3cqw] text-[3.8cqw] leading-snug text-[#ecfccb]/70">{lede(t)}</p>
              <span class="mt-[6cqw] flex items-center justify-center gap-[2cqw] rounded-[4cqw] bg-[#a3e635] py-[3.8cqw] text-[4.2cqw] font-bold text-[#052e16]"><Icon name="phone" class="size-[4.2cqw]" />Call {tel}</span>
              <span class="mt-[2.5cqw] flex justify-center rounded-[4cqw] py-[3.5cqw] text-[4cqw] font-semibold ring-1 ring-[#a3e635]/40 ring-inset"><span data-k="cta">{t.cta}</span>&nbsp;→</span>
              <div class="mt-[5cqw] grid grid-cols-[auto_1fr] items-center gap-[3cqw] rounded-[5cqw] bg-[#ecfccb]/[0.06] p-[4cqw] ring-1 ring-[#a3e635]/20">
                <span class="grid size-[9cqw] place-items-center rounded-full bg-[#a3e635]/15 text-[4.5cqw]">☀</span>
                <div class="text-[3.4cqw]"><p class="text-[#a3e635]">{t.extra.label}</p><p>{t.extra.items[0]}</p></div>
              </div>
              <ul class="mt-[4cqw] flex flex-wrap gap-[1.5cqw] text-[3.1cqw]">
                {t.points.map((pt) => <li class="rounded-full bg-[#ecfccb]/10 px-[2.5cqw] py-[1cqw]">{bits(pt).map((p, j) => <>{j > 0 && <span data-k="area">{area}</span>}{p}</>)}</li>)}
              </ul>
            </div>
            <p class="relative mt-auto px-[4cqw] pb-[2cqw] text-[24cqw] leading-[0.8] font-bold tracking-[-0.07em] text-[#a3e635]/15 lowercase" data-k="trade">{t.name}</p>
          </div>
        )}

        {t.style === 'redo' && (
          /* Redesign: a dated site (grey bevels, Times, blue links) that a scan line wipes into a clean new one.
             Both halves are made up; each wears a BEFORE / AFTER tag so nobody reads it as a real client. */
          <div class="relative h-full">
            <div class="absolute inset-0 flex flex-col items-center gap-[3cqw] bg-[#c0c0c0] px-[4cqw] pt-[14cqw] text-center font-['Times_New_Roman',Times,serif] text-black">
              <span class="absolute top-[13cqw] right-[3cqw] bg-black px-[1.5cqw] font-sans text-[2.6cqw] font-bold tracking-[0.15em] text-white">BEFORE</span>
              <p class="mt-[4cqw] w-full bg-[#ffff00] py-[1cqw] text-[3.4cqw] font-bold text-[#ff0000]">*** Welcome to our website! ***</p>
              <p data-k="name" class="text-[8cqw] leading-none font-bold text-[#000080] italic underline">{t.demo}</p>
              <p class="text-[3.6cqw]">Serving <span data-k="area">{area}</span> and surrounding areas</p>
              <p class="flex flex-wrap justify-center gap-x-[2.5cqw] text-[3.6cqw] text-[#0000ee] underline">{['Home', 'About Us', 'Services', 'Contact Us'].map((x) => <span>{x}</span>)}</p>
              <p class="w-full border-[0.8cqw] border-[#dfdfdf_#808080_#808080_#dfdfdf] bg-white p-[2.5cqw] text-left text-[3.3cqw] leading-tight">Please telephone us for more information regarding any of our services. We look forward to hearing from you.</p>
              <span class="border-[0.8cqw] border-[#dfdfdf_#808080_#808080_#dfdfdf] bg-[#c0c0c0] px-[4cqw] py-[1cqw] font-sans text-[3.4cqw]">Click Here</span>
              <p class="grid w-full flex-1 max-h-[45cqw] place-items-center border-[0.6cqw] border-[#808080_#dfdfdf_#dfdfdf_#808080] bg-[#d4d4d4] font-sans text-[3cqw] text-[#606060]">[ image: our_van.jpg ]</p>
              <p class="w-full bg-[repeating-linear-gradient(-45deg,#facc15_0_3cqw,#000_3cqw_6cqw)] py-[2cqw]"><span class="bg-[#facc15] px-[2cqw] font-sans text-[3.4cqw] font-bold">UNDER CONSTRUCTION</span></p>
              <p class="mt-auto pb-[6cqw] text-[2.8cqw] text-[#404040]">Best viewed in Internet Explorer at 800 x 600</p>
            </div>
            <div class="ts-after absolute inset-0 flex flex-col bg-white px-[5cqw] pt-[14cqw] font-sans text-[#0f172a]">
              <span class="absolute top-[13cqw] right-[3cqw] rounded-full bg-[#2563eb] px-[2cqw] py-[0.4cqw] text-[2.6cqw] font-bold tracking-[0.15em] text-white">AFTER</span>
              <div class="flex items-center gap-[3cqw] pt-[2cqw]">
                <span class="grid size-[10cqw] shrink-0 place-items-center rounded-[3cqw] bg-[#2563eb] text-white"><Icon name="phone" class="size-[4.6cqw]" /></span>
                <div class="min-w-0">
                  <p data-k="name" class="truncate text-[5cqw] font-bold tracking-tight">{t.demo}</p>
                  <p class="truncate text-[3cqw] text-[#64748b]"><span data-k="area">{area}</span> and nearby</p>
                </div>
              </div>
              <p data-k="head" class="mt-[8cqw] text-[11cqw] leading-[0.95] font-extrabold tracking-[-0.045em] text-balance">{t.head}</p>
              <p data-k="lede" class="mt-[3cqw] text-[3.9cqw] leading-snug text-[#475569]">{lede(t)}</p>
              <span class="mt-[6cqw] flex items-center justify-center gap-[2cqw] rounded-[3.5cqw] bg-[#2563eb] py-[3.8cqw] text-[4.2cqw] font-bold text-white shadow-[0_3cqw_8cqw_-3cqw_#2563eb]"><Icon name="phone" class="size-[4.2cqw]" />Call {tel}</span>
              <span class="mt-[2.5cqw] flex justify-center rounded-[3.5cqw] py-[3.5cqw] text-[4cqw] font-semibold ring-1 ring-[#cbd5e1] ring-inset"><span data-k="cta">{t.cta}</span>&nbsp;→</span>
              <ul class="mt-[5cqw] grid gap-[2cqw] text-[3.5cqw]">
                {t.points.map((pt) => <li class="flex items-center gap-[2.5cqw]"><span class="grid size-[5cqw] shrink-0 place-items-center rounded-full bg-[#2563eb]/10 text-[3cqw] text-[#2563eb]">✓</span><span>{bits(pt).map((p, j) => <>{j > 0 && <span data-k="area">{area}</span>}{p}</>)}</span></li>)}
              </ul>
              <p class="mt-[5cqw] flex items-center justify-between rounded-[3.5cqw] bg-[#f1f5f9] px-[4cqw] py-[3.5cqw] text-[3.4cqw]"><span class="font-semibold">Open today</span><span class="text-[#475569]">8am to 6pm</span></p>
            </div>
            <div class="ts-scan pointer-events-none absolute inset-0"><span class="block h-[0.8cqw] bg-[#60a5fa] shadow-[0_0_5cqw_1cqw_#60a5fa]" /></div>
          </div>
        )}
      </div>
    ))
  }
</div>

<style>
  /* Switching trades: the new site rises in. Everything moving here is decorative and stops for reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .ts:not([hidden]) {
      animation: ts-in 0.55s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .ts-blink {
      animation: ts-blink 1.2s steps(1) infinite;
    }
    .ts-trace {
      stroke-dasharray: 0.25 0.75;
      animation: ts-trace 2.4s linear infinite;
    }
    .ts-wave {
      animation: ts-wave 6s linear infinite;
    }
    .ts-slow {
      animation-duration: 10s;
      animation-direction: reverse;
    }
    .ts-ping {
      animation: ts-ping 1.6s ease-out infinite;
    }
    .ts-spin {
      animation: ts-spin 14s linear infinite;
    }
    .ts-drift {
      animation: ts-drift 9s ease-in-out infinite alternate;
    }
  }
  /* Redesign: still, it's split down the middle (new on top, old below). With motion, the old site shows first and the
     scan line wipes the new one in. ponytail: plays once per showing (ts-in restarts with [hidden]); on a landing it may
     finish before a phone visitor scrolls to it, which the still split covers well enough. */
  .ts-after {
    clip-path: inset(0 0 52% 0);
  }
  .ts-scan {
    translate: 0 48%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ts:not([hidden]) .ts-after {
      animation: ts-reveal 1s 0.6s cubic-bezier(0.65, 0, 0.35, 1) both;
    }
    .ts:not([hidden]) .ts-scan {
      animation: ts-scan 1s 0.6s cubic-bezier(0.65, 0, 0.35, 1) both;
    }
  }
  @keyframes ts-reveal {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0);
    }
  }
  @keyframes ts-scan {
    from {
      translate: 0 0;
    }
    to {
      translate: 0 100%;
    }
  }
  @keyframes ts-in {
    from {
      opacity: 0;
      scale: 1.04;
      filter: blur(6px);
    }
  }
  @keyframes ts-blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes ts-trace {
    to {
      stroke-dashoffset: -1;
    }
  }
  @keyframes ts-wave {
    to {
      translate: -50% 0;
    }
  }
  @keyframes ts-ping {
    0% {
      box-shadow: 0 0 0 0 rgb(34 211 238 / 0.7);
    }
    100% {
      box-shadow: 0 0 0 2.5cqw rgb(34 211 238 / 0);
    }
  }
  @keyframes ts-spin {
    to {
      rotate: 1turn;
    }
  }
  @keyframes ts-drift {
    to {
      translate: 12cqw 18cqw;
      scale: 1.2;
    }
  }
</style>
