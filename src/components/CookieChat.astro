---
// Cookie's quote chat, the Tuco panel pattern (SoyMenu TucoButton/AgentChat): side panel, header face that follows the
// state, empty state with chips, one avatar per turn, "thinking" row, oops on anything it can't answer.
// Scripted, not AI: three questions, one fixed price, then an email to Thomas. Any [data-cookie-open] opens it;
// a value on it is sent as the first message.
import Cookie from '@/components/Cookie.astro'
import { site, foundingOffer } from '@/site'

const { trades } = Astro.props as { trades: string[] }
const starters = ['Get me a price', 'What’s the founding offer?', 'How long does it take?']
---

<dialog id="cookie-chat" aria-labelledby="cookie-title" data-trades={JSON.stringify(trades)} data-price={site.priceFrom} data-turnaround={site.turnaround} data-email={site.email} data-phone={site.phone.replace(/\D/g, '')} data-offer={foundingOffer.price} data-slots={foundingOffer.slots} data-note={foundingOffer.note} class="cookie-chat fixed inset-y-0 right-0 left-auto m-0 h-dvh max-h-none w-full max-w-[440px] bg-transparent p-2 backdrop:bg-fg/10">
  <div class="card flex h-full flex-col overflow-hidden">
    <header class="flex items-center gap-3.5 border-b border-line px-4 py-3">
      <Cookie live id="cookie-face" class="w-[60px] shrink-0" />
      <div class="min-w-0 flex-1">
        <p id="cookie-title" class="text-lg leading-tight font-bold">Cookie</p>
        <p class="text-sm text-muted">Thomas's quote helper. Not a robot, a biscuit.</p>
      </div>
      <button type="button" data-close aria-label="Close" class="grid size-11 place-items-center rounded-full text-muted transition hover:bg-fg/[0.06] hover:text-fg">
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"></path></svg>
      </button>
    </header>

    <div id="cookie-log" aria-live="polite" class="flex-1 space-y-3 overflow-y-auto bg-[radial-gradient(rgb(185_121_59/0.14)_1.5px,transparent_1.5px)] bg-size-[18px_18px] p-4">
      <div data-empty class="flex h-full flex-col items-center justify-center text-center">
        <Cookie live class="w-32" />
        <p class="mt-4 text-xl font-bold">Hiya! How can I help?</p>
        <p class="mt-1 text-sm text-muted">Ask me anything. I know Thomas's prices.</p>
        <div class="mt-6 flex flex-wrap justify-center gap-2">
          {starters.map((s) => <button type="button" data-say={s} class="min-h-11 rounded-xl bg-white px-4 text-sm font-medium ring-1 ring-fg/15 transition ring-inset hover:bg-fg hover:text-white">{s}</button>)}
        </div>
      </div>
    </div>

    <form id="chat-form" class="flex gap-2 border-t border-line p-3">
      <input name="q" autofocus class="field" placeholder="Type a message" autocomplete="off" maxlength="80" aria-label="Message" />
      <button class="btn-primary min-h-11 shrink-0 px-3.5" aria-label="Send">
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </button>
    </form>
  </div>
  <template id="cookie-avatar"><Cookie mood="mini" class="w-7 shrink-0" /></template>
</dialog>

<script>
  const dlg = document.getElementById('cookie-chat') as HTMLDialogElement
  const log = document.getElementById('cookie-log')!
  const form = document.getElementById('chat-form') as HTMLFormElement
  const face = document.getElementById('cookie-face')!
  const avatar = document.getElementById('cookie-avatar') as HTMLTemplateElement
  const { price, turnaround, email, phone, offer, slots, note } = dlg.dataset
  const trades = JSON.parse(dlg.dataset.trades!) as string[]

  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms))
  let moodTimer = 0
  const mood = (m: string, back = 0) => {
    clearTimeout(moodTimer)
    face.dataset.mood = m
    face.classList.remove('mascot-pop')
    void face.getBoundingClientRect()
    face.classList.add('mascot-pop')
    if (back) moodTimer = window.setTimeout(() => mood('hello'), back)
  }

  // One Cookie per turn: the avatar goes on the first bubble of each bot turn.
  let last = ''
  const row = (who: 'bot' | 'me', ...kids: Node[]) => {
    const el = document.createElement('div')
    el.className = `bubble-in flex items-end gap-2 ${who === 'me' ? 'justify-end' : ''}`
    if (who === 'bot') el.append(last === 'bot' ? Object.assign(document.createElement('span'), { className: 'w-7 shrink-0' }) : avatar.content.cloneNode(true))
    el.append(...kids)
    log.append(el)
    log.scrollTop = log.scrollHeight
    last = who
    return el
  }
  const bubble = (who: 'bot' | 'me', text: string) =>
    row(who, Object.assign(document.createElement('p'), { textContent: text, className: `max-w-[80%] px-3.5 py-3 text-pretty ${who === 'me' ? 'rounded-[16px_4px_16px_16px] bg-accent text-white' : 'rounded-[4px_16px_16px_16px] bg-white ring-1 ring-line'}` }))

  const chips = (list: string[]) => {
    const wrap = document.createElement('div')
    wrap.className = 'bubble-in flex flex-wrap justify-end gap-2 pl-9'
    wrap.dataset.chips = ''
    for (const s of list) wrap.append(Object.assign(document.createElement('button'), { type: 'button', textContent: s, className: 'min-h-11 rounded-xl bg-white px-3.5 text-sm font-medium ring-1 ring-fg/15 ring-inset transition hover:bg-fg hover:text-white', onclick: () => (wrap.remove(), send(s)) }))
    log.append(wrap)
    log.scrollTop = log.scrollHeight
  }
  // Hand-off buttons: WhatsApp first (where trades actually reply), email as the fallback.
  const links = (...list: [string, string, string][]) => {
    const el = row('bot', ...list.map(([text, href, cls]) => Object.assign(document.createElement('a'), { textContent: text, href, className: `${cls} min-h-11`, target: href.startsWith('http') ? '_blank' : '', rel: 'noopener' })))
    el.classList.add('pl-9', 'flex-wrap')
    el.firstElementChild?.remove()
  }
  const handoff = (subject: string, body: string) => links(['WhatsApp Thomas', wa(body), 'btn-whatsapp'], ['Email instead', mail(subject, body), 'btn-ghost'])

  // Cookie "types" (thinking face, row with the thinking face), then answers and cheers for a moment.
  const say = async (text: string, after?: () => void, m = 'done') => {
    mood('thinking')
    const wait = row('bot', Object.assign(document.createElement('p'), { textContent: 'Cookie is thinking…', className: 'motion-safe:animate-pulse px-1 py-3 text-sm text-muted' }))
    await sleep(650)
    wait.remove()
    last = ''
    bubble('bot', text)
    after?.()
    mood(m, 2500)
  }

  const wa = (text: string) => `https://wa.me/${phone}?text=${encodeURIComponent(text)}`
  const mail = (subject: string, body: string) => `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`
  const lead = { trade: '', area: '' }
  let step: 'idle' | 'trade' | 'area' | 'site' = 'idle'
  const askTrade = (text: string) => {
    step = 'trade'
    return say(text, () => chips(trades))
  }

  const reply = (t: string) => {
    const q = t.toLowerCase()
    // A question or a sentence is not a trade: re-ask instead of quoting for "how much?".
    if (step === 'trade' && (t.includes('?') || t.split(/\s+/).length > 4)) return say('I’ll get to that. First, what does your business do? Pick one or type it, like “plumber”.', () => chips(trades))
    if (step === 'trade') {
      lead.trade = t
      step = 'area'
      return say('Lovely. And where are you based?')
    }
    if (step === 'area') {
      lead.area = t
      step = 'site'
      return say('Got a website already?', () => chips(['Yes, it needs redoing', 'No, starting fresh']))
    }
    if (step === 'site') {
      step = 'idle'
      const has = /^y/.test(q)
      return say(
        `Right then. A proper site for your business in ${lead.area}: normally £${price}, but you can grab a founding spot at £${offer} (first ${slots} clients). Fixed price, live in ${turnaround}, domain in your name, and you only pay once you’re happy.${has ? ' I’ll move your current address across.' : ''} Send it to Thomas? 🍪`,
        () => handoff(`Website for my ${lead.trade.toLowerCase()} business`, `Hi Thomas, Cookie sent me. I'm a ${lead.trade.toLowerCase()} in ${lead.area}. ${has ? 'I have a website that needs redoing.' : "I don't have a website yet."} I'd like the £${offer} founding offer.`),
      )
    }
    if (/accept/.test(q)) return askTrade('Best decision you’ll make today. Let’s get you a price. What does your business do?')
    if ((/\b(founding|offer|discount|deal)\b/.test(q) || q.includes(offer!))) return say(`The first ${slots} clients get the website for £${offer} instead of £${price}, ${note}. Same site, same care. Want one of the spots?`, () => chips(['Get me a price']))
    if (/\b(price|prices|cost|costs|quote|much|cheap)\b|£/.test(q)) return askTrade('Easy. What does your business do?')
    if (/\b(long|time|weeks?|fast|when|quick)\b/.test(q)) return say(`Usually ${turnaround} from your first message to live. Want a price too?`, () => chips(['Get me a price']))
    if (/\b(own|owns|owner|domain|mine)\b/.test(q)) return say('You do. The domain is registered in your name, not Thomas’s.', () => chips(['Get me a price']))
    if (/\b(ai|robot|bot|human)\b/.test(q)) return say('I’m a biscuit with a script, not an AI. Thomas reads every WhatsApp and email himself.', () => chips(['Get me a price']))
    if (/^(hi|hello|hiya|hey|yo)\b/.test(q)) return say('Hiya! Want a price for your website?', () => chips(['Get me a price']))
    return say('Ooh, that one’s beyond a biscuit. Thomas will answer it properly.', () => handoff('Question from your website', `Hi Thomas, ${t}`), 'oops')
  }

  let queue: Promise<unknown> = Promise.resolve()
  const send = (t: string) => {
    t = t.trim()
    if (!t) return
    log.querySelector('[data-empty]')?.remove()
    log.querySelectorAll('[data-chips]').forEach((c) => c.remove()) // stale options from earlier turns
    bubble('me', t)
    // Queue replies so two quick messages don't interleave their "thinking" rows.
    queue = queue.then(() => reply(t))
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault()
    send((form.elements.namedItem('q') as HTMLInputElement).value)
    form.reset()
  })
  log.addEventListener('click', (e) => {
    const s = (e.target as HTMLElement).closest<HTMLElement>('[data-say]')
    if (s) send(s.dataset.say!)
  })
  document.addEventListener('click', (e) => {
    const opener = (e.target as HTMLElement).closest<HTMLElement>('[data-cookie-open]')
    if (!opener) return
    dlg.showModal()
    mood('hello')
    if (opener.dataset.cookieOpen && log.querySelector('[data-empty]')) send(opener.dataset.cookieOpen)
  })
  // Click outside the card (or the ✕) closes it.
  dlg.addEventListener('click', (e) => {
    if (e.target === dlg || (e.target as HTMLElement).closest('[data-close]')) dlg.close()
  })
</script>
