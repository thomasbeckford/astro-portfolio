---
// Enquiry alerts, as an animation (the n8n flow running on tebeck.dev itself): on an example site someone taps WhatsApp,
// the phone pings, the enquiry lands in the sheet, three days on a reminder comes, and it's marked Won. motion.ts runs
// the timeline while on screen; without motion or JS it rests on the sheet with the ping showing. Sized in em off the stage.
import { plumber as d } from '@/templates'
import Icon from '@/components/Icon.astro'

const css = `--s-bg:${d.colors.bg};--s-fg:${d.colors.fg};--s-accent:${d.colors.accent};--s-on:${d.colors.onAccent}`
// Example rows, older enquiries above the new one. Codes are what ends each message, so a chat matches its row.
const rows = [['Mon 09:12', '#R2QD', 'Facebook', 'Email', 'Won'], ['Tue 14:40', '#8MXA', 'Google', 'WhatsApp', 'Lost'], ['Wed 08:31', '#T4HN', 'Google', 'Email', 'Won']]
const pill = (s: string) => (s === 'Won' ? 'bg-[#dcfce7] text-[#166534]' : s === 'Lost' ? 'bg-black/[0.06] text-black/50' : 'bg-[#fef3c7] text-[#92400e]')
---
<div
  data-leads
  role="img"
  aria-label="Animation: on an example website someone taps WhatsApp, the owner's phone gets an alert, the enquiry is added to a spreadsheet with where it came from, three days later a reminder arrives, and the enquiry is marked as won."
  class="relative aspect-video [container-type:inline-size] max-sm:aspect-[4/3]"
>
  <div style={css} class="absolute inset-0 text-[2.5cqw] max-sm:text-[3.6cqw]">
    <div aria-hidden="true" data-ld-card class="absolute inset-x-[3%] inset-y-[4%] overflow-hidden rounded-[1em] shadow-[0_0_0_1px_rgb(255_255_255/.12),0_2em_5em_-1em_rgb(0_0_0/.6)]">
      <!-- The example site, where the tap happens. -->
      <div data-ld-site class="invisible absolute inset-0 bg-(--s-bg) px-[1.6em] py-[1em] text-(--s-fg) opacity-0">
        <div class="flex items-center justify-between text-[.85em]">
          <span class="font-bold tracking-[-0.03em]">{d.mark}</span>
          <span class="font-semibold opacity-60">{d.tel}</span>
        </div>
        <p class="mt-[2.2em] text-[.75em] text-(--s-accent)">{d.hero.kicker}</p>
        <p class="mt-[.3em] max-w-[14em] text-[2.2em] leading-[0.95] font-semibold tracking-[-0.04em]">{d.hero.head}</p>
        <span data-ld-wa class="mt-[1.4em] inline-flex items-center gap-[.5em] rounded-full bg-[#25d366] px-[1.1em] py-[.6em] text-[.95em] font-semibold text-[#0b2a17]"><Icon name="chat" class="size-[1.1em]" />WhatsApp us</span>
      </div>
      <!-- The sheet the enquiries land in, light like Google Sheets. -->
      <div data-ld-sheet class="absolute inset-0 bg-white text-[#222]">
        <div class="flex items-center gap-[.6em] border-b border-black/10 px-[1.4em] py-[.8em] text-[.9em]">
          <span class="grid size-[1.5em] place-items-center rounded-[.3em] bg-[#188038] text-[.75em] font-bold text-white">▦</span>
          <span class="font-semibold">Enquiries</span><span class="text-black/45">· {d.name}</span>
        </div>
        <div class="px-[1.4em] pt-[.8em] text-[.8em]">
          <div class="grid grid-cols-[1fr_.8fr_1fr_1fr_.9fr] gap-[.6em] border-b border-black/10 pb-[.5em] text-black/45">
            <span>When</span><span>Code</span><span>Source</span><span>How</span><span>Status</span>
          </div>
          {rows.map(([when, code, via, how, status]) => (
            <div class="grid grid-cols-[1fr_.8fr_1fr_1fr_.9fr] items-center gap-[.6em] border-b border-black/5 py-[.55em] text-black/60">
              <span>{when}</span><span class="font-mono">{code}</span><span>{via}</span><span>{how}</span><span><span class:list={['rounded-full px-[.6em] py-[.15em] text-[.9em] font-semibold', pill(status)]}>{status}</span></span>
            </div>
          ))}
          <div data-ld-row class="grid grid-cols-[1fr_.8fr_1fr_1fr_.9fr] items-center gap-[.6em] rounded-[.3em] border-b border-black/5 py-[.55em]">
            <span>Thu 10:03</span><span class="font-mono font-semibold">#K7QM</span><span>Google</span><span>WhatsApp</span><span><span data-ld-status class:list={['rounded-full px-[.6em] py-[.15em] text-[.9em] font-semibold', pill('New')]}>New</span></span>
          </div>
        </div>
      </div>
      <!-- Phone alerts, dropping in over the sheet. -->
      {[['ld-ping', 'New enquiry', 'WhatsApp · found you via Google · #K7QM', 'now'], ['ld-nudge', 'Not dealt with yet', '#K7QM came in 3 days ago', '9:00']].map(([key, title, text, time]) => (
        <div data-ld-note={key} class:list={['absolute top-[4%] right-[3%] flex w-[56%] items-start max-sm:w-[86%] gap-[.7em] rounded-[1em] bg-[#1d2129]/95 px-[1em] py-[.8em] text-white shadow-[0_1em_2.5em_-.5em_rgb(0_0_0/.5)] backdrop-blur', key === 'ld-nudge' && 'invisible opacity-0']}>
          <span class="grid size-[2em] shrink-0 place-items-center rounded-[.5em] bg-(--s-accent) text-(--s-on)"><Icon name="bell" class="size-[1.1em]" /></span>
          <span class="min-w-0 flex-1 text-[.8em]">
            <span class="flex justify-between gap-[.6em]"><span class="font-semibold">{title}</span><span class="text-white/50">{time}</span></span>
            <span class="mt-[.15em] block text-white/75">{text}</span>
          </span>
        </div>
      ))}
      <span data-ld-later class="invisible absolute top-1/2 left-1/2 -translate-1/2 rounded-full bg-[#111] px-[1.2em] py-[.5em] text-[.9em] font-semibold whitespace-nowrap text-white opacity-0">3 days later…</span>
    </div>
    <svg aria-hidden="true" data-ld-cursor viewBox="0 0 24 24" class="pointer-events-none absolute top-0 left-0 size-[2.2em] opacity-0 drop-shadow-[0_.2em_.4em_rgb(0_0_0/.4)]">
      <path d="M4 2l15 11.5-6.6.9 3.9 7.4-2.9 1.4-3.8-7.5L4 20z" fill="#fff" stroke="#111" stroke-width="1.4" stroke-linejoin="round" />
    </svg>
  </div>
</div>
