---
// Cookie, the site's mascot: the only cookie on tebeck. Made the Tuco way (SoyMenu): round, no arms, small shiny eyes and
// one signature detail, the bite. Fixed colours, they don't follow the theme. Every face is drawn; data-mood picks one,
// so a script can swap it. `live` breathes, blinks and drops crumbs (styles in global.css).
interface Props {
  mood?: 'hello' | 'thinking' | 'done' | 'oops' | 'mini'
  live?: boolean
  class?: string
  id?: string
}
const { mood = 'hello', live = false, class: cls, id } = Astro.props
const bite = `bite-${Math.random().toString(36).slice(2, 8)}`
const C = '#2a1b14'
---

<svg viewBox="0 0 140 130" id={id} class:list={['cookie', live && 'cookie-live', cls]} data-mood={mood} aria-hidden="true">
  <mask id={bite}>
    <rect width="140" height="140" fill="#fff"></rect>
    <circle cx="98" cy="28" r="13"></circle>
    <circle cx="108" cy="44" r="10"></circle>
    <circle cx="84" cy="18" r="10"></circle>
    <circle class="cookie-bite" cx="114" cy="66" r="0"></circle>
    <circle class="cookie-bite" cx="62" cy="12" r="0"></circle>
  </mask>
  {
    mood === 'mini' ? (
      // Small: no mouth, big eyes. Reads down to 16px.
      <>
        <circle cx="60" cy="64" r="50" fill="#dda15a" mask={`url(#${bite})`} />
        <path d="M30 42l6-3 4 5-3 6-6-1z M56 98l6-1 3 5-4 4-5-3z" fill="#5b3a29" />
        <circle cx="44" cy="66" r="8" fill={C} />
        <circle cx="76" cy="66" r="8" fill={C} />
      </>
    ) : (
      <>
        <g class="cookie-bob">
          <g mask={`url(#${bite})`}>
            <circle cx="60" cy="64" r="48" fill="#b9793b" />
            <circle cx="60" cy="62" r="44" fill="#dda15a" />
          </g>
          <path d="M28 54Q30 40 42 32" stroke="#f0c47f" stroke-width="5" stroke-linecap="round" fill="none" />
          <path d="M30 44l5-3 4 4-2 5-5 0z M62 24l6 0 2 5-4 4-5-2z M22 80l5-2 4 4-2 5-6-1z M86 96l6-1 3 5-4 4-5-3z M52 100l5-1 3 4-3 5-5-2z M94 64l5 0 2 5-4 3-4-3z" fill="#5b3a29" />
          <ellipse cx="36" cy="76" rx="6" ry="4" fill="#ef8f6e" />
          <ellipse cx="84" cy="76" rx="6" ry="4" fill="#ef8f6e" />
          <g class="cookie-look">
          <g data-face="hello">
            <g class="cookie-eyes">
              <ellipse cx="46" cy="64" rx="5" ry="7" fill={C} />
              <ellipse cx="74" cy="64" rx="5" ry="7" fill={C} />
              <circle cx="47.5" cy="61" r="1.8" fill="#fff" />
              <circle cx="75.5" cy="61" r="1.8" fill="#fff" />
            </g>
            <path d="M52 78Q60 86 68 78" stroke={C} stroke-width="4" stroke-linecap="round" fill="none" />
          </g>
          <g data-face="thinking">
            <g class="cookie-eyes">
              <ellipse cx="49" cy="60" rx="5" ry="6" fill={C} />
              <ellipse cx="77" cy="60" rx="5" ry="6" fill={C} />
              <circle cx="50.5" cy="57.5" r="1.8" fill="#fff" />
              <circle cx="78.5" cy="57.5" r="1.8" fill="#fff" />
            </g>
            <path d="M54 82 67 79" stroke={C} stroke-width="4" stroke-linecap="round" />
            <circle class="cookie-dot" cx="118" cy="62" r="3" fill="#a99f94" />
            <circle class="cookie-dot" cx="126" cy="52" r="4" fill="#a99f94" />
            <circle class="cookie-dot" cx="132" cy="40" r="5" fill="#a99f94" />
          </g>
          <g data-face="done">
            <path d="M40 65Q46 57 52 65M68 65Q74 57 80 65" stroke={C} stroke-width="4" stroke-linecap="round" fill="none" />
            <path d="M48 75Q60 95 72 75Z" fill={C} stroke={C} stroke-width="2" stroke-linejoin="round" />
            <path d="M53 83Q60 78 67 83Q60 89 53 83Z" fill="#ef8f6e" />
          </g>
          <g data-face="oops">
            <path d="M39 56 51 52M81 56 69 52" stroke={C} stroke-width="3" stroke-linecap="round" />
            <circle cx="46" cy="65" r="4.5" fill={C} />
            <circle cx="74" cy="65" r="4.5" fill={C} />
            <path d="M50 83Q55 78 60 83Q65 88 70 83" stroke={C} stroke-width="4" stroke-linecap="round" fill="none" />
            <path class="cookie-tear" d="M30 60Q35 69 30 73Q25 69 30 60Z" fill="#8fc7e8" />
          </g>
          </g>
        </g>
        {live && (
          <g class="cookie-crumbs">
            <circle cx="112" cy="50" r="2.5" fill="#b9793b" />
            <circle cx="118" cy="46" r="2" fill="#dda15a" />
            <circle cx="108" cy="54" r="1.8" fill="#b9793b" />
          </g>
        )}
      </>
    )
  }
</svg>

<script>
  // Every live Cookie looks at the pointer, and takes a bite out of itself when clicked (twice is fine, three times is not).
  const lines = ['Nom.', 'Hey, that’s my bite!', 'Oi! I’m working here.']
  const live = () => document.querySelectorAll<SVGSVGElement>('.cookie-live')
  if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    addEventListener('pointermove', (e) => {
      for (const c of live()) {
        const r = c.getBoundingClientRect()
        if (!r.width || r.bottom < 0 || r.top > innerHeight) continue
        const dx = e.clientX - (r.left + r.width / 2)
        const dy = e.clientY - (r.top + r.height / 2)
        const k = 5 / Math.max(Math.hypot(dx, dy), 60)
        c.style.setProperty('--lx', `${dx * k}px`)
        c.style.setProperty('--ly', `${dy * k}px`)
      }
    }, { passive: true })
  }

  let grow = 0
  document.addEventListener('click', (e) => {
    const c = (e.target as Element).closest<SVGSVGElement>('.cookie-live')
    if (!c || c.closest('a, button, [data-cookie-open]')) return
    const n = Math.min(Number(c.dataset.bites ?? 0) + 1, 3)
    c.dataset.bites = String(n)
    c.querySelectorAll('.cookie-bite').forEach((b, i) => b.setAttribute('r', i < n ? '12' : '0'))
    c.dataset.mood = n < 3 ? 'done' : 'oops'
    c.classList.remove('cookie-pop')
    void c.getBoundingClientRect()
    c.classList.add('cookie-pop')
    const r = c.getBoundingClientRect()
    const tip = Object.assign(document.createElement('p'), { textContent: lines[n - 1], className: 'bubble-in pointer-events-none absolute z-50 -translate-x-1/2 -translate-y-full rounded-[16px_16px_16px_4px] bg-fg px-3 py-1.5 text-sm font-semibold whitespace-nowrap text-white shadow-lg' })
    tip.style.left = `${r.left + scrollX + r.width / 2}px`
    tip.style.top = `${r.top + scrollY - 6}px`
    document.body.append(tip)
    setTimeout(() => tip.remove(), 1600)
    // Grows back after a rest.
    clearTimeout(grow)
    grow = window.setTimeout(() => {
      for (const x of live()) {
        if (!x.dataset.bites) continue
        delete x.dataset.bites
        x.querySelectorAll('.cookie-bite').forEach((b) => b.setAttribute('r', '0'))
        x.dataset.mood = 'hello'
      }
    }, 4000)
  })
</script>
