---
// Device frame: black bezel, titanium edge and side buttons, like a current phone. Radii are % of width/height, so it scales with any size.
const { class: cls = '' } = Astro.props
---

<div class:list={['@container relative', cls]}>
  <!-- Side buttons: action + volume on the left, power on the right. -->
  <span aria-hidden="true" class="absolute top-[17%] -left-[0.9cqw] h-[5%] w-[1.2cqw] rounded-l-[1cqw] bg-[linear-gradient(90deg,#6b6b72,#2a2a2e)]"></span>
  <span aria-hidden="true" class="absolute top-[25%] -left-[0.9cqw] h-[9%] w-[1.2cqw] rounded-l-[1cqw] bg-[linear-gradient(90deg,#6b6b72,#2a2a2e)]"></span>
  <span aria-hidden="true" class="absolute top-[36%] -left-[0.9cqw] h-[9%] w-[1.2cqw] rounded-l-[1cqw] bg-[linear-gradient(90deg,#6b6b72,#2a2a2e)]"></span>
  <span aria-hidden="true" class="absolute top-[28%] -right-[0.9cqw] h-[14%] w-[1.2cqw] rounded-r-[1cqw] bg-[linear-gradient(270deg,#6b6b72,#2a2a2e)]"></span>
  <!-- padding in cqw, not %: % padding resolves against the containing block's width (the
  card, way bigger than the phone), not the phone's own width, which made the bezel huge
  at small sizes like the work-list thumbnails. cqw is 1% of this wrapper's own width. -->
  <div class="relative rounded-[13%/6.5%] bg-[#0a0a0b] p-[2.2cqw] shadow-[0_0_0_0.5cqw_#2b2b2f,0_0_0_0.8cqw_#56565c,inset_0_0_0_0.3cqw_#1c1c1f,0_40px_80px_-30px_rgb(0_0_0/0.8)]">
    <div class="overflow-hidden rounded-[11.5%/5.75%] bg-black [&_img]:block [&_img]:w-full"><slot /></div>
  </div>
</div>
